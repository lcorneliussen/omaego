#!/usr/bin/env python3
"""Route URLs into Chrome profiles, preferring whatever is already on this desktop.

Design notes (learned the hard way):
  Chrome/Chromium keep one process per --user-data-dir. A launch that names an
  already-running data dir is forwarded to that process over the singleton
  socket, so --class is dropped and every window ends up as `google-chrome`.
  Giving each profile its own --user-data-dir is therefore the only way to tell
  from the outside which profile a window belongs to.
"""

import json
import os
import re
import shutil
import subprocess
import sys
import time
import tomllib
from pathlib import Path
from urllib.parse import parse_qs, unquote, urlsplit

LOG = Path.home() / ".cache/omaego.log"
ROUTES = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "omaego/routes.jsonl"


def log_route(url, ego, reason):
    """Record where a link went, to learn rules from later.

    Only the host and the first two path segments are kept - enough to propose
    a glob like https://git.example.com/acme/*, and short of recording what was
    actually read. Query strings and fragments are dropped; they carry tokens.
    Delete the file to forget, or set OMAEGO_NO_ROUTE_LOG=1 to never write it.
    """
    if os.environ.get("OMAEGO_NO_ROUTE_LOG") == "1" or not url:
        return
    try:
        u = urlsplit(url)
        path = "/".join(u.path.strip("/").split("/")[:2])
        ROUTES.parent.mkdir(parents=True, exist_ok=True)
        with ROUTES.open("a") as f:
            f.write(json.dumps({"t": int(time.time()), "ego": ego,
                                "why": reason, "host": (u.hostname or "").lower(),
                                "path": path}) + "\n")
    except Exception:
        pass


def log(msg):
    if os.environ.get("URLROUTER_LOG", "1") == "0":
        return
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        if LOG.exists() and LOG.stat().st_size > 256_000:
            LOG.unlink()
        import datetime
        with LOG.open("a") as f:
            f.write(f"{datetime.datetime.now():%H:%M:%S} {msg}\n")
    except Exception:
        pass


# The ego root keeps its historical path: each ego is a Chrome --user-data-dir,
# and moving them would break every installed .desktop and web app for no gain.
EGO_ROOT = Path(os.environ.get("OMAEGO_ROOT",
                               Path.home() / ".local/share/chrome-profiles"))
PROFILE_ROOT = EGO_ROOT                     # internal alias, kept for clarity

_RULES_NEW = Path.home() / ".config/omaego/rules.toml"
_RULES_OLD = Path.home() / ".config/urlrouter/rules.toml"
RULES = _RULES_NEW if _RULES_NEW.exists() or not _RULES_OLD.exists() else _RULES_OLD

DEFAULT_MARK = EGO_ROOT / ".default"
DESKTOP_DIR = Path.home() / ".local/share/applications"

# --- engine -----------------------------------------------------------------
#
# The browser egos run in. Keyed by desktop id, because that is what omarchy
# calls its default browser (`omarchy default browser`, xdg-settings). Only the
# Chromium family can be an engine: an ego is a --user-data-dir with --class and
# --app, and Firefox has none of the three.
#   class   the anonymous window class, when --class was dropped or never given
#   app     prefix of a web-app window's class (<prefix><host><path>-<ProfileDir>)
#   proc    process name, for "is it still running"
ENGINES = {
    "google-chrome.desktop": {
        "command": "google-chrome-stable", "name": "Google Chrome",
        "short": "Chrome", "config": Path.home() / ".config/google-chrome",
        "class": "google-chrome", "app": "chrome-", "proc": "chrome",
        "icon": "google-chrome"},
    "chromium.desktop": {
        "command": "chromium", "name": "Chromium",
        "short": "Chromium", "config": Path.home() / ".config/chromium",
        "class": "chromium", "app": "chrome-", "proc": "chromium",
        "icon": "chromium"},
    "brave-browser.desktop": {
        "command": "brave", "name": "Brave",
        "short": "Brave",
        "config": Path.home() / ".config/BraveSoftware/Brave-Browser",
        "class": "brave-browser", "app": "brave-", "proc": "brave",
        "icon": "brave-desktop"},
    "microsoft-edge.desktop": {
        "command": "microsoft-edge-stable", "name": "Microsoft Edge",
        "short": "Edge", "config": Path.home() / ".config/microsoft-edge",
        "class": "microsoft-edge", "app": "msedge-", "proc": "msedge",
        "icon": "microsoft-edge"},
}
for _did, _e in ENGINES.items():
    _e["id"] = _did
ENGINE_FILE = Path.home() / ".config/omaego/engine"
BACKUPS = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "omaego/backups"
_engine = None


def installed_engines():
    return [e for e in ENGINES.values() if shutil.which(e["command"])]


def find_engine(word):
    """An engine by any name it goes by: chrome, Chromium, brave-browser.desktop."""
    w = (word or "").strip().lower()
    for e in ENGINES.values():
        if w in (e["id"], e["id"].removesuffix(".desktop"), e["short"].lower(),
                 e["name"].lower(), e["class"], e["command"]):
            return e
    return None


def xdg_default_browser():
    try:
        env = {k: v for k, v in os.environ.items() if k != "BROWSER"}
        return subprocess.run(["xdg-settings", "get", "default-web-browser"],
                              capture_output=True, text=True, env=env,
                              timeout=5).stdout.strip()
    except Exception:
        return ""


def engine():
    """The engine a NEW ego gets: omarchy's default browser.

    An existing ego keeps the one it was made in (ego_engine) until it is moved
    with `omaego engine <ego> <browser>` - a data dir belongs to its browser.

    Once omaego is itself the default browser that answer is "omaego", so the
    last real one seen is kept in ENGINE_FILE and read back from there. Run
    `omarchy default browser <x>` and then `omaego setup` to move to another.
    A default that cannot be an engine (Firefox, or one that was uninstalled)
    falls through to the remembered one, then to whatever is installed.
    """
    global _engine
    if _engine:
        return _engine

    def usable(did):
        return did in ENGINES and shutil.which(ENGINES[did]["command"])

    try:
        remembered = ENGINE_FILE.read_text().strip()
    except OSError:
        remembered = ""
    current = xdg_default_browser()
    if usable(current):
        did, source = current, "omarchy's default browser"
        if current != remembered:
            try:
                ENGINE_FILE.parent.mkdir(parents=True, exist_ok=True)
                ENGINE_FILE.write_text(current + "\n")
            except OSError:
                pass
    elif usable(remembered):
        did, source = remembered, "omarchy's default browser before omaego took over"
    else:
        did = next((d for d in ENGINES if usable(d)), "google-chrome.desktop")
        source = "first one installed" if usable(did) else "NOT INSTALLED"
    _engine = dict(ENGINES[did], source=source)
    return _engine


def ego_engine(data_dir):
    """The browser one ego runs in, from the .engine file in its data dir.

    An ego from before that file existed was made in Chrome, the only engine
    there was; without Chrome it runs in the default rather than not at all.
    """
    try:
        e = ENGINES.get((data_dir / ".engine").read_text().strip())
    except OSError:
        e = None
    if e:
        return e
    chrome = ENGINES["google-chrome.desktop"]
    return chrome if shutil.which(chrome["command"]) else engine()


# Browsers we did not create but should still route into when one is on-screen.
UNMANAGED = {e["class"]: (e["short"] if e["class"] != "google-chrome"
                          else "Chrome (default)", e["config"])
             for e in ENGINES.values()}
APP_PREFIXES = tuple(sorted({e["app"] for e in ENGINES.values()}))
# Windows that look like browsers but are somebody else's tool.
IGNORED_CLASSES = {"chromium-browser"}
# The terminal of a remote session: TUI.omaego.<ego slug>.<remote id>.
# Omarchy tags TUI.* windows as terminals, and its SUPER+C / SUPER+V send
# Ctrl+Insert / Shift+Insert only to those; a class it does not know gets
# Ctrl+C, which interrupts the program instead of copying.
REMOTE_CLASS = "TUI.omaego."
# Windows opened before that are still omaego.<ego>.<remote>.
REMOTE_CLASSES = (REMOTE_CLASS, "omaego.")


def remote_class_parts(cls):
    """(ego slug, remote id) from a remote's window class, or None."""
    for prefix in REMOTE_CLASSES:
        if cls.startswith(prefix):
            slug, _, rid = cls[len(prefix):].partition(".")
            return slug, rid
    return None


def is_browser_class(cls):
    """An engine window: anonymous, one of our --class names, or a web app."""
    return cls in UNMANAGED or cls.startswith(APP_PREFIXES)


# --- profiles ---------------------------------------------------------------

def ensure_native_hosts(data_dir, eng=None):
    """Give a managed data dir the native-messaging manifests.

    Chrome resolves user-level native messaging hosts relative to the
    user-data-dir, so a custom data dir sees none of the manifests installed
    into the engine's own config dir (~/.config/google-chrome, say) - which
    silently breaks the 1Password desktop app integration and Omarchy's
    copy-url / yt-dlp extensions. Symlink rather than copy so vendor updates to
    a manifest reach every profile.
    """
    source = (eng or ego_engine(data_dir))["config"] / "NativeMessagingHosts"
    if not source.is_dir():
        return 0
    dest = data_dir / "NativeMessagingHosts"
    dest.mkdir(parents=True, exist_ok=True)
    n = 0
    for manifest in source.glob("*.json"):
        link = dest / manifest.name
        if link.is_symlink() or link.exists():
            continue
        try:
            link.symlink_to(manifest)
            n += 1
        except OSError:
            pass
    return n


# Arch's Chromium ships without Google API keys, so it cannot sign in to a
# Google account. Omarchy has the fix - Chrome's own OAuth client, appended to
# ~/.config/chromium-flags.conf - and the Chromium binary reads that file on
# every launch, so it is one switch per device, not per ego. On by default;
# `omaego setup --no-google-signin` turns it off, remembered beside the egos so
# the next Chromium ego does not quietly turn it back on.
GOOGLE_SIGNIN_SCRIPT = "omarchy-install-chromium-google-account"
CHROMIUM_FLAGS = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) \
    / "chromium-flags.conf"
GOOGLE_SIGNIN_FLAGS = ("--oauth2-client-id=", "--oauth2-client-secret=")
NO_GOOGLE_SIGNIN = EGO_ROOT / ".no-google-signin"


def google_signin(eng, want=None):
    """Let Chromium sign in to Google accounts, or (want=False) stop it.

    want=None is the default: on, unless this device turned it off. Returns a
    line saying how things stand, or None when the engine is not Chromium.
    """
    if eng["id"] != "chromium.desktop":
        return None
    try:
        lines = CHROMIUM_FLAGS.read_text().splitlines(keepends=True)
    except OSError:
        lines = []
    has = any(l.startswith(GOOGLE_SIGNIN_FLAGS) for l in lines)
    if want is False:
        EGO_ROOT.mkdir(parents=True, exist_ok=True)
        NO_GOOGLE_SIGNIN.touch()
        if has:
            CHROMIUM_FLAGS.write_text("".join(l for l in lines
                                              if not l.startswith(GOOGLE_SIGNIN_FLAGS)))
            return f"google: off, removed Chrome's OAuth client from {CHROMIUM_FLAGS}"
        return "google: off on this device"
    if want is None and NO_GOOGLE_SIGNIN.exists():
        return "google: off on this device (omaego setup --google-signin turns it on)"
    NO_GOOGLE_SIGNIN.unlink(missing_ok=True)
    if has:
        return "google: Chromium can sign in to Google accounts"
    if not shutil.which(GOOGLE_SIGNIN_SCRIPT):
        return (f"google: Chromium cannot sign in to Google accounts, and there is "
                f"no {GOOGLE_SIGNIN_SCRIPT} to fix that")
    # The script only appends to a flags file that is already there.
    CHROMIUM_FLAGS.parent.mkdir(parents=True, exist_ok=True)
    CHROMIUM_FLAGS.touch()
    subprocess.run([GOOGLE_SIGNIN_SCRIPT], capture_output=True, timeout=30)
    if any(l.startswith(GOOGLE_SIGNIN_FLAGS)
           for l in CHROMIUM_FLAGS.read_text().splitlines()):
        return ("google: Chromium can now sign in to Google accounts "
                "(restart a running Chromium once)")
    return f"google: {GOOGLE_SIGNIN_SCRIPT} ran, but {CHROMIUM_FLAGS} has no OAuth client"


def preferences(ego):
    """An ego's browser Preferences, or {} when it has none yet."""
    try:
        return json.loads((ego["data_dir"] / ego.get("profile_dir", "Default")
                           / "Preferences").read_text())
    except (OSError, ValueError):
        return {}


def signin_blocked(ego):
    """True when the profile itself has browser sign-in switched off - a saved
    setting that outlives the OAuth flags, so only the browser can undo it."""
    return preferences(ego).get("signin", {}).get("allowed") is False


def browser_accounts(ego):
    """The Google accounts an ego's browser is signed in to. OMAEGO_NO_ACCOUNTS=1
    stops omaego from reading them, so egos.toml only has the ones you add."""
    if os.environ.get("OMAEGO_NO_ACCOUNTS") == "1":
        return []
    return [a["email"] for a in preferences(ego).get("account_info", [])
            if isinstance(a, dict) and "@" in (a.get("email") or "")]


def merge_accounts(*lists):
    """One list of addresses, first spelling and order kept, case-insensitive."""
    out, seen = [], set()
    for l in lists:
        for a in l or []:
            if a.lower() not in seen:
                seen.add(a.lower())
                out.append(a)
    return out


def default_slug():
    """Profile that acts as plain 'Chrome': the launcher entry and web apps."""
    try:
        return DEFAULT_MARK.read_text().strip() or None
    except Exception:
        return None


def slugify(name):
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-") or "profile"


def profiles():
    """Registered profiles, newest-listed last. slug -> dict."""
    out = {}
    for d in sorted(PROFILE_ROOT.glob("*/")):
        if not d.is_dir():
            continue
        slug = d.name
        namefile = d / ".profile-name"
        name = namefile.read_text().strip() if namefile.exists() else slug.title()
        dirfile = d / ".profile-dir"
        inner = dirfile.read_text().strip() if dirfile.exists() else "Default"
        out[slug] = {
            "slug": slug,
            "name": name,
            "data_dir": d,
            "wm_class": f"chrome-{slug}",
            "profile_dir": inner,
            "managed": True,
            "engine": ego_engine(d),
        }
    return out


def all_targets():
    """Profiles plus unmanaged browsers, keyed by wm_class."""
    by_class = {}
    for p in profiles().values():
        by_class[p["wm_class"]] = p
    taken = {e["class"] for e in ENGINES.values()
             if any(p["data_dir"].is_symlink()
                    and p["data_dir"].resolve() == e["config"].resolve()
                    for p in by_class.values())}
    for cls, (name, cfg) in UNMANAGED.items():
        if cls in taken:
            continue
        # "Local State", not the dir: omarchy drops NativeMessagingHosts into
        # every browser's config dir, installed or not.
        if not (cfg and (cfg / "Local State").exists()):
            continue          # browser never run / data dir removed
        by_class.setdefault(cls, {
            "slug": cls, "name": name, "data_dir": cfg,
            "wm_class": cls, "profile_dir": "Default", "managed": False,
            "engine": next(e for e in ENGINES.values() if e["class"] == cls),
        })
    return by_class


def internal_profiles(data_dir):
    """Chrome-internal profiles inside one user-data-dir: [(subdir, display name)].

    These all share a process, so their windows are indistinguishable from the
    outside. They are listed only so `import` can lift one into its own data dir.
    """
    ls = data_dir / "Local State"
    if not ls.exists():
        return []
    try:
        cache = json.loads(ls.read_text()).get("profile", {}).get("info_cache", {})
    except Exception:
        return []
    return sorted((k, v.get("name") or k) for k, v in cache.items())


def chrome_running():
    return any(subprocess.run(["pgrep", "-x", e["proc"]],
                              capture_output=True).returncode == 0
               for e in ENGINES.values())


def ego_running(data_dir):
    """Whether a browser process holds this data dir open."""
    # The browser's own lock, a symlink named host-pid: it is there however the
    # browser was started, which a search for --user-data-dir is not.
    try:
        pid = os.readlink(data_dir / "SingletonLock").rsplit("-", 1)[1]
    except (OSError, IndexError):
        return False
    return Path(f"/proc/{pid}").exists()


def set_engine(slug, eng, profile="keep"):
    """Move one ego to another browser. Returns the backup path, or None.

    profile is what the ego holds afterwards:
      "keep"           its own data, opened by the new browser
      "empty"          nothing - a fresh profile
      (dir, subdir)    a copy of a profile that browser already has
    Whatever it held before is kept under BACKUPS first. Bookmarks, history,
    extensions and settings survive a "keep"; cookies and saved passwords do
    not, because each browser encrypts them with its own keyring entry.
    """
    ego = profiles().get(slug)
    if not ego:
        raise SystemExit(f"unknown ego {slug!r}")
    d = ego["data_dir"]
    if profile == "keep" and eng["id"] == ego["engine"]["id"]:
        (d / ".engine").write_text(eng["id"] + "\n")
        return None
    if ego_running(d):
        raise SystemExit(f"{ego['name']} is open - close all its windows first")
    backup = None
    if d.is_symlink():
        # An adopted ego: the browser's own profile stays where it is, as the
        # rollback, and the ego gets a data dir of its own from here on.
        backup = d.resolve()
        d.unlink()
        if profile == "keep":
            subprocess.run(["cp", "-a", "--reflink=auto", str(backup), str(d)],
                           check=True)
    elif any(c for c in d.iterdir() if not c.name.startswith(".")):
        BACKUPS.mkdir(parents=True, exist_ok=True)
        backup = BACKUPS / f"{slug}-{ego['engine']['short'].lower()}-{int(time.time())}"
        if profile == "keep":
            subprocess.run(["cp", "-a", "--reflink=auto", str(d), str(backup)],
                           check=True)
        else:
            d.rename(backup)
    if profile != "keep":
        d.mkdir(parents=True, exist_ok=True)
        (d / ".profile-name").write_text(ego["name"] + "\n")
        if backup and (backup / ".ego-color").exists():
            shutil.copy(backup / ".ego-color", d / ".ego-color")
        (d / ".profile-dir").unlink(missing_ok=True)
        if profile != "empty":
            src_dir, sub = profile
            subprocess.run(["cp", "-a", "--reflink=auto", str(Path(src_dir) / sub),
                            str(d / "Default")], check=True)
    # A lock or a host manifest left by the old browser would point the new one
    # at a process and a config dir that are not its own.
    for stale in list(d.glob("Singleton*")) + list(d.glob("NativeMessagingHosts/*.json")):
        if stale.is_symlink():
            stale.unlink()
    (d / ".engine").write_text(eng["id"] + "\n")
    google_signin(eng)
    ensure_native_hosts(d, eng)
    write_desktop_entries()
    return backup


def pick_engine(slug):
    """The ego card's browser row: choose a browser, then what it should hold."""
    ego = profiles().get(slug)
    if not ego:
        return 1
    cur = ego["engine"]
    eng = pick([(e["name"] + ("   (current)" if e["id"] == cur["id"] else ""), e)
                for e in installed_engines()], f"Browser for {ego['name']}")
    if not eng:
        return 0
    rows = []
    if eng["id"] != cur["id"]:
        rows.append((f"Keep {ego['name']}'s profile (bookmarks, history, "
                     f"extensions; sign in again)", "keep"))
    rows += [(f"Copy of {eng['short']}'s own profile: {nm}", (eng["config"], sub))
             for sub, nm in internal_profiles(eng["config"])]
    rows.append(("Empty profile", "empty"))
    profile = pick(rows, f"Profile for {ego['name']} in {eng['short']}")
    if not profile:
        return 0
    if isinstance(profile, tuple) and subprocess.run(
            ["pgrep", "-x", eng["proc"]], capture_output=True).returncode == 0:
        notify(f"Quit {eng['short']} completely first - its profile cannot be "
               f"copied while it is open")
        return 1
    try:
        backup = set_engine(slug, eng, profile)
    except SystemExit as e:
        notify(str(e))
        return 1
    notify(f"{ego['name']} now runs in {eng['short']}"
           + (f" - previous profile kept in {backup}" if backup else ""))
    return 0


def import_profile(data_dir, subdir, name=None, eng=None):
    """Copy a Chrome-internal profile out into its own user-data-dir."""
    src = data_dir / subdir
    if not src.is_dir():
        raise SystemExit(f"no such profile directory: {src}")
    if chrome_running():
        raise SystemExit(
            "Chrome is running - quit it completely first, or the copy will be "
            "inconsistent (its databases are open)."
        )
    name = name or dict(internal_profiles(data_dir)).get(subdir, subdir)
    slug = slugify(name)
    dest = PROFILE_ROOT / slug
    if dest.exists():
        raise SystemExit(f"profile {slug!r} already exists at {dest}")
    dest.mkdir(parents=True)
    print(f"copying {src} -> {dest / 'Default'} ...")
    subprocess.run(["cp", "-a", str(src), str(dest / "Default")], check=True)
    (dest / ".profile-name").write_text(name + "\n")
    (dest / ".engine").write_text((eng or engine())["id"] + "\n")
    ensure_native_hosts(dest)
    write_desktop_entries()
    print(f"imported {name!r} as {slug} (class chrome-{slug})")
    print(f"original left in place at {src}")
    return slug


def adopted():
    """Egos that ARE a browser's own profile: {engine class: ego}.

    Such an ego's data dir is a symlink to the browser's config dir, so the
    profile you already set up becomes an ego without copying or moving it.
    """
    out = {}
    for ego in profiles().values():
        if ego["data_dir"].is_symlink():
            real = ego["data_dir"].resolve()
            for e in ENGINES.values():
                if e["config"].resolve() == real:
                    out[e["class"]] = ego
    return out


def adoptable():
    """Installed browsers with a profile of their own that is not an ego yet."""
    taken = adopted()
    return [e for e in installed_engines()
            if e["class"] not in taken and (e["config"] / "Local State").exists()]


def add_profile(name, eng=None, existing=False):
    """A new ego: empty, or (existing=True) the browser's own profile, adopted.

    A name or slug your egos repo declares sets that ego up on this device: its
    slug, name and colour come from egos.toml, and its web apps show on its
    card, ready to install on first use."""
    decl = load_declared()
    mine = next((k for k, e in decl.items()
                 if name.strip().lower() in (k, e["name"].lower())), None)
    if mine:
        name = decl[mine]["name"]
    slug = mine or slugify(name)
    d = PROFILE_ROOT / slug
    if d.exists():
        return slug
    eng = eng or engine()
    if existing:
        if eng["id"] not in {e["id"] for e in adoptable()}:
            raise SystemExit(f"{eng['short']} has no profile of its own to adopt")
        PROFILE_ROOT.mkdir(parents=True, exist_ok=True)
        d.symlink_to(eng["config"], target_is_directory=True)
        # The profile you already use is the natural fallback ego.
        if not default_slug():
            DEFAULT_MARK.write_text(slug + "\n")
    else:
        d.mkdir(parents=True)
    (d / ".profile-name").write_text(name + "\n")
    (d / ".engine").write_text(eng["id"] + "\n")
    if mine and decl[mine].get("color"):
        (d / ".ego-color").write_text(decl[mine]["color"] + "\n")
    google_signin(eng)
    ensure_native_hosts(d)
    write_desktop_entries()
    return slug


# --- hyprland ---------------------------------------------------------------

def hyprctl(*args):
    try:
        r = subprocess.run(["hyprctl", "-j", *args], capture_output=True, text=True, timeout=5)
        return json.loads(r.stdout)
    except Exception:
        return None


def dispatch(expr):
    subprocess.run(["hyprctl", "dispatch", expr], capture_output=True, text=True, timeout=5)


def current_workspace():
    aw = hyprctl("activeworkspace")
    return aw.get("id") if aw else None


def window_data_dir(pid):
    """--user-data-dir of a window's Chrome process, or None.

    Chrome rewrites its own argv, so /proc/<pid>/cmdline comes back space
    separated rather than NUL separated; normalise both.
    """
    try:
        raw = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return None
    text = raw.replace(b"\0", b" ").decode("utf-8", "replace")
    m = re.search(r"--user-data-dir=(\S+)", text)
    return m.group(1).rstrip("/") if m else None


def browsers_here():
    """Browser presence on the active workspace: [(address, wm_class, focused)].

    address is None for a web-app window (Teams, X, ...). Such a window still
    says "this profile is on this desktop", but a link must never be opened
    into it - a web app is a single-purpose window, not a place for tabs - so
    it is never used as a reuse target, only as a hint about which profile.
    """
    ws = current_workspace()
    clients = hyprctl("clients") or []
    active = (hyprctl("activewindow") or {}).get("address")
    known = all_targets()
    by_dir = {str(t["data_dir"]).rstrip("/"): t["wm_class"]
              for t in known.values() if t["managed"] and t["data_dir"]}
    own = adopted()
    found = []
    # Reading order, so the ego whose window sits first in the tiling is named
    # first - and is therefore the one a link defaults to.
    clients = sorted(clients, key=lambda c: (c.get("at", [0, 0])[1],
                                             c.get("at", [0, 0])[0]))
    slug_class = {t["slug"]: t["wm_class"] for t in known.values() if t.get("slug")}
    pinned = remote_owners()
    for c in clients:
        cls = c.get("class", "")
        if cls in IGNORED_CLASSES or c.get("workspace", {}).get("id") != ws:
            continue
        if remote_class_parts(cls):
            # A remote's terminal (TUI.omaego.<ego>.<remote>): like a web app, it
            # says which ego is on this desktop and is never a link target.
            prof = slug_class.get(remote_owner(cls, pinned))
            if prof:
                found.append((None, prof, False))
            continue
        if not (cls in known or is_browser_class(cls)):
            continue
        # Prefer the process's data dir over the window class: an instance first
        # launched without --class (a web app at login, say) gives every browser
        # window the anonymous class google-chrome, but its data dir is exact.
        prof = by_dir.get(window_data_dir(c.get("pid")) or "")
        if prof is None and cls in own:
            # An adopted browser started the plain way: no --user-data-dir on
            # its command line, but its own class says which ego it is.
            prof = own[cls]["wm_class"]
        if prof is None:
            prof = cls if cls in known else None
        if prof is None:
            continue
        # A web app window is a hint about which profile is on this desktop,
        # never somewhere to put a link - Chrome cannot add a tab to an --app
        # window and silently opens a whole new browser window instead.
        # Detect by elimination: our own browser classes are exactly the known
        # ones, so any other chrome-* class (brave-*, msedge-* under those
        # engines) is an app window. Matching the class
        # shape instead fails for apps whose URL has a path, e.g.
        # chrome-outlook.office.com__mail_-Default.
        is_app = cls.startswith(APP_PREFIXES) and cls not in known
        found.append((None if is_app else c["address"], prof,
                      (not is_app) and c["address"] == active))
    return found


def focus(address, confirm=True):
    """Focus a window and wait until the compositor reports it active.

    hyprctl returns as soon as the dispatch is queued. Launching Chrome
    immediately afterwards races the activation: Chrome still considers the
    previously active window current, and if that was an app window (Teams,
    Outlook) it cannot host a tab, so it opens a whole new browser window
    instead of reusing the one we just picked.
    """
    dispatch(f"hl.dsp.focus({{ window = 'address:{address}' }})")
    if not confirm:
        return
    for _ in range(20):                      # up to ~1s
        if (hyprctl("activewindow") or {}).get("address") == address:
            return
        time.sleep(0.05)
    log(f"focus: {address} did not become active in time")


# --- picker -----------------------------------------------------------------

def picker():
    """Which menu there is to ask with: "omarchy", "walker", or None.

    Whatever the desktop itself uses: Omarchy 4's own shell menu
    (omarchy-menu-select and -input) where it exists, walker on Omarchy 3,
    which shipped that instead. Neither is guaranteed, and asking with a menu
    that is not there used to look exactly like the user pressing Escape - so
    callers that must not lose what they were asked to do check this first.
    """
    if shutil.which("omarchy-menu-select") and shutil.which("omarchy-menu-input"):
        return "omarchy"
    if shutil.which("walker"):
        return "walker"
    return None


NO_MENU = ("omaego has no menu to ask with: neither Omarchy's own "
           "(omarchy-menu-select) nor walker is installed")


def pick(options, prompt, free=False, single=True, width=None):
    """options: list of (label, value). Returns value, or None.

    With free=True, text that matches no row is returned as ("free", text)
    instead of being discarded: walker filters its rows by what you type and,
    when none is left, hands back the typed text on Enter. Esc returns nothing.
    single=False keeps walker from choosing a lone remaining row by itself.
    width (px) widens the omarchy menu for long rows, which it cuts otherwise.
    """
    if not options:
        return None
    labels = "\n".join(label for label, _ in options)
    log(f"pick: offering {labels!r}")
    if not picker():
        # Silence here read as "nothing happened" - the one thing a click on
        # "New ego" must never look like.
        log("pick: no menu installed")
        notify(NO_MENU)
        print(NO_MENU, file=sys.stderr)
        return None
    try:
        if picker() == "omarchy":
            r = subprocess.run(
                ["omarchy-menu-select", prompt, *(label for label, _ in options),
                 *(["--", "--width", str(width)] if width else [])],
                stdin=subprocess.DEVNULL, capture_output=True, text=True,
                timeout=120,
            )
        else:
            r = subprocess.run(
                ["walker", "--dmenu", *(["-X"] if single else []),
                 "--placeholder", prompt],
                input=labels, capture_output=True, text=True, timeout=120,
            )
    except Exception as e:
        log(f"pick: menu failed {e!r}")
        return None
    log(f"pick: rc={r.returncode} out={r.stdout!r} err={r.stderr[:200]!r}")
    chosen = r.stdout.strip()
    for label, value in options:
        if label == chosen:
            return value
    if free and chosen:
        return ("free", chosen)
    log(f"pick: no option matched {chosen!r}")
    return None


def prompt_text(prompt, width=None):
    if not picker():
        log("prompt: no menu installed")
        notify(NO_MENU)
        print(NO_MENU, file=sys.stderr)
        return None
    try:
        if picker() == "omarchy":
            r = subprocess.run(["omarchy-menu-input", prompt,
                                *(["--width", str(width)] if width else [])],
                               stdin=subprocess.DEVNULL, capture_output=True,
                               text=True, timeout=120)
        else:
            r = subprocess.run(
                ["walker", "--dmenu", "--inputonly", "--placeholder", prompt],
                input="", capture_output=True, text=True, timeout=120,
            )
    except Exception as e:
        log(f"prompt: menu failed {e!r}")
        return None
    return r.stdout.strip() or None


def notify(msg):
    subprocess.run(["notify-send", "omaego", msg], capture_output=True)


# --- rules ------------------------------------------------------------------

def load_rules():
    if not RULES.exists():
        return []
    try:
        with RULES.open("rb") as f:
            return tomllib.load(f).get("rule", [])
    except Exception as e:
        notify(f"rules.toml: {e}")
        return []


# Hosts that carry the real destination in a query parameter. Purely local.
WRAPPERS = {
    "safelinks.protection.outlook.com": "url",   # Teams / Outlook ATP
    "eur01.safelinks.protection.outlook.com": "url",
    "l.facebook.com": "u",
    "l.messenger.com": "u",
    "out.reddit.com": "url",
    "www.google.com": "q",                        # /url?q=
    "href.li": None,                              # path is the URL
    "linkprotect.cudasvc.com": "a",
    "urldefense.com": None,                       # proofpoint, path-encoded
}

# Resolved over the network, so gated to hosts that are nothing but redirects.
SHORTENERS = {"t.co", "bit.ly", "lnkd.in", "tinyurl.com", "goo.gl", "ow.ly",
              "buff.ly", "trib.al", "rb.gy", "is.gd", "cutt.ly", "shorturl.at",
              "dub.sh", "t.ly", "s.id"}


def unwrap(url, follow=True, depth=4):
    """Resolve wrapper and shortener links to the destination.

    Used to decide WHICH EGO a link belongs to: a Teams safelink or a t.co stub
    says nothing about the customer it points at, so rules could never match it
    and `learn` would only ever see the wrapper's host.

    The original URL is what actually gets opened - unwrapping a safelink would
    bypass the organisation's click-time scanning, which is not ours to skip.
    """
    seen = set()
    for _ in range(depth):
        if not url or url in seen:
            break
        seen.add(url)
        u = urlsplit(url)
        host = (u.hostname or "").lower()
        key = next((k for k in WRAPPERS if host == k or host.endswith("." + k)), None)
        if key:
            param = WRAPPERS[key]
            if param:
                vals = parse_qs(u.query).get(param)
                if vals:
                    url = unquote(vals[0])
                    continue
            m = re.search(r"(https?%3A%2F%2F|https?://)", u.path or "", re.I)
            if m:
                url = unquote(u.path[m.start():].lstrip("/"))
                continue
            break
        if follow and host in SHORTENERS:
            try:
                r = subprocess.run(
                    ["curl", "-sIL", "--max-time", "2", "-o", "/dev/null",
                     "-w", "%{url_effective}", url],
                    capture_output=True, text=True, timeout=4)
                final = r.stdout.strip()
                if final and final != url:
                    url = final
                    continue
            except Exception:
                pass
            break
        break
    return url


def glob_to_re(pattern):
    """URL glob -> regex. '*' spans any characters; everything else is literal."""
    return "^" + "".join(".*" if part == "*" else re.escape(part)
                         for part in re.split(r"(\*)", pattern)) + "$"


def match_rule(url, source_class):
    host = (urlsplit(url).hostname or "").lower()
    for r in load_rules():
        want_source = r.get("source")
        if want_source and want_source.lower() not in (source_class or "").lower():
            continue
        pat, m = r.get("url"), r.get("match")
        if pat:
            if not re.match(glob_to_re(pat), url):
                continue
        elif m:
            if m.startswith("re:"):
                if not re.search(m[3:], url):
                    continue
            elif not (host == m.lower() or host.endswith("." + m.lower())):
                continue
        elif not want_source:
            continue
        return r
    return None


# --- account-shaped hosts ---------------------------------------------------

# Services that put the account in the URL: acme.sharepoint.com belongs to
# whoever is signed in as Acme, whatever desktop the link was clicked on. Opening
# one in "the ego that happens to be here" lands on a sign-in page or, worse, in
# the wrong tenant. There is no public list of these (the Public Suffix List is
# about cookie boundaries and hosting, not tenancy), so this is ours; add your
# own, one suffix per line, in ~/.config/omaego/account-hosts.
ACCOUNT_HOSTS = [
    # Microsoft
    "sharepoint.com", "onmicrosoft.com", "dynamics.com", "visualstudio.com",
    "powerappsportals.com",
    # Atlassian, chat, support
    "atlassian.net", "jira.com", "slack.com", "zulipchat.com",
    "mattermost.cloud", "zendesk.com", "freshdesk.com", "freshservice.com",
    "helpscout.net", "intercom.help",
    # CRM, ERP, HR, commerce
    "my.salesforce.com", "lightning.force.com", "my.site.com", "odoo.com",
    "pipedrive.com", "myshopify.com", "bamboohr.com", "personio.de",
    "personio.com", "service-now.com", "monday.com", "teamwork.com",
    "kanbanize.com", "youtrack.cloud", "fibery.io", "qualtrics.com",
    # Identity and cloud consoles
    "okta.com", "oktapreview.com", "onelogin.com", "auth0.com",
    "cloudflareaccess.com", "awsapps.com", "signin.aws.amazon.com",
    "grafana.net", "sentry.io", "webex.com", "box.com",
]
# The same idea with the account as the first path segment.
ACCOUNT_PATHS = ["dev.azure.com"]
# A first label that names the service's own pages, not anyone's account.
_NOT_ACCOUNTS = {"www", "app", "apps", "api", "login", "signin", "auth", "id",
                 "accounts", "account", "admin", "status", "docs", "help",
                 "support", "developer", "developers", "community", "my",
                 "portal", "cloud", "go", "get", "blog", "learn", "trust"}
ACCOUNT_FILE = Path.home() / ".config/omaego/account-hosts"


def account_scope(url):
    """(label, [url globs]) when the URL names an account, else None."""
    u = urlsplit(url or "")
    host = (u.hostname or "").lower()
    if u.scheme not in ("http", "https") or not host:
        return None
    if host in ACCOUNT_PATHS:
        seg = (u.path or "").strip("/").split("/")[0]
        if not seg or seg.startswith("_"):
            return None
        return f"{host}/{seg}", [f"https://{host}/{seg}", f"https://{host}/{seg}/*"]
    suffixes = list(ACCOUNT_HOSTS)
    try:
        suffixes += [l.strip().lower().lstrip("*.") for l in
                     ACCOUNT_FILE.read_text().splitlines()
                     if l.strip() and not l.lstrip().startswith("#")]
    except OSError:
        pass
    for suf in suffixes:
        if not host.endswith("." + suf):
            continue
        account = host[:-len(suf) - 1].split(".")[0]
        if account in _NOT_ACCOUNTS:
            return None
        if suf == "sharepoint.com":
            # One tenant, three hosts: acme, acme-my (OneDrive), acme-admin.
            account = re.sub(r"-(my|admin)$", "", account)
            return (f"{account}.{suf}",
                    [f"https://{account}.{suf}/*", f"https://{account}-my.{suf}/*"])
        return host, [f"https://{host}/*"]
    return None


def add_rule(pattern, ego_name):
    RULES.parent.mkdir(parents=True, exist_ok=True)
    with RULES.open("a") as f:
        f.write(f'\n[[rule]]\nurl = "{pattern}"\nprofile = "{ego_name}"\n')


def ask_account(label, patterns, by_class, here):
    """Ask whose account this is, and whether to remember it. Returns a target."""
    chosen = pick(ego_options(by_class, first={cls for _, cls, _ in here}),
                  f"{label} is one account — open it in…")
    target = resolve_choice(chosen) if chosen is not None else None
    if target is None:
        return None
    # walker has no checkbox, so "ticked by default" is the first row: Enter
    # saves. Esc here still opens the link - the ego was already chosen.
    keep = pick([(f"Always open {label} in {target['name']}", True),
                 ("Just this once", False)],
                f"Remember {label} for {target['name']}?")
    if keep:
        for pat in patterns:
            add_rule(pat, target["name"])
        notify(f"{label} now always opens in {target['name']}")
    return target


# --- launching --------------------------------------------------------------

def launch(target, url=None, new_window=False, incognito=False, as_app=False):
    cmd = [target["engine"]["command"], "--no-first-run", "--no-default-browser-check"]
    if target["managed"]:
        cmd += [f"--user-data-dir={target['data_dir']}", f"--class={target['wm_class']}"]
        if target.get("profile_dir", "Default") != "Default":
            cmd.append(f"--profile-directory={target['profile_dir']}")
    if incognito:
        cmd.append("--incognito")
    elif as_app:
        pass                      # an --app window is always its own window
    elif new_window:
        cmd.append("--new-window")
    if url:
        cmd.append(f"--app={url}" if as_app else url)
    log(f"launch: {cmd}")
    subprocess.Popen(cmd, start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def installed_apps():
    """Web apps on disk, grouped by ego slug, read back from their .desktop."""
    out = {}
    for f in sorted(DESKTOP_DIR.glob("*.desktop")):
        try:
            txt = f.read_text()
        except OSError:
            continue
        m = re.search(r"^Exec=(.*)$", txt, re.M)
        if not m or ("omaego-webapp" not in m.group(1)
                     and "chrome-webapp" not in m.group(1)):
            continue
        ego = re.search(r"--(?:ego|profile)=(\S+)", m.group(1))
        app = re.search(r"--app=(\S+)", m.group(1))
        if not ego or not app:
            continue
        name = (re.search(r"^Name=(.*)$", txt, re.M) or [None, f.stem])[1]
        icon = (re.search(r"^Icon=(.*)$", txt, re.M) or [None, ""])[1]
        key = next((k for k, v in WEBAPPS.items() if v[1] == app.group(1)), None)
        out.setdefault(ego.group(1), []).append(
            {"name": name, "icon": icon, "url": app.group(1),
             "key": key, "exec": m.group(1), "desktop": f.name})
    return out


def icon_path(name):
    """Resolve an Icon= name to a file, for the panel's QML Image."""
    if not name:
        return ""
    if name.startswith("/"):
        return name if Path(name).exists() else ""
    base = Path.home() / ".local/share/icons/hicolor"
    for size in ("256x256", "128x128", "96x96", "64x64", "48x48", "scalable"):
        for ext in ("png", "svg"):
            f = base / size / "apps" / f"{name}.{ext}"
            if f.exists():
                return str(f)
    f = Path.home() / ".local/share/applications/icons" / f"{name}.png"
    return str(f) if f.exists() else ""


def remove_rule(pattern):
    """Delete one [[rule]] block textually, so comments elsewhere survive.

    tomllib is read-only and tomlkit is not installed, so rewriting the file
    from parsed data would silently strip every comment in it.
    """
    if not RULES.exists():
        return False
    lines = RULES.read_text().splitlines(keepends=True)
    starts = [i for i, l in enumerate(lines) if l.strip() == "[[rule]]"]
    for i, start in enumerate(starts):
        end = starts[i + 1] if i + 1 < len(starts) else len(lines)
        block = "".join(lines[start:end])
        if pattern in block:
            # keep any comment lines that sit above the header
            head = start
            while head > 0 and lines[head - 1].lstrip().startswith("#"):
                head -= 1
            # and the blank line that separated this block from the previous one
            while head > 0 and lines[head - 1].strip() == "":
                head -= 1
            del lines[head:end]
            RULES.write_text("".join(lines))
            return True
    return False


# Distinguishable, theme-neutral. An ego keeps its colour as long as the set of
# egos does not change; override per ego with a .ego-color file holding "rrggbb".
PALETTE = ["7aa2f7", "9ece6a", "e0af68", "bb9af7", "7dcfff", "ff9e64", "f7768e"]


def ego_color(slug):
    d = EGO_ROOT / slug / ".ego-color"
    if d.exists():
        try:
            return d.read_text().strip().lstrip("#")
        except OSError:
            pass
    order = sorted(profiles())
    return PALETTE[order.index(slug) % len(PALETTE)] if slug in order else "7aa2f7"


def highlight(mode=None):
    """Outline ego windows while the panel is open.

    mode "all" colours every ego's windows in that ego's own colour, so the
    mapping between a name in the panel and the tiles on screen is readable at a
    glance. Anything else clears.

    Colour only - setting border_size reflows the tiling and resizes windows.
    A window hidden in a tab group cannot show a border, so its group's visible
    member is outlined instead. Everything goes out in one hyprctl --batch.
    """
    clients = hyprctl("clients") or []
    by_addr = {c["address"]: c for c in clients}
    want = {}
    pinned = remote_owners()
    if mode == "all":
        for slug, prof in profiles().items():
            colour = ego_color(slug)
            for c in clients:
                if c.get("class") != prof["wm_class"] \
                        and remote_owner(c.get("class", ""), pinned) != slug:
                    continue
                addr = c["address"]
                if c.get("hidden") and c.get("grouped"):
                    addr = next((a for a in c["grouped"]
                                 if by_addr.get(a) and not by_addr[a].get("hidden")), addr)
                want[addr] = colour

    cmds = []
    for c in clients:
        cls = c.get("class", "")
        if not (is_browser_class(cls) or remote_class_parts(cls)):
            continue
        colour = want.get(c["address"])
        # Only the INACTIVE colour. Setting the active one too made a focused
        # window look exactly like an unfocused one, which is Hyprland's own
        # way of showing focus - the highlight was overwriting it.
        #
        # And the reset value is 0, not "unset": "unset" and -1 both report ok
        # and change nothing, so every clear was silently a no-op and the
        # borders stayed after the panel closed.
        value = f"'rgb({colour})'" if colour else "0"
        cmds.append(f"dispatch hl.dsp.window.set_prop({{ window = "
                    f"'address:{c['address']}', prop = 'inactive_border_color', "
                    f"value = {value} }})")
    if cmds:
        subprocess.run(["hyprctl", "--batch", " ; ".join(cmds)], capture_output=True)


def close_ego(slug):
    """Close every window of one ego on the current workspace.

    Resolved by data dir, so an ego's web apps (Teams, Outlook) close with it -
    they are windows of the same Chrome instance and belong to the same ego.
    Other workspaces are untouched: this is the ego card's close button, and the
    card describes this workspace.
    """
    prof = profiles().get(slug)
    if not prof:
        return 0
    ws = current_workspace()
    want_dir = str(prof["data_dir"]).rstrip("/")
    cmds = []
    for c in hyprctl("clients") or []:
        if c.get("workspace", {}).get("id") != ws:
            continue
        cls = c.get("class", "")
        if not is_browser_class(cls):
            continue
        if window_data_dir(c.get("pid")) == want_dir or cls == prof["wm_class"]:
            cmds.append(f"dispatch hl.dsp.window.close({{ window = "
                        f"'address:{c['address']}' }})")
    if cmds:
        subprocess.run(["hyprctl", "--batch", " ; ".join(cmds)], capture_output=True)
    return len(cmds)


def ego_options(by_class, first=()):
    """Picker rows: every ego, the ones on this desktop first.

    When some egos ARE on this desktop, the others are marked - picking one of
    those opens a new window rather than reusing a tab, and that is worth
    knowing before you pick. When nothing is here the prompt already says so,
    and marking every row would just be noise.
    """
    order = sorted(by_class.items(), key=lambda ct, k=ego_sort_key(): k(ct[1]))
    here_first = [t for c, t in order if c in first]
    rest = [t for c, t in order if c not in first]
    mark = " · not on this desktop" if here_first else ""
    rows = [(t["name"], t) for t in here_first]
    rows += [(t["name"] + mark, t) for t in rest]
    rows.append(("+ New ego…", "__new__"))
    return rows


def new_ego():
    """Ask for a name, and for what the ego should be when there is a choice.

    Returns (slug, existed), or None if cancelled. The choice is one menu, not
    two: every installed browser with an empty profile, plus "the profile I
    already have" for a browser whose own profile is not an ego yet.
    """
    name = prompt_text("Name for the new ego")
    if not name:
        return None
    if slugify(name) in profiles():
        return slugify(name), True
    rows = [(f"{e['name']} - the profile I already use", (e, True))
            for e in adoptable()]
    # The default browser first among the empty ones, so Enter is "the usual".
    rows += [(f"{e['name']} - new, empty profile", (e, False))
             for e in sorted(installed_engines(),
                             key=lambda e: e["id"] != engine()["id"])]
    eng, existing = (rows[0][1] if len(rows) == 1 else
                     pick(rows, f"What should {name} be?") or (None, None))
    if not eng:
        return None
    return add_profile(name, eng, existing), False


def resolve_choice(chosen):
    """Turn a picker result into a target, creating an ego if asked."""
    if chosen != "__new__":
        return chosen
    made = new_ego()
    return profiles()[made[0]] if made else None


def open_url(url=None, incognito=False):
    by_class = all_targets()
    if any(t["managed"] for t in by_class.values()):
        # Once real profiles exist, the plain shared-data-dir Chrome is not a
        # routing target: reusing it silently drops links into a nameless
        # profile instead of asking.
        by_class = {c: t for c, t in by_class.items() if t["managed"]}
    here = [w for w in browsers_here() if w[1] in by_class]

    # 1. An explicit rule wins, but still opens on this desktop.
    source_class = next((cls for _, cls, foc in here if foc), None)
    routing_url = unwrap(url) if url else None
    if routing_url and routing_url != url:
        log(f"unwrapped: {url} -> {routing_url}")
    rule = match_rule(routing_url, source_class) if url else None
    as_app = bool(rule and rule.get("app"))
    if rule and rule.get("rewrite"):
        pat, repl = rule["rewrite"]
        new_url = re.sub(pat, repl, url)
        if new_url != url:
            log(f"rewrite: {url} -> {new_url}")
            url = new_url
    wanted = rule.get("profile") if rule else None
    why = "rule" if wanted else None
    target = None
    if wanted:
        slug = slugify(wanted)
        target = next((t for t in by_class.values()
                       if t["slug"] == slug or t["name"].lower() == wanted.lower()), None)
        if target is None:
            notify(f"rule points at unknown profile {wanted!r}")

    # 2. A URL that names an account belongs to an ego, not to a desktop, and
    # no rule says which yet: ask, rather than guess from what is here.
    scope = None
    if (target is None and not wanted and routing_url and not incognito
            and len(by_class) > 1 and os.environ.get("OMAEGO_NO_ASK") != "1"):
        scope = account_scope(routing_url)
    if scope:
        target = ask_account(*scope, by_class, here)
        if target is None:
            return
        why = "picked"

    # 3. Otherwise prefer a browser already on this desktop.
    if target is None and here:
        focused = [cls for _, cls, foc in here if foc]
        distinct = {cls for _, cls, _ in here}
        if focused:
            target = by_class[focused[0]]
            why = why or "workspace"
        elif len(distinct) == 1:
            target = by_class[distinct.pop()]
            why = why or "workspace"
        else:
            # More than one ego here: take the first in tiling order rather than
            # interrupting with a picker. A rule still overrides, and the picker
            # remains for a workspace with no ego at all.
            target = by_class[next(cls for _, cls, _ in here)]
            why = why or "workspace"

    # 4. Nothing here: ask which ego to start on this desktop.
    if target is None and by_class and (len(by_class) == 1 or not picker()):
        # One place it could go, or no menu to ask with: open it rather than
        # drop it. The fallback ego if there is one, else the first there is.
        target = next((t for t in by_class.values()
                       if t["slug"] == default_slug()),
                      sorted(by_class.values(), key=lambda t: t["name"])[0])
        why = why or "only choice"
    if target is None:
        chosen = pick(ego_options(by_class),
                      "No ego on this desktop — open link in…")
        if chosen is None:
            return
        target = resolve_choice(chosen)
        if target is None:
            return
        why = why or "picked"

    # Focus the profile's window on this desktop so the tab lands here, not on
    # whatever desktop that profile last had focus on.
    log_route(routing_url or url, target["name"], why or "fallback")

    addr = next((a for a, cls, _ in here if cls == target["wm_class"] and a), None)
    if as_app:
        launch(target, url, as_app=True)
    elif incognito:
        launch(target, url, incognito=True)
    elif url:
        # Focus first so the tab lands on this desktop, not wherever that
        # profile last had focus.
        if addr:
            focus(addr)
            launch(target, url)
        else:
            launch(target, url, new_window=True)
    elif addr:
        focus(addr)          # plain "open browser" and one is already here
    else:
        launch(target, new_window=True)


# --- desktop entries --------------------------------------------------------

def write_desktop_entries():
    DESKTOP_DIR.mkdir(parents=True, exist_ok=True)
    me = os.environ.get("OMAEGO_BIN", str(Path.home() / ".local/bin/omaego"))
    eng = engine()
    (DESKTOP_DIR / "omaego.desktop").write_text(f"""[Desktop Entry]
Type=Application
Name=omaego
Comment=Open links in the ego whose browser is already on this desktop
Exec={me} %u
Icon={eng['icon']}
Terminal=false
NoDisplay=true
MimeType=x-scheme-handler/http;x-scheme-handler/https;text/html;
""")
    dflt = default_slug()
    egos = profiles()
    # omarchy-launch-webapp sends every default browser it does not recognise -
    # omaego included - to chromium.desktop, keeps only the first token of its
    # Exec= and appends --app=<url>. So that file has to be ours, and has to
    # start with omaego-webapp. It shadows the real Chromium entry, so when
    # Chromium is the engine it doubles as the plain browser entry instead of
    # hiding the browser from the launcher.
    sibling = Path(me).parent / "omaego-webapp"
    webapp = str(sibling) if sibling.exists() else (
        shutil.which("omaego-webapp") or "omaego-webapp")
    # The plain browser entry is the fallback ego's browser, if there is one.
    plain_id = egos[dflt]["engine"]["id"] if dflt in egos else eng["id"]
    plain = plain_id == "chromium.desktop"
    owner = egos.get(dflt) if plain else None
    (DESKTOP_DIR / "chromium.desktop").write_text(f"""[Desktop Entry]
Type=Application
Name={"Chromium" if plain else "Chromium (omaego shim)"}
Comment={f"Personal profile ({owner['name']})" if owner else "omarchy-launch-webapp falls back here; omaego-webapp gives the web app an ego"}
Exec={webapp} %U
Icon={ENGINES["chromium.desktop"]["icon"] if plain else eng['icon']}
Terminal=false
Categories=Network;WebBrowser;
{f"StartupWMClass={owner['wm_class']}" if owner else ""}
{"" if plain else "NoDisplay=true"}
""")
    # A plain entry written for an engine we have since moved off would keep
    # shadowing that browser's own.
    for did in ENGINES:
        f = DESKTOP_DIR / did
        if did in (plain_id, "chromium.desktop") or not f.exists():
            continue
        try:
            if re.search(r"^Exec=.*omaego", f.read_text(), re.M):
                f.unlink()
        except OSError:
            pass
    for slug, p in egos.items():
        ensure_native_hosts(p["data_dir"])
        is_default = slug == dflt
        own = p["engine"]
        # The default profile owns the engine's plain entry ("Google Chrome"),
        # and its own per-profile entry is hidden so the launcher does not show
        # both.
        (DESKTOP_DIR / f"chrome-{slug}.desktop").write_text(f"""[Desktop Entry]
Type=Application
Name={own['short']} {p['name']}
Exec={me} launch {slug} %U
Icon={own['icon']}
Terminal=false
StartupWMClass={p['wm_class']}
Categories=Network;WebBrowser;
{"NoDisplay=true" if is_default else ""}
""")
        if is_default and not plain:
            (DESKTOP_DIR / own["id"]).write_text(f"""[Desktop Entry]
Type=Application
Name={own['name']}
Comment=Personal profile ({p['name']})
Exec={me} launch {slug} %U
Icon={own['icon']}
Terminal=false
StartupWMClass={p['wm_class']}
Categories=Network;WebBrowser;
""")
    subprocess.run(["update-desktop-database", str(DESKTOP_DIR)], capture_output=True)



