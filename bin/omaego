def ego_initials(name):
    """One to three letters for the badge: short all-caps names stay whole."""
    words = [w for w in re.split(r"[^A-Za-z0-9]+", name) if w]
    if not words:
        return "?"
    if len(words) == 1:
        w = words[0]
        return w.upper() if (w.isupper() and len(w) <= 3) else w[:2].upper()
    return (words[0][0] + words[1][0]).upper()


def readable_on(hex_colour):
    """Black or white, whichever reads on that background."""
    h = hex_colour.lstrip("#")
    r, g, b = (int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))
    lum = 0.2126 * r + 0.7152 * g + 0.0722 * b
    return "#000000" if lum > 0.55 else "#ffffff"


def badge_icon(path, text, colour):
    """See apply_badge; this does the drawing."""
    """Stamp an ego badge onto the bottom-right of a 256px app icon.

    Two egos running the same web app otherwise produce identical launcher
    icons, which is exactly the confusion omaego exists to prevent.
    """
    if not shutil.which("magick") or not path.exists():
        return False
    colour = "#" + colour.lstrip("#")
    fg = readable_on(colour)
    tmp = path.with_suffix(".badge.png")
    try:
        # the disc, with a dark rim so it separates from any artwork beneath
        subprocess.run(["magick", "-size", "128x128", "xc:none",
                        "-fill", colour, "-stroke", "#00000066", "-strokewidth", "6",
                        "-draw", "circle 64,64 64,8", str(tmp)], check=True,
                       capture_output=True)
        # the letters, trimmed then fitted inside the disc
        label = path.with_suffix(".txt.png")
        font = subprocess.run(["fc-match", "-f", "%{file}", "DejaVu Sans:bold"],
                              capture_output=True, text=True).stdout.strip()
        args = ["magick", "-background", "none", "-fill", fg]
        if font:
            args += ["-font", font]
        args += ["-pointsize", "96", f"label:{text}", "-trim", "+repage",
                 "-resize", "64x52", str(label)]
        subprocess.run(args, check=True, capture_output=True)
        subprocess.run(["magick", str(tmp), str(label), "-gravity", "center",
                        "-composite", str(tmp)], check=True, capture_output=True)
        subprocess.run(["magick", str(path), "-resize", "256x256",
                        str(tmp), "-gravity", "southeast", "-geometry", "+4+4",
                        "-composite", f"PNG32:{path}"], check=True, capture_output=True)
        return True
    except subprocess.CalledProcessError:
        return False
    finally:
        for f in (tmp, path.with_suffix(".txt.png")):
            f.unlink(missing_ok=True)


def apply_badge(icon_slug, ego):
    """Stamp the ego badge, always from the pristine copy.

    The unbadged original is kept beside it, so re-badging after an ego is
    renamed or recoloured never stacks one disc on top of another.
    """
    if os.environ.get("OMAEGO_NO_BADGE") == "1":
        return False
    icon = ICON_DIR / f"{icon_slug}.png"
    orig = ICON_DIR / f"{icon_slug}.orig.png"
    if not icon.exists() and not orig.exists():
        return False
    if orig.exists():
        shutil.copy(orig, icon)
    else:
        shutil.copy(icon, orig)
    return badge_icon(icon, ego_initials(ego["name"]), ego_color(ego["slug"]))


def normalize_icon(path):
    """Make an icon a 256px transparent PNG, whatever the site served.

    Omarchy's fetcher happily writes a JPEG under a .png name (Outlook) or a
    64px favicon into the 256px directory (Google Chat). A JPEG has no alpha, so
    it shows as a solid white tile on a dark bar. Flood-fill from the corner
    rather than keying on white, so white *inside* a logo survives.
    """
    if not path.exists() or not shutil.which("magick"):
        return False
    kind = subprocess.run(["file", "-b", str(path)], capture_output=True,
                          text=True).stdout
    args = ["magick", str(path), "-alpha", "set"]
    if "JPEG" in kind:                      # opaque source: lift the backdrop
        args += ["-bordercolor", "white", "-border", "1",
                 "-fuzz", "8%", "-fill", "none", "-floodfill", "+0+0", "white",
                 "-shave", "1x1"]
    args += ["-resize", "256x256", f"PNG32:{path}"]
    return subprocess.run(args, capture_output=True).returncode == 0


def fetch_icon(url, dest):
    try:
        r = subprocess.run(["curl", "-fsSL", "--max-time", "10", "-o", str(dest), url],
                           capture_output=True)
        return r.returncode == 0 and dest.exists() and dest.stat().st_size > 0
    except Exception:
        return False


def is_image(path):
    kind = subprocess.run(["file", "-b", "--mime-type", str(path)],
                          capture_output=True, text=True).stdout
    return kind.startswith("image/")


def obtain_icon(src, dest):
    """Put an image named by URL or by local path at dest, as a 256px PNG."""
    src = (src or "").strip()
    if not src:
        return False
    dest.parent.mkdir(parents=True, exist_ok=True)
    local = Path(src[7:] if src.startswith("file://") else src).expanduser()
    if local.is_file():
        if local != dest:
            shutil.copy(local, dest)
    elif not fetch_icon(normalize_url(src), dest):
        return False
    if is_image(dest) and normalize_icon(dest):
        return True
    dest.unlink(missing_ok=True)
    return False


def site_icon(url, dest):
    """The site's own icon, best first: apple-touch-icon, then the favicon
    service. Same order as omarchy's fetcher, done here so the result can be
    shown before anything is installed."""
    u = urlsplit(url)
    if not u.hostname:
        return False
    origin = f"{u.scheme}://{u.netloc}"
    tries = []
    try:
        page = subprocess.run(["curl", "-fsSL", "--max-time", "5", url],
                              capture_output=True, timeout=8).stdout[:200000]
        page = page.decode("utf-8", "replace")
        for tag in re.findall(r"<link\b[^>]*>", page, re.I):
            if not re.search(r"rel=[\"'][^\"']*apple-touch-icon", tag, re.I):
                continue
            href = re.search(r"href=[\"']([^\"']+)", tag, re.I)
            if href:
                h = href.group(1)
                tries.append(h if re.match(r"https?://", h) else
                             "https:" + h if h.startswith("//") else
                             origin + h if h.startswith("/") else
                             origin + "/" + h)
                break
    except Exception:
        pass
    tries += [origin + "/apple-touch-icon.png",
              f"https://www.google.com/s2/favicons?domain={origin}&sz=256"]
    for t in tries:
        if obtain_icon(t, dest):
            # The favicon service answers an unknown host with a 16px globe,
            # which is worse than saying nothing was found.
            w = subprocess.run(["magick", "identify", "-format", "%w", str(dest)],
                               capture_output=True, text=True).stdout.strip()
            if t.startswith("https://www.google.com/s2/") and w.isdigit() and int(w) < 32:
                dest.unlink(missing_ok=True)
                return False
            return True
    return False


def catalog_icon(key):
    return CACHE / "catalog" / f"{key}.png"


def looks_like_url(text):
    t = (text or "").strip()
    return bool(t) and not re.search(r"\s", t) and (
        "://" in t or re.match(r"^[^./]+(\.[^./]+)+", t) is not None)


def catalog_match(text):
    """The catalogue key that typed text names: by name or key, or for a URL by
    its host. A pasted outlook.office.com/mail is Outlook, not a custom app."""
    t = (text or "").strip().lower()
    if not t:
        return None
    if looks_like_url(t):
        host = (urlsplit(normalize_url(t)).hostname or "").removeprefix("www.")
        return next((k for k, v in WEBAPPS.items()
                     if (urlsplit(v[1]).hostname or "").removeprefix("www.") == host),
                    None)
    return next((k for k, v in WEBAPPS.items() if t in (k, v[0].lower())), None)


def catalog_fetch():
    """Download every catalogue icon that is not cached yet. Returns how many."""
    from concurrent.futures import ThreadPoolExecutor
    todo = [(k, v[3]) for k, v in WEBAPPS.items()
            if v[3] and not catalog_icon(k).exists()]
    with ThreadPoolExecutor(8) as ex:
        return sum(ex.map(lambda kv: obtain_icon(kv[1], catalog_icon(kv[0])), todo))


def app_probe(url, ego_name=None, icon=None, names_only=False):
    """What the create form shows for a URL: name candidates and an icon.

    names_only skips the network, so names can be offered at once while the
    icon - up to three fetches against a host that may not answer - follows.
    """
    url = normalize_url((url or "").strip())
    host = urlsplit(url).hostname if url else None
    out = {"url": url or "", "host": host or "", "names": [], "iconPath": ""}
    if not host or "." not in host or re.search(r"\s", url):
        return out
    out["names"] = name_candidates(url, ego_name)
    if names_only:
        return out
    key = next((k for k, v in WEBAPPS.items() if v[1].rstrip("/") == url.rstrip("/")), None)
    if key and not icon:
        dest = catalog_icon(key)
        if dest.exists() or obtain_icon(WEBAPPS[key][3], dest):
            out["iconPath"] = str(dest)
        return out
    import hashlib
    dest = CACHE / "probe" / (hashlib.sha1((icon or url).encode()).hexdigest()[:16] + ".png")
    if dest.exists() or (obtain_icon(icon, dest) if icon else site_icon(url, dest)):
        out["iconPath"] = str(dest)
    return out


def app_rule_conflict(domain):
    """Which ego, if any, already claims this domain in rules.toml."""
    if not domain:
        return None
    for r in load_rules():
        pat = r.get("url") or r.get("match") or ""
        if domain in pat:
            return r.get("profile")
    return None


def append_rule(domain, ego_name):
    RULES.parent.mkdir(parents=True, exist_ok=True)
    with RULES.open("a") as f:
        f.write(f'\n[[rule]]\nurl = "https://*{domain}/*"\nprofile = "{ego_name}"\n')


def name_from_url(url):
    """A sensible app name from a URL: the registrable part of the host."""
    host = (urlsplit(url).hostname or "").lower().lstrip("www.")
    parts = [p for p in host.split(".") if p not in ("com", "org", "net", "io",
                                                     "app", "co", "www")]
    return (name_candidates(url) or [host])[0]


def name_candidates(url, ego_name=None):
    """Plausible names for a URL, best first.

    No rule gets both shapes right - jira.acme.io is "Jira" (the subdomain)
    while acme.odoo.com is "Odoo" (the registrable domain) - so offer both
    and let the choice be made.
    """
    host = (urlsplit(url).hostname or "").lower()
    for junk in ("www.", "app.", "my."):
        if host.startswith(junk):
            host = host[len(junk):]
    parts = [p for p in host.split(".")
             if p not in ("com", "org", "net", "io", "co", "app", "de", "ai")]
    # A first path segment is frequently the real product: google.com/maps is
    # "Maps", not "Google". Offered alongside the host, so the choice is made
    # rather than guessed.
    seg = [w for w in (urlsplit(url).path or "").strip("/").split("/")[:1] if w]
    cands = ([parts[0]] if parts else []) + (parts[1:2] if len(parts) > 1 else [])
    if seg and seg[0].isalpha() and 2 <= len(seg[0]) <= 14:
        cands.append(seg[0])
    out = []
    for p in cands:
        n = p.replace("-", " ").title()
        # The ego is already known from the card the app is being added under,
        # so its own name is never the app's name: acme.odoo.com under the
        # Acme ego is simply "Odoo".
        if ego_name and n.lower() == ego_name.lower():
            continue
        if n not in out:
            out.append(n)
    return out or [host]


def normalize_url(url):
    if url and not re.match(r"^[a-z][a-z0-9+.-]*://", url, re.I):
        url = "https://" + url
    return url


def find_app(slug, want):
    """An installed app of this ego by its launcher name ("Outlook Acme"), its
    name without the ego ("Outlook"), or its catalogue key ("outlook")."""
    apps = installed_apps().get(slug, [])
    ego = profiles().get(slug, {}).get("name", "")
    w = (want or "").strip().lower()
    def short(n):
        return re.sub(rf"\s*\b{re.escape(ego)}\b\s*", " ", n, flags=re.I).strip().lower()
    return (next((a for a in apps if a["name"].lower() == w), None)
            or next((a for a in apps if short(a["name"]) == w), None)
            or next((a for a in apps if a["key"] == w), None))


def remove_app(app):
    """Delete an installed web app: its launcher and both icon files.

    Not `omarchy webapp remove`: it indexes launchers by omarchy's own Exec
    line, which ours do not have, and it leaves the unbadged .orig behind."""
    (DESKTOP_DIR / app["desktop"]).unlink(missing_ok=True)
    icon = app["icon"]
    if icon and "/" not in icon:
        for suffix in (".png", ".orig.png"):
            (ICON_DIR / f"{icon}{suffix}").unlink(missing_ok=True)
    subprocess.run(["update-desktop-database", str(DESKTOP_DIR)], capture_output=True)
    subprocess.run(["gtk-update-icon-cache",
                    str(Path.home() / ".local/share/icons/hicolor")],
                   capture_output=True)


def rename_app(app, new_name):
    """Rename an installed web app: its launcher, and its icon files with it."""
    old_desktop = DESKTOP_DIR / app["desktop"]
    old_slug = app["icon"] if app["icon"] and "/" not in app["icon"] else None
    new_slug = re.sub(r"[^a-z0-9]+", "-", new_name.lower()).strip("-")
    txt = old_desktop.read_text()
    txt = re.sub(r"^Name=.*$", f"Name={new_name}", txt, flags=re.M)
    if old_slug:
        for suffix in (".png", ".orig.png"):
            src = ICON_DIR / f"{old_slug}{suffix}"
            if src.exists():
                src.rename(ICON_DIR / f"{new_slug}{suffix}")
        txt = re.sub(r"^Icon=.*$", f"Icon={new_slug}", txt, flags=re.M)
    (DESKTOP_DIR / f"{new_name}.desktop").write_text(txt)
    if old_desktop.name != f"{new_name}.desktop":
        old_desktop.unlink(missing_ok=True)
    print(f"  {app['name']}  ->  {new_name}")


def set_app_icon(slug, app, src):
    """Replace an installed web app's icon with an image URL or file, badged."""
    icon_slug = re.sub(r"[^a-z0-9]+", "-", app["name"].lower()).strip("-")
    ICON_DIR.mkdir(parents=True, exist_ok=True)
    dest = ICON_DIR / f"{icon_slug}.png"
    ok = (Path(src).exists() and shutil.copy(src, dest)) or fetch_icon(src, dest)
    if not (ok and normalize_icon(dest)):
        print(f"could not use {src}", file=sys.stderr)
        notify(f"could not use that image for {app['name']}")
        return False
    (ICON_DIR / f"{icon_slug}.orig.png").unlink(missing_ok=True)
    apply_badge(icon_slug, profiles()[slug])
    d = DESKTOP_DIR / app["desktop"]
    d.write_text(re.sub(r"^Icon=.*$", f"Icon={icon_slug}", d.read_text(),
                        flags=re.M))
    subprocess.run(["gtk-update-icon-cache",
                    str(Path.home() / ".local/share/icons/hicolor")],
                   capture_output=True)
    subprocess.run(["update-desktop-database", str(DESKTOP_DIR)],
                   capture_output=True)
    print(f"  {app['name']}: icon set from {src}")
    return True


# --- the egos repo -----------------------------------------------------------
# ~/.config/omaego is meant to be a private git repo: rules.toml, account-hosts,
# and egos.toml - every ego, its colour and its web apps - with each app's
# unbadged icon under icons/. The browser's own data (logins, cookies, history)
# never goes in it, and neither does what belongs to one device: which browser
# an ego runs in, the fallback ego, the remembered default browser (`engine`,
# git-ignored).
#
# A device opts in to each ego. An ego the repo declares that this device has
# not set up is offered on the panel; setting it up (`omaego add <name>`)
# creates it from egos.toml, and from then on it syncs like any other.
#
# Nothing is written there behind your back. `omaego sync --status` compares
# the repo with this machine read-only, for the panel's sync icon; `omaego
# sync` writes this machine's state, pulls, and hands anything that needs a
# commit message or a merge to the default agent.

CONFIG_DIR = Path.home() / ".config/omaego"
EGOS_FILE = CONFIG_DIR / "egos.toml"


def short_name(name, ego_name):
    """ "Outlook Work" -> "Outlook": the launcher name without its ego."""
    return re.sub(rf"\s*\b{re.escape(ego_name)}\b\s*", " ", name,
                  flags=re.I).strip() or name


def load_declared():
    """egos.toml as slug -> {name, color, accounts, apps, remotes}. Empty when absent."""
    try:
        data = tomllib.loads(EGOS_FILE.read_text())
    except FileNotFoundError:
        return {}
    except Exception as e:
        log(f"egos.toml: {e}")
        notify(f"egos.toml: {e}")
        return {}
    out = {}
    for e in data.get("ego", []):
        if e.get("slug"):
            out[e["slug"]] = {
                "name": e.get("name") or e["slug"].title(),
                "color": (e.get("color") or "").lstrip("#") or None,
                # Optional: the addresses this ego signs in with, so a device
                # setting it up knows which account belongs in it.
                "accounts": merge_accounts([a for a in e.get("accounts", [])
                                            if isinstance(a, str) and "@" in a]),
                "apps": [a for a in e.get("app", []) if a.get("url") and a.get("name")],
                "remotes": [r for r in e.get("remote", [])
                            if r.get("name") and r.get("machine")
                            and r.get("kind") in REMOTE_KINDS],
            }
    return out


def ego_sort_key():
    """Sort key for egos: their order in egos.toml, which you can rearrange by
    hand; egos it does not list yet come after, by name. Takes an ego dict
    (with slug and name) or a (slug, name) pair."""
    rank = {k: i for i, k in enumerate(load_declared())}   # file order
    def key(t):
        slug, name = (t["slug"], t["name"]) if isinstance(t, dict) else t
        return (rank.get(slug, len(rank)), (name or slug).lower())
    return key


def local_icon(app):
    """The unbadged original of an installed app's icon, if it has one."""
    icon = app.get("icon") or ""
    if not icon or "/" in icon:
        return None
    for f in (ICON_DIR / f"{icon}.orig.png", ICON_DIR / f"{icon}.png"):
        if f.exists():
            return f
    return None


def repo_state():
    """What egos.toml should say: every ego and installed app on this machine,
    plus whatever the file declares that this machine has not installed yet.

    An app is the same app on every machine when its ego and URL match, so a
    rename here is a rename, not a second entry. Declared apps are kept until
    removed on purpose - removing an app edits egos.toml itself - so a machine
    that never opened one does not delete it for everyone.
    """
    decl, egos, inst = load_declared(), profiles(), installed_apps()
    state, icons = {}, {}
    # The file's order is kept: it is the order of the cards, and yours to edit.
    key = ego_sort_key()
    names = {**{k: d["name"] for k, d in decl.items()}, **{k: e["name"] for k, e in egos.items()}}
    for slug in sorted(set(egos) | set(decl), key=lambda k: key((k, names[k]))):
        d = decl.get(slug, {})
        here = slug in egos
        name = egos[slug]["name"] if here else d["name"]
        apps = {}
        for a in inst.get(slug, []) if here else []:
            entry = {"name": short_name(a["name"], name), "url": a["url"]}
            if a.get("key"):
                entry["key"] = a["key"]
            src = local_icon(a)
            if src:
                entry["icon"] = f"icons/{a['icon']}.png"
                icons[entry["icon"]] = src
            apps[a["url"]] = entry
        for a in d.get("apps", []):
            if a["url"] not in apps:
                apps[a["url"]] = {k: a[k] for k in ("name", "url", "key", "icon") if a.get(k)}
        # The file's order, which dragging on the card rearranges; apps it
        # does not list yet go after, by name.
        rank = {a["url"]: i for i, a in enumerate(d.get("apps", []))}
        state[slug] = {
            "name": name,
            "color": ego_color(slug) if here else d.get("color"),
            # Kept from the file and added to from the browser, never dropped
            # because this device is signed out: removing one is `omaego account
            # remove`, on purpose.
            "accounts": merge_accounts(d.get("accounts"),
                                       browser_accounts(egos[slug]) if here else []),
            "apps": sorted(apps.values(),
                           key=lambda x: (rank.get(x["url"], len(rank)), x["name"].lower())),
            # Remotes exist only as declarations: nothing on disk to export.
            "remotes": d.get("remotes", []),
        }
    return state, icons


def render_egos(state):
    q = lambda v: json.dumps(v, ensure_ascii=False)   # a JSON string is a TOML one
    out = ["# Every omaego ego and its web apps. Logins and cookies are not in here.",
           "# `omaego sync` writes it from this machine; after editing it by hand,",
           "# run `omaego apply` first, or the next sync writes your edit back.", ""]
    for slug, e in state.items():
        out += ["[[ego]]", f"slug = {q(slug)}", f"name = {q(e['name'])}"]
        if e.get("color"):
            out.append(f"color = {q(e['color'])}")
        if e.get("accounts"):
            out.append(f"accounts = {q(e['accounts'])}")   # and a JSON array a TOML one
        out.append("")
        for a in e["apps"]:
            out.append("[[ego.app]]")
            out += [f"{k} = {q(a[k])}" for k in ("name", "url", "key", "icon") if a.get(k)]
            out.append("")
        for r in e.get("remotes", []):
            out.append("[[ego.remote]]")
            out += [f"{k} = {int(r[k]) if k == 'port' else q(r[k])}"
                    for k in REMOTE_KEYS if r.get(k) not in (None, "")]
            out.append("")
    return "\n".join(out)


def export_repo(write=True):
    """Bring egos.toml and icons/ up to this machine's state. Returns the
    paths that differ (and, with write, were rewritten)."""
    import filecmp
    state, icons = repo_state()
    text = render_egos(state)
    changed = []
    try:
        old = EGOS_FILE.read_text()
    except FileNotFoundError:
        old = None
    if old != text:
        changed.append("egos.toml")
        if write:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            EGOS_FILE.write_text(text)
    for rel, src in icons.items():
        dest = CONFIG_DIR / rel
        if not dest.exists() or not filecmp.cmp(src, dest, shallow=False):
            changed.append(rel)
            if write:
                dest.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy(src, dest)
    keep = set(icons) | {a["icon"] for e in state.values() for a in e["apps"] if a.get("icon")}
    for f in sorted((CONFIG_DIR / "icons").glob("*.png")):
        rel = f"icons/{f.name}"
        if rel not in keep:
            changed.append(rel)
            if write:
                f.unlink()
    return changed


def forget_declared(slug, url):
    """Drop one app from egos.toml: removing an app is a decision to sync."""
    decl = load_declared()
    if slug not in decl:
        return
    apps = decl[slug]["apps"]
    keep = [a for a in apps if a["url"] != url]
    if len(keep) != len(apps):
        decl[slug]["apps"] = keep
        EGOS_FILE.write_text(render_egos(decl))
        for a in apps:
            if a["url"] == url and a.get("icon"):
                (CONFIG_DIR / a["icon"]).unlink(missing_ok=True)


def set_accounts(slug, add=(), remove=()):
    """Add or drop accounts on one ego in egos.toml. An ego the file does not
    list yet gets an entry of its own; the next sync fills in its apps."""
    decl = load_declared()
    if slug not in decl:
        ego = profiles()[slug]
        decl[slug] = {"name": ego["name"], "color": ego_color(slug),
                      "accounts": [], "apps": []}
    drop = {a.lower() for a in remove}
    decl[slug]["accounts"] = [a for a in merge_accounts(decl[slug]["accounts"], add)
                              if a.lower() not in drop]
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    EGOS_FILE.write_text(render_egos(decl))   # the file's order, which is yours
    return decl[slug]["accounts"]


def icon_from_repo(icon_slug, repo_rel, ego):
    """Install a repo icon byte for byte as the original, then badge it - so
    the next export finds nothing changed."""
    src = CONFIG_DIR / repo_rel
    if not src.is_file():
        return False
    ICON_DIR.mkdir(parents=True, exist_ok=True)
    shutil.copy(src, ICON_DIR / f"{icon_slug}.orig.png")
    return apply_badge(icon_slug, ego)


def pending_apps(slug):
    """Apps egos.toml declares for an ego that are not installed here yet."""
    have = {a["url"] for a in installed_apps().get(slug, [])}
    return [a for a in load_declared().get(slug, {}).get("apps", [])
            if a["url"] not in have]


def install_declared(slug, decl_app):
    """Install one declared app as egos.toml describes it. Returns the app."""
    ego = profiles()[slug]
    icon = str(CONFIG_DIR / decl_app["icon"]) if decl_app.get("icon") else None
    if decl_app.get("key") and decl_app["key"] in WEBAPPS and not icon:
        app_add(slug, [decl_app["key"]])
    else:
        app_add(slug, [], url=decl_app["url"], display=decl_app["name"], icon=icon)
    app = next((a for a in installed_apps().get(slug, [])
                if a["url"] == decl_app["url"]), None)
    if app and decl_app.get("icon") and app.get("icon") and "/" not in app["icon"]:
        icon_from_repo(app["icon"], decl_app["icon"], ego)
        subprocess.run(["gtk-update-icon-cache",
                        str(Path.home() / ".local/share/icons/hicolor")],
                       capture_output=True)
    return app


def apply_repo(prune=False):
    """Make this device's egos match egos.toml: names and colours, and their
    installed apps renamed and re-iconed. Only egos set up here: one the repo
    adds is offered on the panel, never created behind your back. Declared apps
    that are not installed stay that way - the first click installs. With
    prune, installed apps egos.toml no longer lists are removed (removed on
    another device). An ego is never deleted: its browser data is not something
    a sync should throw away."""
    import filecmp
    decl = load_declared()
    if not decl:
        return []
    done = []
    for slug, e in decl.items():
        d = EGO_ROOT / slug
        if not d.exists():
            continue
        nf = d / ".profile-name"
        if not nf.exists() or nf.read_text().strip() != e["name"]:
            nf.write_text(e["name"] + "\n")
            done.append(f"renamed ego {e['name']}")
        if e.get("color") and ego_color(slug) != e["color"]:
            (d / ".ego-color").write_text(e["color"] + "\n")
    egos = profiles()
    for slug, apps in installed_apps().items():
        if slug not in decl or slug not in egos:
            continue
        by_url = {a["url"]: a for a in decl[slug]["apps"]}
        for a in apps:
            want = by_url.get(a["url"])
            if want is None:
                if prune:
                    remove_app(a)
                    done.append(f"removed {a['name']}")
                continue
            full = APP_NAME_TEMPLATE.format(app=want["name"], ego=egos[slug]["name"])
            if a["name"] != full:
                rename_app(a, full)
                a = next(x for x in installed_apps()[slug] if x["url"] == a["url"])
                done.append(f"renamed {full}")
            src = CONFIG_DIR / want["icon"] if want.get("icon") else None
            cur = local_icon(a)
            if src and src.is_file() and a.get("icon") and "/" not in a["icon"] \
                    and not (cur and filecmp.cmp(src, cur, shallow=False)):
                icon_from_repo(a["icon"], want["icon"], egos[slug])
                done.append(f"new icon for {a['name']}")
    write_remote_entries()
    subprocess.run(["update-desktop-database", str(DESKTOP_DIR)], capture_output=True)
    subprocess.run(["gtk-update-icon-cache",
                    str(Path.home() / ".local/share/icons/hicolor")],
                   capture_output=True)
    return done


def available_egos():
    """Egos the repo declares that this device has not set up."""
    here = profiles()
    return {k: e for k, e in load_declared().items() if k not in here}


# ---- Remotes: herdr sessions, TUIs and gateways on your tailnet ------------
# A remote is one thing running on one machine - a herdr session, any TUI, a
# web gateway - pinned to one ego. Separate things stay separate: two herdr
# sessions are two remotes, never one session for everything. A remote lives
# only in egos.toml, so it syncs, and every machine opens it its own way:
# directly on the machine it runs on, over ssh from any other, and a gateway
# through that machine's Tailscale serve URL or, failing that, an ssh tunnel.

REMOTE_KINDS = ("herdr", "tui", "web")
REMOTE_KEYS = ("name", "kind", "machine", "ssh", "session", "command",
               "port", "path", "url", "icon")
# Gateways worth offering when a machine answers on their default port.
GATEWAYS = {18789: "OpenClaw", 9119: "Hermes"}
# Their terminal UIs: run on the gateway's machine, they talk to it directly.
AGENT_TUIS = {18789: "openclaw tui", 9119: "hermes --tui"}
REMOTE_PREFIX = "omaego-remote-"
SERVE_CACHE = Path.home() / ".cache/omaego/serve.json"


def tailnet():
    """(this machine, {machine: {dns, online, os}}), from Tailscale.

    A machine is its MagicDNS label: two Macs can share a HostName, never a
    DNS name. Without Tailscale, this machine is its hostname and there are no
    peers. OMAEGO_MACHINE overrides the name, for a box or a test."""
    import socket
    label = lambda n: (n.get("DNSName") or n.get("HostName") or "").split(".")[0].lower()
    me = os.environ.get("OMAEGO_MACHINE")
    try:
        r = subprocess.run(["tailscale", "status", "--json"],
                           capture_output=True, text=True, timeout=4)
        d = json.loads(r.stdout)
    except Exception:
        d = {}
    me = me or label(d.get("Self") or {}) or socket.gethostname().split(".")[0].lower()
    peers = {}
    for n in (d.get("Peer") or {}).values():
        if label(n):
            peers[label(n)] = {"dns": (n.get("DNSName") or "").rstrip("."),
                               "online": bool(n.get("Online")), "os": n.get("OS", "")}
    peers[me] = {"dns": ((d.get("Self") or {}).get("DNSName") or "").rstrip("."),
                 "online": True, "os": "this machine"}
    return me, peers


def remote_id(r):
    return slugify(r["name"])


def remote_owners():
    """{remote id: [ego slugs it is pinned to]}, from egos.toml."""
    out = {}
    for k, r in declared_remotes():
        out.setdefault(remote_id(r), []).append(k)
    return out


def remote_owner(cls, pinned):
    """The ego a remote's terminal (class TUI.omaego.<ego>.<remote>) belongs
    to now. The class is fixed when the window opens, so after the remote is
    pinned to another ego, the pin wins over the class. None if not a remote."""
    parts = remote_class_parts(cls)
    if not parts:
        return None
    slug, rid = parts
    owners = pinned.get(rid, [])
    return slug if slug in owners or not owners else (owners[0] if len(owners) == 1 else slug)


def remote_label(r):
    """What the launcher calls it: app first, ego last, the machine with it."""
    return f"{r['name']} @{r['machine']}"


def declared_remotes(slug=None):
    """(slug, remote) for every declared remote, or one ego's."""
    return [(k, r) for k, e in load_declared().items() if slug in (None, k)
            for r in e.get("remotes", [])]


def find_remote(slug, want):
    want = (want or "").lower()
    for _, r in declared_remotes(slug):
        if want in (remote_id(r), r["name"].lower()):
            return r
    return None


def save_remotes(slug, remotes):
    """Rewrite one ego's remotes in egos.toml. The file is created from this
    machine's state first, so a remote can be added before any sync."""
    if not EGOS_FILE.exists():
        export_repo(write=True)
    decl = load_declared()
    if slug not in decl:
        e = profiles().get(slug)
        if not e:
            return False
        decl[slug] = {"name": e["name"], "color": ego_color(slug), "apps": []}
    decl[slug]["remotes"] = remotes
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    EGOS_FILE.write_text(render_egos(decl))
    return True


def serve_urls(status_json, dns):
    """{local port: https URL} from `tailscale serve status --json`."""
    try:
        d = json.loads(status_json or "{}")
    except Exception:
        return {}
    out = {}
    for hostport, web in (d.get("Web") or {}).items():
        host, _, sport = hostport.rpartition(":")
        base = f"https://{host or dns}" + ("" if sport in ("443", "") else f":{sport}")
        for path, h in (web.get("Handlers") or {}).items():
            m = re.match(r"https?://(?:127\.0\.0\.1|localhost):(\d+)", h.get("Proxy") or "")
            if m:
                out.setdefault(int(m.group(1)), base + (path if path != "/" else ""))
    return out


PROBE = r"""command -v herdr >/dev/null 2>&1 && herdr session list 2>/dev/null | awk 'NR>1 {print "herdr", $1, $2}'
for p in %s; do curl -s -m 1 -o /dev/null "http://127.0.0.1:$p/" && echo "port $p"; done
echo "serve $(tailscale serve status --json 2>/dev/null | tr -d '\n')"
"""


# Why the last probe of a machine came back empty: ("auth", url) when
# Tailscale SSH wants a login approved in the browser, ("unreachable", "").
PROBE_WHY = {}


def _probe_run(machine, cmd, inp):
    """Run a probe; its stdout, or None. Tailscale SSH's "additional check"
    prints a login URL and then waits for it, so the URL is caught as it comes
    instead of after the timeout."""
    import threading
    PROBE_WHY.pop(machine, None)
    try:
        p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                             stderr=subprocess.PIPE, text=True)
    except Exception:
        PROBE_WHY[machine] = ("unreachable", "")
        return None
    err, out = [], []
    def drain(stream, into):
        for line in stream:
            into.append(line)
    ts = [threading.Thread(target=drain, args=(p.stdout, out), daemon=True),
          threading.Thread(target=drain, args=(p.stderr, err), daemon=True)]
    for t in ts:
        t.start()
    try:
        if inp:
            p.stdin.write(inp)
        p.stdin.close()
    except Exception:
        pass
    end = time.monotonic() + 12
    while p.poll() is None and time.monotonic() < end:
        url = next((m.group(0) for line in err
                    for m in [re.search(r"https://login\.tailscale\.com/\S+", line)] if m), None)
        if url:
            p.kill()
            PROBE_WHY[machine] = ("auth", url)
            return None
        time.sleep(0.05)
    if p.poll() is None:
        p.kill()
        PROBE_WHY[machine] = ("unreachable", "")
        return None
    for t in ts:
        t.join(1)
    if p.returncode != 0 and not out:
        PROBE_WHY[machine] = ("unreachable", "")
        return None
    return "".join(out)


def probe_machine(machine, me, target=None):
    """What one machine offers: herdr sessions, gateways, serve URLs. Runs the
    probe over ssh in a login shell (herdr is often in ~/.local/bin), or
    directly on this machine."""
    script = PROBE % " ".join(str(p) for p in GATEWAYS)
    if machine == me:
        cmd = ["sh", "-c", script]
        inp = None
    else:
        cmd = ["ssh", "-T", "-o", "BatchMode=yes", "-o", "ConnectTimeout=4",
               target or machine, 'exec "${SHELL:-/bin/sh}" -l']
        inp = script
    out = _probe_run(machine, cmd, inp)
    if out is None:
        return None
    found = {"sessions": [], "ports": [], "serve": {}}
    for line in out.splitlines():
        parts = line.split(None, 1)
        if not parts:
            continue
        if parts[0] == "herdr" and len(parts) == 2:
            name, *st = parts[1].split()
            found["sessions"].append((name, st[0] if st else ""))
        elif parts[0] == "port" and len(parts) == 2 and parts[1].isdigit():
            found["ports"].append(int(parts[1]))
        elif parts[0] == "serve":
            found["serve"] = serve_urls(parts[1] if len(parts) == 2 else "", machine)
    return found


def remember_serve(machine, urls):
    try:
        cache = json.loads(SERVE_CACHE.read_text())
    except Exception:
        cache = {}
    cache[machine] = {"at": int(time.time()), "urls": {str(k): v for k, v in urls.items()}}
    SERVE_CACHE.parent.mkdir(parents=True, exist_ok=True)
    SERVE_CACHE.write_text(json.dumps(cache))


def serve_url_for(machine, port, target=None):
    """The machine's Tailscale serve URL for a local port, if it serves one.
    Asked over ssh at most once a day per machine."""
    try:
        hit = json.loads(SERVE_CACHE.read_text()).get(machine)
    except Exception:
        hit = None
    if not hit or time.time() - hit.get("at", 0) > 86400:
        found = probe_machine(machine, None, target)
        if found is None:
            return (hit or {}).get("urls", {}).get(str(port))
        remember_serve(machine, found["serve"])
        return found["serve"].get(port)
    return hit["urls"].get(str(port))


def pinned_remote_keys():
    return {(r["machine"], r["kind"], r.get("session"), r.get("port"))
            for _, r in declared_remotes()}


def machine_offers(m, f, have):
    """What machine m offers to pin, from its probe f: rows with a name, a
    note, and the spec `remote pick --spec` takes. Already pinned is left out."""
    if not f:
        return []
    remember_serve(m, f["serve"])
    out = []
    for sess, st in f["sessions"]:
        if (m, "herdr", sess, None) not in have:
            out.append({"name": sess, "kind": "herdr",
                        "note": "stopped" if st == "stopped" else "",
                        "spec": ["herdr", m, sess]})
    for port in f["ports"]:
        label = GATEWAYS.get(port, f"gateway :{port}")
        if (m, "web", None, port) not in have:
            out.append({"name": f"{label} web", "kind": "web", "note": "",
                        "spec": ["web", m, str(port)]})
        if port in AGENT_TUIS:
            out.append({"name": f"{label} TUI", "kind": "tui", "note": "",
                        "spec": ["agent-tui", m, AGENT_TUIS[port]]})
    out.append({"name": "New herdr session…", "kind": "new", "note": "",
                "spec": ["herdr-new", m]})
    out.append({"name": "Any TUI…", "kind": "any", "note": "",
                "spec": ["tui-on", m]})
    return out


def stream_offers():
    """`remote pick <ego> --json`: one JSON line per machine as its probe
    answers, so the panel lists what is known while it waits for the rest,
    then {"done": true}."""
    from concurrent.futures import ThreadPoolExecutor, as_completed
    def emit(obj):
        print(json.dumps(obj), flush=True)
    me, peers = tailnet()
    emit({"machine": me, "here": True, "offers": [], "start": True})
    # Every machine that could run a TUI, so one missing is never a mystery:
    # offline ones at once, the rest as their probes answer.
    cands = [m for m, p in peers.items()
             if m == me or p["os"] in ("linux", "macOS")]
    for m in cands:
        if m != me and not peers[m]["online"]:
            emit({"machine": m, "here": False, "status": "offline", "offers": []})
    have = pinned_remote_keys()
    with ThreadPoolExecutor(8) as ex:
        futs = {ex.submit(probe_machine, m, me): m
                for m in cands if m == me or peers[m]["online"]}
        for fut in as_completed(futs):
            m = futs[fut]
            try:
                f = fut.result()
            except Exception as e:
                log(f"remote pick: {m}: {e!r}")
                f = None
            why, url = PROBE_WHY.get(m, ("unreachable", "")) if f is None else ("ok", "")
            emit({"machine": m, "here": m == me, "status": why, "url": url,
                  "offers": machine_offers(m, f, have)})
    emit({"done": True})
    return 0


def pin_offer(slug, spec, value=None):
    """Pin what `remote pick` offered, asking for what the row leaves open
    unless `value` (the panel asks itself) brings it. Pins only: the card
    shows it, and opening is a click there."""
    me_bin = os.environ.get("OMAEGO_BIN", sys.argv[0])
    add = lambda *a: subprocess.run([me_bin, "remote", "add", slug, *a]).returncode
    if spec[0] == "herdr-new":
        sess = (value if value is not None else
                prompt_text(f"Name of the new herdr session on {spec[1]}") or "").strip()
        if not sess:
            return 0
        return add("herdr", spec[1], slugify(sess))
    if spec[0] == "agent-tui":
        return add("tui", spec[1], "--", spec[2])
    if spec[0] == "tui-on":
        command = (value if value is not None else
                   prompt_text(f"What to run on {spec[1]}, e.g. btop", width=560) or "").strip()
        return add("tui", spec[1], "--", command) if command else 0
    if spec[0] == "tui-new":
        txt = (value if value is not None else
               prompt_text("machine: command, e.g. box: btop", width=560) or "").strip()
        if ":" not in txt:
            if value is not None:
                notify("say where and what: machine: command")
            return 0
        m, command = (x.strip() for x in txt.split(":", 1))
        return add("tui", m.lower(), "--", command)
    return add(*spec)


def tunnel_port(machine, port):
    """A local port fixed per (machine, port): the gateway's origin - and so
    its stored login - stays the same across tunnels."""
    import zlib
    return 20000 + zlib.crc32(f"{machine}:{port}".encode()) % 20000


def port_open(port):
    import socket
    with socket.socket() as s:
        s.settimeout(0.3)
        return s.connect_ex(("127.0.0.1", port)) == 0


def ensure_tunnel(target, port, local):
    """Start the supervised ssh tunnel unless one already listens."""
    if port_open(local):
        return True
    me = os.environ.get("OMAEGO_BIN", shutil.which("omaego") or sys.argv[0])
    subprocess.Popen([me, "remote", "tunnel", target, str(port), str(local)],
                     start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for _ in range(40):
        if port_open(local):
            return True
        time.sleep(0.25)
    return False


def run_tunnel(target, port, local, idle_limit=600):
    """Keep `ssh -L local:127.0.0.1:port target` up, reconnecting with backoff,
    and stop once nothing has used it for idle_limit seconds."""
    backoff, idle = 2, 0
    while idle < idle_limit:
        p = subprocess.Popen(
            ["ssh", "-N", "-o", "BatchMode=yes", "-o", "ExitOnForwardFailure=yes",
             "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=3",
             "-L", f"127.0.0.1:{local}:127.0.0.1:{port}", target],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        started = time.time()
        while p.poll() is None and idle < idle_limit:
            time.sleep(15)
            r = subprocess.run(["ss", "-Htn", "state", "established",
                                f"( sport = :{local} )"], capture_output=True, text=True)
            idle = 0 if r.stdout.strip() else idle + 15
        if p.poll() is None:
            p.terminate()
            p.wait(5)
            break
        if time.time() - started > 60:
            backoff = 2
        log(f"tunnel {target}:{port} dropped; retry in {backoff}s")
        time.sleep(backoff)
        idle += backoff
        backoff = min(backoff * 2, 30)
    return 0


def remote_command(r, me):
    """The command a TUI remote runs, before the reconnect wrapper."""
    target = r.get("ssh") or r["machine"]
    local = r["machine"] == me
    if r["kind"] == "herdr":
        sess = r.get("session") or "default"
        if local:
            return ["herdr"] + ([] if sess == "default" else ["--session", sess])
        return ["herdr", "--remote", target, "--session", sess]
    # A login shell on both ends: npm, pipx and ~/.local/bin tools are often
    # only on a login PATH, and an agent's TUI is usually one of them.
    import shlex
    cmd = r.get("command") or 'exec "$SHELL" -l'
    if local:
        return [os.environ.get("SHELL") or "/bin/bash", "-lc", cmd]
    return ["ssh", "-t", target, f'exec "${{SHELL:-/bin/sh}}" -lc {shlex.quote(cmd)}']


def open_remote(slug, r):
    """Open one remote here: a TUI in a terminal under the reconnect wrapper,
    a gateway as a web app of the ego. Returns 0, or 1 after a notification."""
    me, peers = tailnet()
    egos = profiles()
    if slug not in egos:
        notify(f"{r['name']}: set up the ego {slug} on this device first")
        return 1
    machine, target = r["machine"], r.get("ssh") or r["machine"]
    online = machine == me or peers.get(machine, {}).get("online", True)
    if r["kind"] in ("herdr", "tui"):
        wrapper = Path(os.environ.get("OMAEGO_BIN", sys.argv[0])).resolve().parent / "omaego-remote"
        wrapper = str(wrapper) if wrapper.exists() else (shutil.which("omaego-remote") or "omaego-remote")
        inner = [wrapper, "--label", f"{r['name']} @{machine}"]
        if machine != me:
            inner += ["--machine", target]
        inner += ["--", *remote_command(r, me)]
        app_id = f"{REMOTE_CLASS}{slug}.{remote_id(r)}"
        if shutil.which("omarchy-launch-tui"):
            cmd = ["omarchy-launch-tui", f"--app-id={app_id}", *inner]
        else:
            cmd = ["xdg-terminal-exec", f"--app-id={app_id}", "-e", *inner]
        subprocess.Popen(cmd, start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if not online:
            notify(f"{machine} is offline - {r['name']} connects when it is back")
        return 0
    # A gateway.
    path = r.get("path") or "/"
    if r.get("url"):
        url = r["url"]
    elif machine == me:
        url = f"http://127.0.0.1:{r['port']}{path}"
    else:
        if not online:
            notify(f"{machine} is offline, so {r['name']} cannot open")
            return 1
        url = serve_url_for(machine, int(r["port"]), target)
        if url:
            url = url.rstrip("/") + path
        else:
            local = tunnel_port(machine, int(r["port"]))
            if not ensure_tunnel(target, int(r["port"]), local):
                notify(f"{r['name']}: no tunnel to {machine}:{r['port']} (ssh {target} works?)")
                return 1
            url = f"http://127.0.0.1:{local}{path}"
    webapp = Path(os.environ.get("OMAEGO_BIN", sys.argv[0])).resolve().parent / "omaego-webapp"
    webapp = str(webapp) if webapp.exists() else (shutil.which("omaego-webapp") or "omaego-webapp")
    log(f"remote {slug}/{remote_id(r)}: {url}")
    subprocess.Popen([webapp, f"--ego={slug}", f"--app={url}"], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


# Where a remote's icon comes from: the tool's or gateway's own site. Any
# other TUI gets the terminal's icon. Each is badged with its ego, as web apps
# are, so "herdr agents" for two egos tells itself apart in the launcher.
REMOTE_ICON_SITES = {"herdr": "https://herdr.dev",
                     "web:18789": "https://openclaw.ai",
                     "web:9119": "https://hermes-agent.nousresearch.com"}


def terminal_icon(dest):
    """The default terminal's own icon, as a PNG at dest."""
    lst = Path.home() / ".config/xdg-terminals.list"
    ids = [l.strip() for l in (lst.read_text().splitlines() if lst.exists() else [])
           if l.strip() and not l.startswith("#")]
    for did in ids + ["com.mitchellh.ghostty.desktop", "Alacritty.desktop", "kitty.desktop"]:
        for d in (DESKTOP_DIR, Path("/usr/share/applications")):
            f = d / did
            m = re.search(r"^Icon=(.+)$", f.read_text(), re.M) if f.exists() else None
            if not m:
                continue
            name = m.group(1).strip()
            for size in ("256x256", "512x512", "128x128", "scalable"):
                for ext in ("png", "svg"):
                    src = Path("/usr/share/icons/hicolor") / size / "apps" / f"{name}.{ext}"
                    if src.exists() and obtain_icon(str(src), dest):
                        return True
    return False


def remote_base_icon(r, me):
    """The unbadged icon for a remote, fetched once and cached. Or None."""
    word = (r.get("command") or "").split()[:1]
    agent = next((f"web:{p}" for p, c in AGENT_TUIS.items() if word == c.split()[:1]), None)
    key = "herdr" if r["kind"] == "herdr" or word == ["herdr"] else \
          (agent or "tui") if r["kind"] == "tui" else f"web:{r.get('port')}"
    dest = CACHE / "remote-icons" / f"{key.replace(':', '-')}.png"
    if r.get("icon"):
        dest = CACHE / "remote-icons" / f"custom-{slugify(r['icon'])[:40]}.png"
        return dest if dest.exists() or obtain_icon(r["icon"], dest) else None
    if dest.exists():
        return dest
    dest.parent.mkdir(parents=True, exist_ok=True)
    if key == "tui":
        ok = terminal_icon(dest)
    elif key in REMOTE_ICON_SITES:
        ok = site_icon(REMOTE_ICON_SITES[key], dest)
    elif r["kind"] == "web" and r["machine"] == me and r.get("port"):
        ok = site_icon(f"http://127.0.0.1:{r['port']}/", dest)
    else:
        ok = False
    if ok:
        round_tile(dest)
    return dest if ok else None


def round_tile(path):
    """Round the corners of an icon that is an opaque square (herdr's is): a
    hard-edged tile looks broken next to the launcher's other icons."""
    corner = subprocess.run(["magick", str(path), "-format", "%[fx:p{0,0}.a]", "info:"],
                            capture_output=True, text=True).stdout.strip()
    if corner not in ("1", "1.0"):
        return
    subprocess.run(["magick", str(path), "-alpha", "set",
                    "(", "+clone", "-alpha", "transparent", "-fill", "white",
                    "-draw", "roundrectangle 0,0 %[fx:w-1],%[fx:h-1] 44,44", ")",
                    "-compose", "DstIn", "-composite", f"PNG32:{path}"], capture_output=True)


def remote_icon_slug(slug, r):
    return f"{REMOTE_PREFIX}{slug}-{remote_id(r)}"


def write_remote_entries():
    """A launcher entry per remote of every ego set up here; stale ones go.

    Named like a web app - "herdr agents Work", app first, ego last. The
    machine is in the comment and the keywords, so typing it still finds the
    entry, and on the egocard as its tag."""
    me_bin = os.environ.get("OMAEGO_BIN", str(Path.home() / ".local/bin/omaego"))
    me = tailnet()[0] if declared_remotes() else None
    egos = profiles()
    want = {}
    for slug, r in declared_remotes():
        if slug not in egos:
            continue
        name = APP_NAME_TEMPLATE.format(app=r["name"], ego=egos[slug]["name"])
        what = {"herdr": f"herdr session {r.get('session') or 'default'}",
                "tui": r.get("command") or "shell",
                "web": f"gateway on port {r.get('port')}"}[r["kind"]]
        icon_slug = remote_icon_slug(slug, r)
        base = remote_base_icon(r, me)
        badged = ICON_DIR / f"{icon_slug}.png"
        orig = ICON_DIR / f"{icon_slug}.orig.png"
        if base:
            ICON_DIR.mkdir(parents=True, exist_ok=True)
            import filecmp
            if not orig.exists() or not filecmp.cmp(base, orig, shallow=False) \
                    or not badged.exists():
                shutil.copy(base, orig)
                apply_badge(icon_slug, egos[slug])
            icon = icon_slug
        else:
            icon = "web-browser" if r["kind"] == "web" else "utilities-terminal"
        want[f"{icon_slug}.desktop"] = (icon_slug, egos[slug], f"""[Desktop Entry]
Type=Application
Name={name}
Comment={what} on {r['machine']}, as {egos[slug]['name']}
Keywords={r['machine']};{r['kind']};{egos[slug]['name']};
Exec={me_bin} remote open {slug} {remote_id(r)}
Icon={icon}
Terminal=false
Categories=Network;
X-Omaego-Remote={slug}/{remote_id(r)}
""")
    DESKTOP_DIR.mkdir(parents=True, exist_ok=True)
    for f in DESKTOP_DIR.glob(f"{REMOTE_PREFIX}*.desktop"):
        if f.name not in want:
            f.unlink()
            for ic in (ICON_DIR / f"{f.stem}.png", ICON_DIR / f"{f.stem}.orig.png"):
                ic.unlink(missing_ok=True)
    for fname, (icon_slug, ego, text) in want.items():
        f = DESKTOP_DIR / fname
        if not f.exists() or f.read_text() != text:
            f.write_text(text)
            # The name or ego changed: the badge may have too.
            if (ICON_DIR / f"{icon_slug}.orig.png").exists():
                apply_badge(icon_slug, ego)
    subprocess.run(["gtk-update-icon-cache", str(Path.home() / ".local/share/icons/hicolor")],
                   capture_output=True)


GITIGNORE = "# per device, never synced\nengine\n"


def ensure_gitignore():
    f = CONFIG_DIR / ".gitignore"
    have = f.read_text() if f.exists() else ""
    if not re.search(r"(?m)^/?engine$", have):
        f.write_text(have + ("" if not have or have.endswith("\n") else "\n") + GITIGNORE)


def git(*args, timeout=20):
    try:
        return subprocess.run(["git", "-C", str(CONFIG_DIR), *args],
                              capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(args, 124, "", "timed out")


def sync_status(fetch=False):
    """Where the repo stands against this machine and its remote. Read-only;
    `behind` is as of the last fetch unless fetch is set."""
    if not (CONFIG_DIR / ".git").exists():
        return {"state": "norepo", "local": 0, "ahead": 0, "behind": 0}
    remote = (git("remote").stdout.split() or [None])[0]
    if fetch and remote:
        git("fetch", "--quiet", remote, timeout=30)
    pending = set(export_repo(write=False))
    pending |= {l[3:].strip('"') for l in git("status", "--porcelain").stdout.splitlines() if l.strip()}
    ahead = behind = 0
    upstream = git("rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
    if upstream.returncode == 0:
        counts = git("rev-list", "--left-right", "--count", "HEAD...@{u}").stdout.split()
        if len(counts) == 2:
            ahead, behind = int(counts[0]), int(counts[1])
    local = bool(pending) or ahead > 0
    state = ("diverged" if local and behind else "local" if local
             else "behind" if behind
             else "unpublished" if remote and upstream.returncode != 0 else "clean")
    return {"state": state, "local": len(pending), "ahead": ahead, "behind": behind,
            "remote": remote, "upstream": upstream.stdout.strip() or None,
            "changes": sorted(pending)}


FETCH_EVERY = 300   # seconds between background fetches


def fetch_in_background():
    """Fetch the egos repo now and then, without waiting for it, so the bar can
    show changes made on another device. Never prompts: a remote that needs a
    password just stays unfetched until you sync by hand."""
    if not (CONFIG_DIR / ".git").exists():
        return
    stamp = CACHE / "last-fetch"
    try:
        if time.time() - stamp.stat().st_mtime < FETCH_EVERY:
            return
    except OSError:
        pass
    remote = (git("remote").stdout.split() or [None])[0]
    if not remote:
        return
    stamp.parent.mkdir(parents=True, exist_ok=True)
    stamp.touch()
    env = {**os.environ, "GIT_TERMINAL_PROMPT": "0",
           "GIT_SSH_COMMAND": "ssh -o BatchMode=yes -o ConnectTimeout=10"}
    subprocess.Popen(["git", "-C", str(CONFIG_DIR), "fetch", "--quiet", remote],
                     env=env, start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


HISTORY_DAYS = 90
# Hosts shared by many orgs: a rule there names the org, so history is
# counted per first path segment (github.com/acme). Only for suggesting rules;
# a click on such a link is not asked about.
ORG_PATH_HOSTS = {"github.com", "gitlab.com", "bitbucket.org", "dev.azure.com",
                  "huggingface.co", "hub.docker.com"}
_NOT_ORGS = {"", "login", "logout", "settings", "account", "dashboard", "explore",
             "notifications", "search", "new", "orgs", "organizations", "users",
             "pulls", "issues", "marketplace", "features", "pricing", "about",
             "site", "sessions", "signup", "-", "_"}
# Never a rule: sign-in pages every ego passes through, and local addresses.
_NO_RULE_HOSTS = {"accounts.google.com", "login.microsoftonline.com", "login.live.com",
                  "login.microsoft.com", "myaccount.google.com", "localhost"}


def shareable_segment(seg):
    """A first path segment that reads like a name (an org, a workspace), safe
    to show an agent. Anything that could be an ID or a token is not: UUIDs,
    long hex or base64-ish runs, digits only, or long mixes of letters and
    digits. Recurring across several URLs is checked by the caller."""
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._~-]{0,39}", seg):
        return False
    if seg.isdigit() or re.fullmatch(r"[0-9a-fA-F-]{16,}", seg):
        return False
    letters, digits = sum(c.isalpha() for c in seg), sum(c.isdigit() for c in seg)
    if digits and letters and len(seg) > 12 and digits >= 3:
        return False                  # abc123def456ghi: likely generated
    if len(seg) >= 16 and not re.search(r"[-_.~]", seg) \
            and re.search(r"[a-z]", seg) and re.search(r"[A-Z]", seg):
        return False                  # eyJhbGciOiJIUzI1NiJ9: base64-ish
    return True


def rule_worthy(host):
    if host in _NO_RULE_HOSTS or host.endswith((".ts.net", ".local", ".localhost")) \
            or re.match(r"accounts\.google\.[a-z.]+$", host):
        return False
    return not re.fullmatch(r"[\d.]+|\[?[0-9a-f:]+\]?", host)


def history_hosts(days=HISTORY_DAYS):
    """{key: {ego slug: visits}} from every ego's browser history, the last
    `days` days. A key is a host, or host/first-segment where the host is
    shared by accounts (github.com/<org>, a SharePoint tenant): the shape a
    rule takes. Only these counts leave this function - no full URLs, titles
    or query strings, so handing them to an agent says which sites each ego
    uses, not what was read there."""
    import sqlite3
    # Chrome's clock: microseconds since 1601.
    cutoff = int((time.time() + 11644473600 - days * 86400) * 1_000_000)
    out, segs = {}, {}
    for slug, ego in profiles().items():
        hist = ego["data_dir"] / ego.get("profile_dir", "Default") / "History"
        if not hist.exists():
            continue
        try:
            # immutable: read while the browser holds its lock, never write.
            db = sqlite3.connect(f"file:{hist}?immutable=1", uri=True, timeout=2)
            rows = db.execute("SELECT url, visit_count FROM urls WHERE last_visit_time > ?",
                              (cutoff,)).fetchall()
            db.close()
        except sqlite3.Error as e:
            log(f"history {slug}: {e}")
            continue
        for url, visits in rows:
            u = urlsplit(url)
            if u.scheme not in ("http", "https") or not u.hostname:
                continue
            host = u.hostname.lower().removeprefix("www.")
            if not rule_worthy(host):
                continue
            scope = account_scope(url)
            seg = (u.path or "").strip("/").split("/")[0]
            if scope:
                key = scope[0]
            elif host in ORG_PATH_HOSTS:
                if seg.lower() in _NOT_ORGS or seg.startswith(("_", ".")):
                    continue
                key = f"{host}/{seg}"
            else:
                key = host
                if shareable_segment(seg):
                    sg = segs.setdefault(host, {}).setdefault(seg, {"by": {}, "urls": 0})
                    sg["by"][slug] = sg["by"].get(slug, 0) + max(1, visits or 0)
                    sg["urls"] += 1           # distinct URLs: urls holds each once
            out.setdefault(key, {}).setdefault(slug, 0)
            out[key][slug] += max(1, visits or 0)
    # Where a host alone cannot say which ego - several visit it - add its
    # first path segments, but only ones seen in 3+ different URLs: an org or
    # workspace recurs on every page under it, a token in a link does not.
    # And only where it helps: the host really is split (no ego has 90% of
    # it), and the segment mostly belongs to one ego (80%) - the only kind
    # that can become a rule. Which profiles you read on x.com stays out.
    share = lambda by: max(by.values()) / sum(by.values())
    for host, by_seg in segs.items():
        if len(out.get(host, {})) < 2 or share(out[host]) >= 0.9:
            continue
        common = sorted(((k, v) for k, v in by_seg.items()
                         if v["urls"] >= 3 and share(v["by"]) >= 0.8),
                        key=lambda kv: -sum(kv[1]["by"].values()))[:5]
        for seg, v in common:
            out[f"{host}/{seg}"] = v["by"]
    return out


def learn_prompt(observed, limit=150):
    """The agent's brief for suggesting rules: how rules work, the rules you
    have, where links went, and which ego visits which hosts."""
    egos = profiles()
    name = lambda k: egos[k]["name"] if k in egos else k
    hist = history_hosts()
    rows = []
    # A host, then the path segments that split it (when it has any).
    order = sorted((k for k in hist if "/" not in k or k.split("/")[0] not in hist),
                   key=lambda k: -sum(hist[k].values()))
    keys = []
    for k in order:
        keys.append(k)
        keys += sorted((x for x in hist if x.startswith(k + "/") and k in hist and "/" not in k),
                       key=lambda x: -sum(hist[x].values()))
    for key, by in ((k, hist[k]) for k in keys):
        if match_rule(f"https://{key}/x", None):
            continue                      # a rule already covers it
        total = sum(by.values())
        split = ", ".join(f"{name(k)} {n}" for k, n in sorted(by.items(), key=lambda kv: -kv[1]))
        rows.append(f"{'  ' if '/' in key and key.split('/')[0] in hist else ''}{key}  ({total}: {split})")
        if len(rows) >= limit:
            break
    current = "\n".join(f"{r.get('url') or r.get('match')} -> {r.get('profile') or '(app/rewrite)'}"
                        for r in load_rules())
    return (
        "Help me grow the routing rules of omaego, which keeps my browser identities "
        "(egos) apart: each ego is its own browser profile. A rule says a URL pattern "
        "always opens in one ego, wherever I click it. Links without a rule open in "
        "the ego of the workspace I am on, so rules are only for things that belong "
        "to ONE context: a customer's tenant (acme.sharepoint.com, acme.atlassian.net), "
        "a company's own tools, an org on a shared host (github.com/acme/*). Never "
        "general sites everyone uses (google.com, github.com as a whole, news, docs).\n\n"
        f"My egos: {', '.join(e['name'] for e in egos.values())}.\n\n"
        "Existing rules:\n" + (current or "(none)") + "\n\n"
        "Where links I clicked outside the browser went (from omaego's own log):\n"
        + ("\n".join(observed) or "(nothing logged yet)") + "\n\n"
        f"Hosts each ego visited in the last {HISTORY_DAYS} days, from the browsers' "
        "history - visit counts only, no full URLs - not covered by a rule yet. "
        "Indented under a host used by several egos: its first path segments "
        "(only name-like ones that recur), for rules like https://host/<segment>/*:\n"
        + ("\n".join(rows) or "(no history found)") + "\n\n"
        "1. Suggest rules: hosts (or host/org paths) visited mostly or only in one "
        "ego that clearly belong to that context. Group them by ego, give the "
        "evidence in a few words, and list the ambiguous ones separately.\n"
        "2. Ask me which to add. Only then run, for each one I approve:\n"
        "   omaego rule add '<url glob>' '<Ego name>'\n"
        "   e.g. omaego rule add 'https://acme.atlassian.net/*' 'Acme'\n"
        "3. Run `omaego rule list` at the end so I see the result.\n"
        "If a host needs a closer look, ask me before reading more of a browser's "
        "history; each ego's is the SQLite file History in its profile under "
        f"{EGO_ROOT}.")


def agent_find_icon(slug, name, app_url):
    """Hand the icon hunt to the default omarchy agent.

    The agent cannot pass a URL back into this process, so it is given the
    command that applies the result instead and runs it itself.
    """
    prompt = (
        f"Find the official icon for the web app \"{name}\" at {app_url} and "
        f"install it.\n\n"
        f"Prefer the site's own apple-touch-icon or a vendor press/brand asset; "
        f"a square PNG at 256px or larger, with transparency if available. "
        f"Avoid favicon services, which cap at 64px and look soft on the bar.\n\n"
        f"Then apply it with exactly:\n"
        f"    omaego app icon {slug} \"{name}\" <image-url-or-path>\n\n"
        f"That command downloads, normalises and rewrites the .desktop entry, so "
        f"nothing else needs editing. Verify afterwards with:\n"
        f"    omaego app installed | grep -i \"{name}\"")
    return run_agent(prompt)


def run_agent(prompt, cwd=None):
    """Hand a prompt to the default omarchy agent, in its own terminal."""
    # omarchy only prints a hint when no default agent is configured, and a
    # Popen succeeds either way - so check before claiming the handoff worked.
    if not (Path.home() / ".config/omarchy/defaults/agent").exists():
        notify("no default agent set — run: omarchy default agent <name>")
        print("no default agent configured; run: omarchy default agent <name>",
              file=sys.stderr)
        return False
    try:
        subprocess.Popen(["omarchy", "agent", "prompt", prompt],
                         start_new_session=True, cwd=cwd)
        return True
    except Exception:
        return False


def app_add(slug, keys, name_tpl=None, url=None, display=None, want_rule=False,
            interactive=False, icon=None, agent_icon=False):
    # Resolve the ego FIRST: naming a web app needs it, both to exclude the
    # ego's own name from the candidates and to build the launcher name.
    egos = profiles()
    if slug not in egos:
        print(f"unknown ego {slug!r} (see: omaego list)", file=sys.stderr)
        return 1
    ego = egos[slug]

    # One of url/name is enough; ask for whatever is missing.
    if url and not display:
        u = normalize_url(url)
        cands = name_candidates(u, ego["name"])
        # Suggestions are rows you can pick; nothing is accepted on your behalf.
        # A name that matches no row is taken as typed. One that partly matches
        # a suggestion would pick that suggestion instead, so typing another
        # name is also a row of its own, which opens a plain input box.
        choice = pick([(c, c) for c in cands] + [("Type another name…", "__type__")],
                      f"Name this app ({urlsplit(u).hostname})",
                      free=True, single=False)
        if choice is None:
            return 1
        if isinstance(choice, tuple):
            display = choice[1]
        elif choice == "__type__":
            display = (prompt_text(f"Name for {urlsplit(u).hostname}") or "").strip()
            if not display:
                notify("cancelled: a name is needed")
                return 1
        else:
            display = choice
    elif display and not url:
        url = prompt_text(f"URL for {display}")
        if not url:
            return 1
    url = normalize_url(url) if url else None

    bin_webapp = os.environ.get("OMAEGO_WEBAPP",
                                str(Path.home() / ".local/bin/omaego-webapp"))
    tpl = name_tpl or APP_NAME_TEMPLATE
    ICON_DIR.mkdir(parents=True, exist_ok=True)

    items = []
    if url:
        items.append((display or urlsplit(url).hostname or "App", url, None, icon))
    for k in keys:
        if k not in WEBAPPS:
            print(f"unknown app {k!r} (see: omaego app list)", file=sys.stderr)
            return 1
        items.append(WEBAPPS[k])

    have = installed_apps().get(slug, [])
    for app_name, app_url, domain, icon_url in items:
        name = tpl.format(app=app_name, ego=ego["name"])
        clash = next((a for a in have
                      if a["url"] == app_url or a["name"] == name), None)
        if clash:
            msg = f"{clash['name']} is already in {ego['name']}"
            print(f"  {msg}")
            notify(msg + " — remove it first to re-add")
            continue
        icon_slug = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")
        icon_arg = ""
        if icon_url:
            dest = ICON_DIR / f"{icon_slug}.png"
            if obtain_icon(icon_url, dest):
                icon_arg = icon_slug          # a bare name is used as-is
        exec_line = f"{bin_webapp} --ego={slug} --app={app_url}"
        def run_install(icon):
            return subprocess.run(["omarchy", "webapp", "install", name, app_url,
                                   icon, exec_line], capture_output=True, text=True)

        r = run_install(icon_arg)
        if r.returncode != 0 and not icon_arg:
            # omarchy aborts the whole install when it cannot fetch an icon, and
            # plenty of internal hosts serve none. Ask for one before falling
            # back to a generic picture.
            host = urlsplit(app_url).hostname
            # Only ask where someone is there to answer. A scripted `app add`
            # would otherwise sit on this prompt until the menu times out.
            given = None
            if interactive:
                choice = pick([("Paste an image URL…", "url"),
                               ("Let the agent find one", "agent"),
                               ("Use a generic icon", "generic")],
                              f"No icon found at {host}")
                if choice == "url":
                    given = prompt_text(f"Image URL for {name}")
                elif choice == "agent":
                    r = run_install(ego_engine(PROFILE_ROOT / slug)["icon"])
                    if r.returncode == 0 and agent_find_icon(slug, name, app_url):
                        print(f"  {name}: installed; the agent is finding an icon")
                        notify(f"added {name} — the agent is finding an icon")
                    continue
            if given:
                dest = ICON_DIR / f"{icon_slug}.png"
                if fetch_icon(given.strip(), dest) and normalize_icon(dest):
                    icon_arg = icon_slug
                    r = run_install(icon_arg)
                else:
                    notify(f"could not use that image; falling back")
                    r = run_install(ego_engine(PROFILE_ROOT / slug)["icon"])
            else:
                r = run_install(ego_engine(PROFILE_ROOT / slug)["icon"])
            if r.returncode == 0 and icon_arg != icon_slug:
                print(f"  {name}: installed with a generic icon "
                      f"(none reachable at {host}); set one later with:")
                print(f"      omaego app icon {slug} {name!r} <image-url>")
        if r.returncode != 0:
            msg = (r.stderr.strip() or r.stdout.strip() or "no output")[:140]
            print(f"  {name}: FAILED  {msg}", file=sys.stderr)
            # Launched from the bar panel there is no terminal to read, so a
            # failure that is only printed is a failure nobody sees.
            notify(f"could not add {name}: {msg[:90]}")
            continue
        if not icon_arg:                       # omarchy fetched it; fix it up
            normalize_icon(ICON_DIR / f"{icon_slug}.png")
        apply_badge(icon_slug, ego)
        print(f"  installed  {name}")
        if agent_icon and agent_find_icon(slug, name, app_url):
            notify(f"added {name} — the agent is finding an icon")
        else:
            notify(f"added {name} — find it in the launcher")

        if want_rule and domain:
            owner = app_rule_conflict(domain)
            if owner and owner.lower() != ego["name"].lower():
                print(f"      rule skipped: {domain} already routes to {owner!r}")
            elif owner:
                print(f"      rule exists:  {domain} -> {owner}")
            else:
                append_rule(domain, ego["name"])
                print(f"      rule added:   https://*{domain}/* -> {ego['name']}")
        elif want_rule and not domain:
            print("      no rule: several egos can share this host "
                  "(Teams, Outlook, Gmail, Meet), so routing it to one "
                  "would be wrong")
        elif domain:
            print(f"      --rule would add:  https://*{domain}/* -> {ego['name']}")
    return 0


# --- cli --------------------------------------------------------------------

USAGE = """omaego - keep work, private and customer contexts apart in one browser

An *ego* is one Chrome --user-data-dir: its own process, window class, cookie
jar and sync account. A workspace usually belongs to one ego. A link always
opens on the workspace you are on - never by switching desktops.

  omaego <url>           route a URL (this is what the desktop entry calls)
  omaego                 open a browser on this desktop
  omaego list            show egos, and which Chrome-internal profiles are not
                         routable on their own
  omaego add <name> [--browser=chrome|chromium|brave|edge] [--existing]
                         create an empty ego, in omarchy's default browser
                         unless another is named. --existing makes the ego out
                         of the profile that browser already has, in place
  omaego new             same, asking the name (and the browser, if there is a
                         choice) in the menu, then open it to sign in
  omaego import <src> [name]
                         lift a Chrome-internal profile into its own ego
                         (needs Chrome fully quit)
  omaego learn [--agent] suggest rules from where links actually went; --agent
                         hands that and each ego's browsing (hosts and visit
                         counts, no full URLs) to the default agent, which
                         suggests rules and adds the ones you approve
                         (--print shows what it would get)
  omaego sync [--remote <git url>]
                         rewrite desktop entries, relink native messaging hosts;
                         and when ~/.config/omaego is a git repo, keep it (rules,
                         egos, web apps) in sync with your private remote: pull,
                         and hand commits and merges to the default agent
  omaego sync --status [--fetch] [--json]   drift between repo and machine
  omaego apply [--prune] make this machine match egos.toml
  omaego app open <ego> "<app>"   launch, installing a declared app first
  omaego move ego <slug> --before <slug> | --end
  omaego move app <ego> <url> --before <url> | --end
  omaego move remote <ego> <name> --before <name> | --end
                         reorder in egos.toml (what dragging on the panel does)
  omaego remote machines this machine and your tailnet's
  omaego remote add <ego> herdr <machine> [session]
  omaego remote add <ego> web <machine> <port> [--path /x] [--url <url>]
  omaego remote add <ego> tui <machine> --name <n> -- <command>
                         pin a herdr session, a gateway or any TUI on a machine
                         to an ego (--ssh user@host, --icon, --open)
  omaego remote list|open|remove <ego> <name>    pinned sessions and gateways
  omaego remote pick <ego>        choose from what your machines offer
  omaego rule list       the routing rules
  omaego rule add <url-glob> <ego> [--app]
  omaego app list        web apps you can pin to an ego
  omaego app add <ego> <app>...   install them (--rule also routes that host)
  omaego app add <ego> --url <url> | --name <name>
                         either one is enough; you are asked for the other
  omaego app remove <ego> [<app>...]  by name or key; with none, pick one
  omaego app edit <ego> "<app>" [--name <name>] [--icon <src>] [--agent-icon]
  omaego app icon <ego> "<app name>" <image url|path|--agent>
  omaego app rebadge [ego]        stamp ego badges on installed app icons
  omaego launch <slug> [url]
  omaego account [<ego>] the accounts each ego signs in with (optional): Google
                         ones are read from the browser, unless
                         OMAEGO_NO_ACCOUNTS=1
  omaego account add|remove <ego> <email>...
                         note one by hand (a Microsoft account, say), or drop it
  omaego engine          the browser each ego runs in. A new ego gets omarchy's
                         default browser; after `omarchy default browser <x>`,
                         run `omaego setup` to put omaego back in front of it
  omaego engine <ego> <browser> [empty]
                         move an ego to another browser, keeping its profile
                         (or starting empty). The old one is backed up first.
  omaego engine pick <ego>        the same, choosing browser and profile in the menu
  omaego default [slug]  show/set the FALLBACK ego: the one that owns the plain
                         browser entry and web apps. Not an "active" ego -
                         there is no such thing; the workspace is the unit.
  omaego close <ego>     close that ego's windows on this workspace
  omaego space [--json]  which ego owns the current workspace
  omaego here [--json]   browser and web-app windows on the current workspace
  omaego setup [--no-google-signin | --google-signin]
                         first-run wiring: handler, desktop entries, rules file,
                         and Google sign-in for Chromium (on unless turned off)
  omaego restructure     name each inner profile dir after its ego, so web-app
                         windows identify their ego (rarely needed)

Flags: --incognito / --private / --private-window / --inprivate
Rules: ~/.config/omaego/rules.toml
"""


# Read-only queries the bar widget polls several times a minute. Logging them
# would churn the routing history out of the log's size cap within the hour.
QUIET = {"space", "here", "list", "default", "engine", "panel", "highlight", "--help", "-h"}


def main(argv):
    if not (argv and argv[0] in QUIET):
        log(f"argv={argv}")

    # Callers probe browsers with --help (omarchy-launch-browser greps it to
    # detect Firefox); never treat a flag as a URL.
    # (Only before "--": what follows is a remote TUI's own command line.)
    if any(a in ("--help", "-h", "-help")
           for a in (argv[:argv.index("--")] if "--" in argv else argv)):
        print(USAGE)
        return 0

    want_json = "--json" in argv
    incognito = any(a in ("--incognito", "--private", "--private-window",
                          "--inprivate") for a in argv)
    browser_arg = next((a.split("=", 1)[1] for a in argv
                        if a.startswith("--browser=")), None)
    existing_arg = "--existing" in argv
    argv = [a for a in argv if not a.startswith("-")]

    if not argv:
        open_url(None, incognito=incognito)
        return 0
    cmd = argv[0]

    if cmd == "list":
        by_class = all_targets()
        if want_json:
            dflt = default_slug()
            print(json.dumps([
                {"slug": t["slug"], "name": t["name"], "class": t["wm_class"],
                 "managed": t["managed"], "default": t["slug"] == dflt,
                 "browser": t["engine"]["short"]}
                for t in sorted(by_class.values(),
                                key=lambda t: (not t["managed"], t["name"]))]))
            return 0
        declared = load_declared()
        for t in sorted(by_class.values(), key=lambda t: (not t["managed"], t["name"])):
            kind = "routable" if t["managed"] else "shared data dir"
            print(f"{t['name']:<24} {t['engine']['short']:<9} "
                  f"class={t['wm_class']:<22} {kind}")
            if t["managed"]:
                accts = merge_accounts(declared.get(t["slug"], {}).get("accounts"),
                                       browser_accounts(t))
                if accts:
                    print(f"    as {', '.join(accts)}")
            if not t["managed"] and t["data_dir"]:
                inner = internal_profiles(t["data_dir"])
                for sub, nm in inner:
                    print(f"    - {nm:<20} ({sub})  NOT routable on its own")
                if len(inner) > 1:
                    print(f"    ^ these share one data dir, so every window is "
                          f"class {t['wm_class']!r}.")
                    print(f"      Lift one out with:  omaego import "
                          f"{t['slug']} '<name>'")
        return 0

    if cmd == "import":
        by_class = all_targets()
        if len(argv) < 2:
            have = "|".join(c for c in by_class if c in UNMANAGED)
            print(f"usage: omaego import <{have or 'google-chrome|chromium'}> [ego name]",
                  file=sys.stderr)
            return 2
        src = by_class.get(argv[1])
        if src is None or not src["data_dir"]:
            print(f"unknown source {argv[1]!r}", file=sys.stderr)
            return 1
        inner = internal_profiles(src["data_dir"])
        if len(argv) < 3:
            print(f"egos inside {src['data_dir']}:")
            for sub, nm in inner:
                print(f"  {nm}   ({sub})")
            return 0
        want = " ".join(argv[2:])
        match = [(sub, nm) for sub, nm in inner
                 if nm.lower() == want.lower() or sub.lower() == want.lower()]
        if not match:
            print(f"no ego named {want!r}; try: omaego import {argv[1]}",
                  file=sys.stderr)
            return 1
        import_profile(src["data_dir"], match[0][0], match[0][1], src["engine"])
        return 0

    if cmd == "add":
        if len(argv) < 2:
            print("usage: omaego add <name> [--browser=<browser>] [--existing]",
                  file=sys.stderr)
            return 2
        eng = find_engine(browser_arg) if browser_arg else None
        if browser_arg and not (eng and shutil.which(eng["command"])):
            print(f"no such browser installed: {browser_arg!r} (have: "
                  f"{', '.join(e['short'].lower() for e in installed_engines())})",
                  file=sys.stderr)
            return 1
        name = " ".join(argv[1:])
        if slugify(name) in profiles():
            print(f"ego {slugify(name)!r} already exists", file=sys.stderr)
            return 1
        slug = add_profile(name, eng, existing_arg)
        # An ego adopted from the repo brings its pinned remotes: their
        # launcher entries come with it, not with the next sync.
        write_remote_entries()
        # The repo may say which account belongs in this ego.
        accts = load_declared().get(slug, {}).get("accounts") or []
        sign_in = f"sign in as {', '.join(accts)}" if accts else "sign in"
        if "--open" in sys.argv:
            # From the panel's "Set up here": open it, so signing in comes first.
            ego = profiles()[slug]
            launch(ego, new_window=True)
            notify(f"{ego['name']} is set up here, in {ego['engine']['short']} - {sign_in}")
            return 0
        if existing_arg:
            ego = profiles()[slug]
            print(f"{ego['name']} is now {ego['engine']['short']}'s own profile "
                  f"({ego['data_dir'].resolve()}), nothing copied.")
            print(f"Restart {ego['engine']['short']} once so its windows carry "
                  f"the ego's class.")
            if signin_blocked(ego):
                print(f"Its sign-in is switched off: turn on \"Allow "
                      f"{ego['engine']['short']} sign-in\" under Settings > You and "
                      f"Google > Sync and Google services.")
            if accts:
                print(f"The repo has it as {', '.join(accts)}.")
            return 0
        print(f"created ego {slug!r} ({name})\n")
        print("next:")
        print(f"  1. omaego launch {slug}")
        print("     sign in to Google/Microsoft in the window that opens; this ego")
        print("     syncs to that account and nothing else does")
        if accts:
            print(f"     (the repo has it as {', '.join(accts)})")
        print(f"  2. omaego app add {slug} teams outlook      # see: omaego app list")
        print(f"  3. omaego rule add 'https://*.example.com/*' {name}")
        print("     for hosts that must always open as this ego, wherever you are")
        return 0

    if cmd == "new":
        # Interactive add, for the bar panel: name it in the menu, then open it so
        # the first thing you do is sign in - an ego is only useful once synced.
        made = new_ego()
        if not made:
            return 0
        slug, existed = made
        ego = profiles()[slug]
        launch(ego, new_window=True)
        notify(f"{ego['name']}: already existed, opened it" if existed
               else f"created {ego['name']} in {ego['engine']['short']}")
        return 0

    if cmd == "launch":
        if len(argv) < 2:
            return 2
        by_class = all_targets()
        t = next((t for t in by_class.values() if t["slug"] == argv[1]), None)
        if t is None:
            print(f"unknown profile {argv[1]!r}", file=sys.stderr)
            return 1
        launch(t, argv[2] if len(argv) > 2 else None, new_window=True)
        return 0

    if cmd == "default":
        if len(argv) < 2:
            print(default_slug() or "(none)")
            return 0
        if argv[1] not in profiles():
            print(f"unknown profile {argv[1]!r}", file=sys.stderr)
            return 1
        DEFAULT_MARK.write_text(argv[1] + "\n")
        write_desktop_entries()
        print(f"default profile -> {argv[1]}")
        return 0

    if cmd == "account":
        # Optional: an ego works the same without any. They are what a device
        # setting the ego up is told to sign in with.
        here, declared = profiles(), load_declared()
        # Egos in the repo but not on this device count too: noting an account
        # does not need the ego set up.
        egos = {**{s: {"name": e["name"]} for s, e in declared.items()}, **here}

        def find(word):
            w = word.lower()
            return next((s for s, e in egos.items() if w in (s, e["name"].lower())), None)

        sub = argv[1] if len(argv) > 1 else None
        if sub in ("add", "remove"):
            if len(argv) < 4:
                print(f"usage: omaego account {sub} <ego> <email>...", file=sys.stderr)
                return 2
            slug, emails = find(argv[2]), argv[3:]
            if not slug:
                print(f"unknown ego {argv[2]!r} (see: omaego list)", file=sys.stderr)
                return 1
            bad = [e for e in emails if "@" not in e]
            if bad:
                print(f"not an address: {', '.join(bad)}", file=sys.stderr)
                return 2
            now = set_accounts(slug, **({"add": emails} if sub == "add" else {"remove": emails}))
            print(f"{egos[slug]['name']}: {', '.join(now) or 'no accounts'}")
            signed_in = {a.lower() for a in browser_accounts(here[slug])} if slug in here else set()
            back = [e for e in emails if sub == "remove" and e.lower() in signed_in]
            if back:
                print(f"  {', '.join(back)} is still signed in to the browser, so the "
                      f"next sync notes it again (OMAEGO_NO_ACCOUNTS=1 stops that)")
            return 0
        if sub and not find(sub):
            print(f"unknown ego {sub!r} (see: omaego list)", file=sys.stderr)
            return 1
        order = ego_sort_key()
        shown = [find(sub)] if sub else sorted(egos, key=lambda s: order((s, egos[s]["name"])))
        rows = {s: {"declared": declared.get(s, {}).get("accounts") or [],
                    "browser": browser_accounts(here[s]) if s in here else []} for s in shown}
        if want_json:
            print(json.dumps({s: merge_accounts(r["declared"], r["browser"])
                              for s, r in rows.items()}))
            return 0
        for s, r in rows.items():
            new = [a for a in r["browser"]
                   if a.lower() not in {d.lower() for d in r["declared"]}]
            accts = r["declared"] + [f"{a} (signed in, not synced yet)" for a in new]
            print(f"{egos[s]['name']:<24} {', '.join(accts) or '-'}")
        return 0

    if cmd == "restructure":
        # Rename each data dir's inner profile from "Default" to the profile's
        # own name, so web-app windows come out as chrome-<app>__-<Name> and can
        # be attributed to a profile (and no longer collide between profiles).
        if chrome_running():
            print("Quit Chrome completely first - renaming a profile directory "
                  "under a running instance corrupts it.", file=sys.stderr)
            return 1
        changed = 0
        for slug, prof in profiles().items():
            if prof["profile_dir"] != "Default":
                print(f"  {slug}: already {prof['profile_dir']}")
                continue
            inner = re.sub(r"[^A-Za-z0-9]", "", prof["name"]) or slug.title()
            src, dst = prof["data_dir"] / "Default", prof["data_dir"] / inner
            if not src.is_dir():
                print(f"  {slug}: no Default dir, skipped", file=sys.stderr)
                continue
            if dst.exists():
                print(f"  {slug}: {inner} already exists, skipped", file=sys.stderr)
                continue
            src.rename(dst)                      # same filesystem: instant
            (prof["data_dir"] / ".profile-dir").write_text(inner + "\n")
            print(f"  {slug}: Default -> {inner}")
            changed += 1
        if changed:
            write_desktop_entries()
        print(f"{changed} profile(s) restructured")
        return 0

    if cmd == "rule":
        sub = argv[1] if len(argv) > 1 else "list"
        if sub == "list":
            rules = load_rules()
            if want_json:
                print(json.dumps([
                    {"pattern": r.get("url") or r.get("match") or "",
                     "profile": r.get("profile"), "app": bool(r.get("app")),
                     "rewrite": bool(r.get("rewrite")), "source": r.get("source")}
                    for r in rules]))
                return 0
            if not rules:
                print(f"no rules in {RULES}")
                return 0
            for r in rules:
                pat = r.get("url") or r.get("match") or "(source only)"
                bits = [f"-> {r['profile']}"] if r.get("profile") else ["-> workspace/picker"]
                if r.get("app"): bits.append("as app window")
                if r.get("rewrite"): bits.append("rewritten")
                if r.get("source"): bits.append(f"from {r['source']}")
                print(f"  {pat:<48} {'  '.join(bits)}")
            return 0
        if sub == "add":
            if len(argv) < 4:
                print("usage: omaego rule add <url-glob> <ego> [--app]", file=sys.stderr)
                return 2
            pat, want = argv[2], argv[3]
            egos = profiles()
            ego = egos.get(want) or next(
                (e for e in egos.values() if e["name"].lower() == want.lower()), None)
            if ego is None:
                print(f"unknown ego {want!r} (see: omaego list)", file=sys.stderr)
                return 1
            for r in load_rules():
                if (r.get("url") or r.get("match")) == pat:
                    print(f"rule for {pat} already exists -> {r.get('profile')}",
                          file=sys.stderr)
                    return 1
            RULES.parent.mkdir(parents=True, exist_ok=True)
            with RULES.open("a") as f:
                f.write(f'\n[[rule]]\nurl = "{pat}"\nprofile = "{ego["name"]}"\n')
                if "--app" in sys.argv[1:]:
                    f.write("app = true\n")
            print(f"added: {pat} -> {ego['name']}")
            return 0
        if sub == "new":
            # Interactive add, for the bar panel. An ego slug skips the picker -
            # the panel asks from inside that ego's column.
            egos = profiles()
            ego = egos.get(argv[2]) if len(argv) > 2 else None
            hint = f" for {ego['name']}" if ego else ""
            pat = prompt_text(f"URL pattern{hint}, e.g. https://acme.example.com/*")
            if not pat:
                return 0
            if ego is None:
                ego = pick([(e["name"], e) for e in egos.values()],
                           f"Open {pat} in…")
            if ego is None:
                return 0
            for r in load_rules():
                if (r.get("url") or r.get("match")) == pat:
                    notify(f"a rule for {pat} already exists")
                    return 1
            RULES.parent.mkdir(parents=True, exist_ok=True)
            with RULES.open("a") as f:
                f.write(f'\n[[rule]]\nurl = "{pat}"\nprofile = "{ego["name"]}"\n')
            notify(f"{pat} -> {ego['name']}")
            return 0

        if sub == "rm":
            if len(argv) < 3:
                print("usage: omaego rule rm <url-glob>", file=sys.stderr)
                return 2
            if remove_rule(argv[2]):
                print(f"removed rule {argv[2]}")
                return 0
            print(f"no rule matching {argv[2]!r}", file=sys.stderr)
            return 1

        print(f"unknown: omaego rule {sub}", file=sys.stderr)
        return 2

    if cmd == "app":
        sub = argv[1] if len(argv) > 1 else "list"
        if sub == "list":
            print("web apps you can pin to an ego "
                  f"(name template {APP_NAME_TEMPLATE!r}):\n")
            for k, (nm, url, dom, _ic) in sorted(WEBAPPS.items()):
                tail = f"  [rule: {dom}]" if dom else ""
                print(f"  {k:<10} {nm:<10} {url}{tail}")
            print("\n  omaego app add <ego> <app>...            install them\n  omaego app add <ego> <app> --rule        also route that host to the ego")
            print("  omaego app add <ego> --url <url> --name <name> "
                  "[--icon <image url|path>] [--agent-icon]")
            print("  omaego app remove <ego> [<app>...]        by name or key; none: pick one")
            print('  omaego app edit <ego> "<app>" [--name <name>] [--icon <src>] [--agent-icon]')
            print('  omaego app icon <ego> "<app name>" <image url|path|--agent>')
            print("  omaego app rebadge [ego]        stamp ego badges on icons")
            print('  omaego app rename <ego> "<old>" "<new>"')
            print("  omaego app fixnames [ego]       append the ego to names missing it")
            print("\n[rule] marks a host one ego can plausibly own outright; "
                  "--rule writes it.\nHosts without it are shared between egos "
                  "(Teams, Outlook, Gmail, Meet) — a rule\nthere would send a "
                  "customer's link to the wrong identity.")
            return 0

        if sub in ("rename", "fixnames"):
            egos = profiles()
            do_rename = lambda slug, app, new_name: rename_app(app, new_name)

            if sub == "rename":
                if len(argv) < 5:
                    print("usage: omaego app rename <ego> \"<old>\" \"<new>\"",
                          file=sys.stderr)
                    return 2
                slug, old, new = argv[2], argv[3], " ".join(argv[4:])
                app = next((a for a in installed_apps().get(slug, [])
                            if a["name"].lower() == old.lower()), None)
                if app is None:
                    print(f"no app {old!r} in {slug}", file=sys.stderr)
                    return 1
                do_rename(slug, app, new)
            else:
                # Every launcher should carry its ego, including the fallback
                # one: "Chrome Remote Desktop" says nothing about whose it is.
                which = argv[2] if len(argv) > 2 else None
                n = 0
                for slug, apps in sorted(installed_apps().items()):
                    if (which and slug != which) or slug not in egos:
                        continue
                    ego_name = egos[slug]["name"]
                    for a in apps:
                        if re.search(rf"\b{re.escape(ego_name)}\b", a["name"], re.I):
                            continue
                        do_rename(slug, a, f"{a['name']} {ego_name}")
                        n += 1
                print(f"{n} renamed")
            subprocess.run(["update-desktop-database", str(DESKTOP_DIR)],
                           capture_output=True)
            subprocess.run(["gtk-update-icon-cache",
                            str(Path.home() / ".local/share/icons/hicolor")],
                           capture_output=True)
            return 0

        if sub == "icon":
            # Set or replace an installed web app's icon, for the common case of
            # a host that serves none and got the generic one.
            if len(argv) < 4:
                print("usage: omaego app icon <ego> <app name> <image url|path>",
                      file=sys.stderr)
                return 2
            slug, want = argv[2], argv[3]
            src = argv[4] if len(argv) > 4 else None
            app = next((a for a in installed_apps().get(slug, [])
                        if a["name"].lower() == want.lower()), None)
            if app is None:
                print(f"no app {want!r} in {slug}; see: omaego app installed",
                      file=sys.stderr)
                return 1
            if src == "--agent" or (not src and not sys.stdin.isatty()):
                if agent_find_icon(slug, app["name"], app["url"]):
                    print(f"  handed {app['name']} to the default agent")
                    return 0
                print("could not launch the agent", file=sys.stderr)
                return 1
            if not src:
                src = prompt_text(f"Image URL for {app['name']} "
                                  f"(or type agent to let the agent find one)")
                if not src:
                    return 0
                if src.strip().lower() == "agent":
                    return 0 if agent_find_icon(slug, app["name"], app["url"]) else 1
            if not set_app_icon(slug, app, src):
                return 1
            notify(f"{app['name']}: icon updated")
            return 0

        if sub == "rebadge":
            which = argv[2] if len(argv) > 2 else None
            egos = profiles()
            n = 0
            for slug, apps in sorted(installed_apps().items()):
                if (which and slug != which) or slug not in egos:
                    continue
                for a in apps:
                    icon = a["icon"]
                    if not icon or "/" in icon:
                        continue
                    if apply_badge(icon, egos[slug]):
                        print(f"  {a['name']}"); n += 1
            subprocess.run(["gtk-update-icon-cache",
                            str(Path.home() / ".local/share/icons/hicolor")],
                           capture_output=True)
            print(f"{n} icon(s) badged")
            return 0

        if sub == "installed":
            inst = installed_apps()
            if want_json:
                print(json.dumps(inst))
            else:
                for slug, apps in sorted(inst.items()):
                    print(f"{slug}:")
                    for a in apps:
                        print(f"    {a['name']:<28} {a['url']}")
            return 0

        if sub == "catalog":
            # `catalog [ego]` lists; `catalog --fetch` fills the icon cache.
            if "--fetch" in sys.argv:
                print(f"{catalog_fetch()} icon(s) fetched")
                return 0
            slug = argv[2] if len(argv) > 2 else None
            have = {a["url"] for a in installed_apps().get(slug, [])} if slug else set()
            print(json.dumps([
                {"key": k, "name": v[0], "url": v[1], "ruleDomain": v[2],
                 "host": urlsplit(v[1]).hostname, "installed": v[1] in have,
                 "iconPath": str(catalog_icon(k)) if catalog_icon(k).exists() else ""}
                for k, v in sorted(WEBAPPS.items(), key=lambda kv: kv[1][0].lower())]))
            return 0

        if sub == "probe":
            # For the panel's create form: never prompts, always prints JSON.
            if len(argv) < 4:
                print("usage: omaego app probe <ego> <url> [--names] "
                      "[--icon <image url|path>]",
                      file=sys.stderr)
                return 2
            raw = sys.argv[1:]
            icon = next((raw[i + 1] for i, a in enumerate(raw)
                         if a == "--icon" and i + 1 < len(raw)), None)
            ego = profiles().get(argv[2])
            print(json.dumps(app_probe(argv[3], ego["name"] if ego else None, icon,
                                       names_only="--names" in raw)))
            return 0

        if sub == "pick":
            # One search over the catalogue. Enter takes the highlighted row and
            # nothing else: a lone match is never added on its own. Text that
            # matches no row starts a custom app - a URL asks for its name next,
            # a name asks for its URL. Esc adds nothing.
            if len(argv) < 3:
                print("usage: omaego app pick <ego>", file=sys.stderr)
                return 2
            slug = argv[2]
            if slug not in profiles():
                print(f"unknown ego {slug!r}", file=sys.stderr)
                return 1
            name = profiles()[slug]["name"]
            have = {a["url"] for a in installed_apps().get(slug, [])}
            opts = [(v[0], k) for k, v in sorted(WEBAPPS.items(),
                                                 key=lambda kv: kv[1][0].lower())
                    if v[1] not in have]
            opts.append(("Custom app…", "__custom__"))
            chosen = pick(opts, f"Add to {name}: search, or paste a URL / "
                                f"type a name for your own", free=True, single=False)
            if chosen is None:
                return 0
            if chosen == "__custom__":
                chosen = ("free", (prompt_text(f"Custom app in {name}: paste its "
                                               f"URL, or type its name") or "").strip())
                if not chosen[1]:
                    return 0
            if isinstance(chosen, tuple):
                typed = chosen[1]
                key = catalog_match(typed)
                if key and WEBAPPS[key][1] not in have:
                    return app_add(slug, [key], interactive=True)
                if looks_like_url(typed):
                    return app_add(slug, [], url=typed, interactive=True)
                return app_add(slug, [], display=typed, interactive=True)
            return app_add(slug, [chosen], interactive=True)

        if sub == "open":
            # What a click on an app in the panel does: launch it, installing it
            # first when egos.toml declares it but this machine never has.
            if len(argv) < 4:
                print('usage: omaego app open <ego> "<app>"', file=sys.stderr)
                return 2
            slug, want = argv[2], argv[3]
            if slug not in profiles():
                print(f"unknown ego {slug!r}", file=sys.stderr); return 1
            app = find_app(slug, want)
            if app is None:
                ego_name = profiles()[slug]["name"]
                decl = next((a for a in pending_apps(slug)
                             if want.lower() in (a["name"].lower(),
                                                 APP_NAME_TEMPLATE.format(app=a["name"], ego=ego_name).lower())), None)
                if decl is None:
                    notify(f"no web app {want!r} in {ego_name}")
                    return 1
                notify(f"installing {decl['name']} for {ego_name}…")
                app = install_declared(slug, decl)
                if app is None:
                    notify(f"could not install {decl['name']}")
                    return 1
            subprocess.Popen(["sh", "-c", app["exec"]], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return 0

        if sub == "edit":
            # What the panel's edit form saves: a new name, a new icon, or both.
            raw = sys.argv[1:]
            def flagval(name):
                for i, a in enumerate(raw):
                    if a == name and i + 1 < len(raw):
                        return raw[i + 1]
                    if a.startswith(name + "="):
                        return a.split("=", 1)[1]
                return None
            if len(argv) < 4:
                print('usage: omaego app edit <ego> "<app>" [--name <name>] '
                      "[--icon <image url|path>] [--agent-icon]", file=sys.stderr)
                return 2
            slug, want = argv[2], argv[3]
            app = find_app(slug, want)
            if app is None:
                print(f"no app {want!r} in {slug}", file=sys.stderr)
                notify(f"no web app {want!r} to edit")
                return 1
            ego_name = profiles()[slug]["name"]
            changed = []
            new = (flagval("--name") or "").strip()
            if new:
                # The form edits the short name; the ego is always appended.
                full = new if re.search(rf"\b{re.escape(ego_name)}\b", new, re.I) \
                    else APP_NAME_TEMPLATE.format(app=new, ego=ego_name)
                if full != app["name"]:
                    if (DESKTOP_DIR / f"{full}.desktop").exists():
                        notify(f"{full} already exists")
                        return 1
                    rename_app(app, full)
                    app = find_app(slug, full)
                    changed.append(f"renamed to {full}")
            icon = flagval("--icon")
            if icon:
                if not set_app_icon(slug, app, icon):
                    return 1
                changed.append("icon updated")
            if "--agent-icon" in raw:
                if agent_find_icon(slug, app["name"], app["url"]):
                    changed.append("the agent is looking for an icon")
            subprocess.run(["update-desktop-database", str(DESKTOP_DIR)],
                           capture_output=True)
            notify(f"{app['name']}: " + (", ".join(changed) or "nothing changed"))
            return 0

        if sub in ("add", "remove"):
            if len(argv) < 3:
                print(f"usage: omaego app {sub} <ego> <app>...", file=sys.stderr)
                return 2
            slug, keys = argv[2], argv[3:]
            raw = sys.argv[1:]
            # A flag's VALUE does not start with "-", so it survives the flag
            # strip above and would otherwise be read as a catalogue key.
            for flag in ("--url", "--name", "--name-template", "--icon"):
                for i, a in enumerate(raw):
                    if a == flag and i + 1 < len(raw):
                        keys = [k for k in keys if k != raw[i + 1]]
                    elif a.startswith(flag + "="):
                        keys = [k for k in keys if k != a.split("=", 1)[1]]
            def flagval(name):
                for i, a in enumerate(raw):
                    if a == name and i + 1 < len(raw):
                        return raw[i + 1]
                    if a.startswith(name + "="):
                        return a.split("=", 1)[1]
                return None
            if sub == "add":
                return app_add(slug, keys, name_tpl=flagval("--name-template"),
                               url=flagval("--url"), display=flagval("--name"),
                               want_rule="--rule" in raw, icon=flagval("--icon"),
                               agent_icon="--agent-icon" in raw)
            if slug not in profiles():
                print(f"unknown ego {slug!r}", file=sys.stderr); return 1
            ego_name = profiles()[slug]["name"]
            if not keys:
                # From a keybinding or the launcher: pick which one.
                apps = installed_apps().get(slug, [])
                if not apps:
                    notify(f"{ego_name} has no web apps")
                    return 0
                chosen = pick([(a["name"], a["name"]) for a in apps],
                              f"Remove a web app from {ego_name}…", single=False)
                if chosen is None:
                    return 0
                keys = [chosen]
            rc = 0
            for k in keys:
                app = find_app(slug, k)
                if app is None:
                    # Declared in egos.toml but never installed here.
                    decl = next((a for a in pending_apps(slug)
                                 if k.lower() in (a["name"].lower(), (a.get("key") or "").lower(),
                                                  APP_NAME_TEMPLATE.format(app=a["name"], ego=ego_name).lower())), None)
                    if decl:
                        forget_declared(slug, decl["url"])
                        print(f"  forgotten  {decl['name']}")
                        notify(f"removed {decl['name']} from {ego_name}")
                        continue
                    print(f"  not found  {k}", file=sys.stderr)
                    notify(f"no web app {k!r} in {ego_name}")
                    rc = 1
                    continue
                remove_app(app)
                forget_declared(slug, app["url"])
                print(f"  removed    {app['name']}")
                notify(f"removed {app['name']}")
            return rc

        print(f"unknown: omaego app {sub}", file=sys.stderr)
        return 2

    if cmd == "move":
        # The panel's drag and drop: put one ego, app or remote in front of
        # another (--before) or last (--end), in egos.toml - so it syncs.
        #   omaego move ego <slug> --before <slug> | --end
        #   omaego move app <ego> <url> --before <url> | --end
        #   omaego move remote <ego> <name> --before <name> | --end
        raw = sys.argv[sys.argv.index("move") + 1:]
        before = next((raw[i + 1] for i, a in enumerate(raw)
                       if a == "--before" and i + 1 < len(raw)), None)
        pos = [a for a in raw if not a.startswith("--") and a != before]
        kind = pos[0] if pos else ""
        if kind not in ("ego", "app", "remote") or len(pos) < (2 if kind == "ego" else 3) \
                or not (before or "--end" in raw):
            print("usage: omaego move ego <slug> --before <slug> | --end\n"
                  "       omaego move app <ego> <url> --before <url> | --end\n"
                  "       omaego move remote <ego> <name> --before <name> | --end",
                  file=sys.stderr)
            return 2
        # This machine's egos and apps into the file first, so everything the
        # card shows is in the list being reordered.
        export_repo(write=True)
        decl = load_declared()

        def reorder(items, ident, what, anchor):
            i = next((n for n, x in enumerate(items) if ident(x) == what), None)
            if i is None:
                return None
            item = items.pop(i)
            j = next((n for n, x in enumerate(items) if ident(x) == anchor), len(items))
            items.insert(j, item)
            return items

        if kind == "ego":
            order = reorder(list(decl), lambda k: k, pos[1], before)
            if order is None:
                print(f"unknown ego {pos[1]!r}", file=sys.stderr)
                return 1
            decl = {k: decl[k] for k in order}
        else:
            slug, what = pos[1], pos[2]
            if slug not in decl:
                print(f"unknown ego {slug!r}", file=sys.stderr)
                return 1
            field = "apps" if kind == "app" else "remotes"
            ident = (lambda a: a["url"]) if kind == "app" else remote_id
            if kind == "remote":
                what = slugify(what)
                before = slugify(before) if before else None
            if reorder(decl[slug][field], ident, what, before) is None:
                print(f"no {kind} {pos[2]!r} in {slug}", file=sys.stderr)
                return 1
        EGOS_FILE.write_text(render_egos(decl))
        print("moved")
        return 0

    if cmd == "remote":
        # Parsed from sys.argv: main() drops flags but keeps their values, and
        # a TUI's command after "--" must arrive untouched.
        raw = sys.argv[sys.argv.index("remote") + 1:]
        command = None
        if "--" in raw:
            command = " ".join(raw[raw.index("--") + 1:])
            raw = raw[:raw.index("--")]
        VALUED = ("--name", "--path", "--url", "--ssh", "--icon", "--value")
        opts, pos, i = {}, [], 0
        while i < len(raw):
            if raw[i] in VALUED and i + 1 < len(raw):
                opts[raw[i][2:]] = raw[i + 1]
                i += 2
                continue
            if not raw[i].startswith("-"):
                pos.append(raw[i])
            i += 1
        sub = pos[0] if pos else "list"
        rest = pos[1:]

        if sub == "tunnel":
            # Internal: the supervised tunnel `remote open` starts for a gateway.
            target, port, local = rest[0], int(rest[1]), int(rest[2])
            return run_tunnel(target, port, local)

        if sub in ("list", "ls"):
            me, peers = tailnet()
            rows = [{"ego": k, "id": remote_id(r), **r,
                     "here": r["machine"] == me,
                     "online": r["machine"] == me or peers.get(r["machine"], {}).get("online", False)}
                    for k, r in declared_remotes()]
            if want_json:
                print(json.dumps({"machine": me, "remotes": rows}))
                return 0
            print(f"this machine: {me}")
            for x in rows:
                what = {"herdr": f"herdr {x.get('session') or 'default'}",
                        "tui": x.get("command") or "shell",
                        "web": x.get("url") or f":{x.get('port')}{x.get('path') or ''}"}[x["kind"]]
                state = "here" if x["here"] else ("online" if x["online"] else "offline")
                print(f"  {x['ego']:<12} {x['name']:<24} {x['machine']:<16} {what}  ({state})")
            return 0

        if sub == "machines":
            me, peers = tailnet()
            for m, p in sorted(peers.items()):
                print(f"{m:<24} {'this machine' if m == me else ('online' if p['online'] else 'offline'):<13} {p['os']}")
            return 0

        if sub == "add":
            # remote add <ego> herdr <machine> [session]
            # remote add <ego> web <machine> <port> [--path P] [--url U]
            # remote add <ego> tui <machine> -- <command>
            pos = rest
            if len(pos) < 3 or pos[1] not in REMOTE_KINDS:
                print("usage: omaego remote add <ego> herdr <machine> [session]\n"
                      "       omaego remote add <ego> web <machine> <port> [--path /x] [--url URL]\n"
                      "       omaego remote add <ego> tui <machine> --name N -- <command>\n"
                      "  options: --name N, --ssh user@host, --icon NAME", file=sys.stderr)
                return 2
            slug, kind, machine = pos[0], pos[1], pos[2].lower()
            if slug not in profiles() and slug not in load_declared():
                print(f"unknown ego {slug!r} (see: omaego list)", file=sys.stderr)
                return 1
            r = {"kind": kind, "machine": machine}
            if kind == "herdr":
                r["session"] = pos[3] if len(pos) > 3 else "default"
                r["name"] = opts.get("name") or ("herdr" if r["session"] == "default"
                                              else f"herdr {r['session']}")
            elif kind == "web":
                if len(pos) < 4 or not pos[3].isdigit():
                    print("web needs a port: omaego remote add <ego> web <machine> <port>",
                          file=sys.stderr)
                    return 2
                r["port"] = int(pos[3])
                r["name"] = opts.get("name") or GATEWAYS.get(r["port"], f"Gateway {r['port']}")
            else:
                if not command:
                    print("tui needs a command after --", file=sys.stderr)
                    return 2
                r["command"] = command
                agent = next((GATEWAYS[p] for p, c in AGENT_TUIS.items()
                              if command.split()[:1] == c.split()[:1]), None)
                r["name"] = opts.get("name") or (f"{agent} TUI" if agent else command.split()[0])
            for k in ("path", "url", "ssh", "icon"):
                if opts.get(k):
                    r[k] = opts[k]
            remotes = [x for _, x in declared_remotes(slug)]
            if any(remote_id(x) == remote_id(r) for x in remotes):
                print(f"{slug} already has a remote called {r['name']!r}; pick another --name",
                      file=sys.stderr)
                notify(f"already pinned: {remote_label(r)}")
                return 1
            if not save_remotes(slug, remotes + [r]):
                return 1
            write_remote_entries()
            subprocess.run(["update-desktop-database", str(DESKTOP_DIR)], capture_output=True)
            print(f"added {remote_label(r)} to {slug}")
            if "--open" in sys.argv:
                return open_remote(slug, r)
            return 0

        if sub in ("remove", "rm"):
            if len(rest) < 2:
                print("usage: omaego remote remove <ego> <name>", file=sys.stderr)
                return 2
            r = find_remote(rest[0], rest[1])
            if not r:
                print(f"no remote {rest[1]!r} in {rest[0]}", file=sys.stderr)
                return 1
            save_remotes(rest[0], [x for _, x in declared_remotes(rest[0]) if x != r])
            write_remote_entries()
            subprocess.run(["update-desktop-database", str(DESKTOP_DIR)], capture_output=True)
            notify(f"removed {remote_label(r)}")
            print(f"removed {remote_label(r)}")
            return 0

        if sub == "open":
            if len(rest) < 2:
                print("usage: omaego remote open <ego> <name>", file=sys.stderr)
                return 2
            r = find_remote(rest[0], rest[1])
            if not r:
                notify(f"no remote {rest[1]} in {rest[0]}")
                return 1
            return open_remote(rest[0], r)

        if sub == "pick":
            # The card's "Add session or gateway": what your machines offer -
            # their herdr sessions (shown by name) and gateways - in one search.
            if not rest:
                print("usage: omaego remote pick <ego>", file=sys.stderr)
                return 2
            slug, spec = rest[0], (rest[1:] or None) if "--spec" in raw else None
            title = f"Pin to {(profiles().get(slug) or {}).get('name', slug)}"
            if "--json" in raw:
                return stream_offers()
            if spec:
                return pin_offer(slug, spec, opts.get("value"))
            ANY, LOOKING = "Any TUI over ssh…", "Looking at your machines…"
            # Probing takes seconds. The omarchy menu opens at once with what
            # needs no probe and a row saying it is looking, its dots stepping
            # while it looks; the full list then replaces it in place. Each
            # summon swaps the open menu's rows, so the CLI writes the menu's
            # payload itself rather than leaving a menu-select per frame.
            live = picker() == "omarchy"
            if not live:
                notify("looking at your machines…")
            from concurrent.futures import ThreadPoolExecutor
            def look():
                me, peers = tailnet()
                cands = [m for m, p in peers.items()
                         if m == me or (p["online"] and p["os"] in ("linux", "macOS"))]
                with ThreadPoolExecutor(8) as ex:
                    return me, dict(zip(cands, ex.map(lambda m: probe_machine(m, me), cands)))
            me, found = None, {}
            if live:
                import tempfile
                tmp = Path(tempfile.mkdtemp(prefix="omaego-menu-"))
                sel, fin = tmp / "selection", tmp / "done"
                sel.touch()
                def frame(n):
                    payload = {"mode": "select", "prompt": title, "width": 560,
                               "options": [ANY, LOOKING.rstrip("…") + "." * (n % 3 + 1)],
                               "selectionFile": str(sel), "doneFile": str(fin)}
                    subprocess.run(["omarchy-shell", "shell", "summon", "omarchy.menu",
                                    json.dumps(payload)], capture_output=True)
                bg = ThreadPoolExecutor(1)
                done = bg.submit(look)
                n, shown = 0, 0.0
                try:
                    while not done.done():
                        if fin.exists():
                            chosen = sel.read_text().strip()
                            if chosen == ANY:
                                spec = ["tui-new"]
                                break
                            if not chosen.startswith("Looking"):
                                return 0   # Esc
                            fin.unlink()   # the looking row: keep looking
                            sel.write_text("")
                        if time.monotonic() - shown >= 0.4:
                            frame(n)
                            n, shown = n + 1, time.monotonic()
                        time.sleep(0.05)
                    if not spec:
                        me, found = done.result()
                finally:
                    bg.shutdown(wait=False)
                    shutil.rmtree(tmp, ignore_errors=True)
            else:
                me, found = look()
            have = pinned_remote_keys()
            rows = {ANY: ["tui-new"]}
            for m in sorted(found, key=lambda x: (x != me, x)):
                for r in machine_offers(m, found[m], have):
                    rows[f"{m}: {r['name']}" + (f" ({r['note']})" if r["note"] else "")] = r["spec"]
            if not spec:
                spec = pick(list(rows.items()), title, single=False, width=560)
            return pin_offer(slug, spec) if spec else 0

        print("usage: omaego remote [list|machines|add|remove|open|pick]", file=sys.stderr)
        return 2

    if cmd == "setup":
        # What install.sh does, minus the symlinks: for a packaged install the
        # binaries are already on PATH and only the per-user wiring is missing.
        apps = DESKTOP_DIR
        apps.mkdir(parents=True, exist_ok=True)
        RULES.parent.mkdir(parents=True, exist_ok=True)
        if not RULES.exists():
            seed = Path("/usr/share/omaego/rules.toml")
            RULES.write_text(seed.read_text() if seed.exists() else
                             "# omaego rules. See the README.\n")
            print(f"  seeded {RULES}")
        # Read the engine before taking over as default browser: afterwards
        # xdg-settings only ever answers "omaego".
        was = xdg_default_browser()
        eng = engine()
        if was not in ENGINES and was != "omaego.desktop":
            print(f"  {was or 'the default browser'} cannot hold egos "
                  f"(Chromium family only)")
        print(f"  engine: {eng['name']} ({eng['source']})")
        want = (False if "--no-google-signin" in sys.argv
                else True if "--google-signin" in sys.argv else None)
        line = google_signin(eng, want)
        if line:
            print(f"  {line}")
            if not NO_GOOGLE_SIGNIN.exists():
                for t in profiles().values():
                    if t["engine"]["id"] == eng["id"] and signin_blocked(t):
                        print(f"          {t['name']} has sign-in switched off in its "
                              f"own settings: Settings > You and Google > Sync and "
                              f"Google services")
        elif want is not None:
            print(f"  google: nothing to do in {eng['short']}, only Chromium needs it")
        menu = picker()
        if menu:
            print(f"  menu:   {'Omarchy' if menu == 'omarchy' else 'walker'}")
        else:
            print("  menu:   MISSING. The ego picker, \"New ego\" and every prompt "
                  "need Omarchy's")
            print("          own menu (omarchy-menu-select, Omarchy 4) or walker")
        os.environ.setdefault("OMAEGO_BIN", shutil.which("omaego") or "omaego")
        write_desktop_entries()
        print(f"  wrote desktop entries in {apps}")
        subprocess.run(["update-desktop-database", str(apps)], capture_output=True)
        subprocess.run(["xdg-settings", "set", "default-web-browser",
                        "omaego.desktop"], capture_output=True)
        subprocess.run(["xdg-mime", "default", "omaego.desktop",
                        "x-scheme-handler/http", "x-scheme-handler/https",
                        "text/html"], capture_output=True)
        print("  registered as default browser")
        if not profiles() and eng["id"] in {e["id"] for e in adoptable()}:
            print(f"\nNext: omaego add \"Personal\" --existing   "
                  f"(your {eng['short']} profile, as it is, becomes the first ego)")
            print("      omaego add \"Work\"   then   omaego app add work teams")
        else:
            print("\nNext: omaego add \"Work\"   then   omaego app add work teams")
        return 0

    if cmd == "engine":
        eng = engine()
        egos = profiles()
        if argv[1:2] == ["command"]:
            # For omaego-webapp: the browser of one ego, or the default.
            own = egos[argv[2]]["engine"] if argv[2:3] and argv[2] in egos else eng
            print(own["command"])
            return 0
        if argv[1:2] == ["pick"] and len(argv) > 2:
            return pick_engine(argv[2])
        if len(argv) > 2:
            to = find_engine(argv[2])
            if argv[1] not in egos:
                print(f"unknown ego {argv[1]!r}", file=sys.stderr)
                return 1
            if not (to and shutil.which(to["command"])):
                print(f"no such browser installed: {argv[2]!r} (have: "
                      f"{', '.join(e['short'].lower() for e in installed_engines())})",
                      file=sys.stderr)
                return 1
            was = egos[argv[1]]["engine"]
            empty = argv[3:4] == ["empty"]
            backup = set_engine(argv[1], to, "empty" if empty else "keep")
            print(f"{egos[argv[1]]['name']}: {was['short']} -> {to['short']}"
                  + (", empty profile" if empty else ""))
            if backup:
                print(f"  previous profile kept in {backup}")
            if was["id"] != to["id"] and not empty:
                print("  bookmarks, history, extensions and settings came along;")
                print("  cookies and saved passwords did not - sign in again")
            return 0
        print(f"default: {eng['name']}  ({eng['command']})  - {eng['source']}")
        for t in sorted(egos.values(), key=ego_sort_key()):
            missing = "" if shutil.which(t["engine"]["command"]) else "  NOT INSTALLED"
            print(f"  {t['name']:<22} {t['engine']['name']}{missing}")
        return 0 if shutil.which(eng["command"]) else 1

    if cmd == "here":
        rows = browsers_here()
        if want_json:
            print(json.dumps([{"address": a, "class": c, "focused": f,
                               "webapp": a is None} for a, c, f in rows]))
            return 0
        for a, cls, foc in rows:
            kind = "webapp" if a is None else "browser"
            print(f"{a or '-':<18} {kind:<8} {cls}{' (focused)' if foc else ''}")
        return 0

    if cmd == "close":
        if len(argv) < 2:
            print("usage: omaego close <ego>", file=sys.stderr)
            return 2
        n = close_ego(argv[1])
        print(f"closed {n} window(s) of {argv[1]} on this workspace")
        return 0

    if cmd == "learn":
        if not ROUTES.exists() and "--agent" not in sys.argv:
            print(f"nothing logged yet ({ROUTES})")
            return 0
        seen = {}
        for line in (ROUTES.read_text().splitlines() if ROUTES.exists() else []):
            try:
                r = json.loads(line)
            except ValueError:
                continue
            host, first = r.get("host", ""), (r.get("path") or "").split("/")[0]
            if not host:
                continue
            for key in {host, f"{host}/{first}" if first else host}:
                seen.setdefault(key, {}).setdefault(r["ego"], 0)
                seen[key][r["ego"]] += 1

        suggestions = []
        for key, egos in seen.items():
            total = sum(egos.values())
            ego, hits = max(egos.items(), key=lambda kv: kv[1])
            if total < 3 or hits / total < 0.8:
                continue                      # too few, or genuinely mixed
            pat = f"https://{key}/*" if "/" in key else f"https://{key}/*"
            host_only = "/" not in key
            # A host-wide suggestion is wrong when a rule already pins part of
            # that host: bitbucket.org/<customer>/* exists, so bitbucket.org/*
            # would quietly swallow every other customer on the same host.
            if host_only and any(key in (r.get("url") or r.get("match") or "")
                                 for r in load_rules()):
                continue
            if match_rule(pat.replace("*", ""), None):
                continue                      # a rule already covers it
            # Prefer the longer, more specific key when both qualify for one ego
            suggestions.append((hits, total, pat, ego))
        suggestions.sort(reverse=True)
        kept, hosts = [], set()
        for hits, total, pat, ego in suggestions:
            root_host = pat.split("/")[2]
            if "/" not in pat[8:].rstrip("*").rstrip("/") and root_host in hosts:
                continue
            hosts.add(root_host)
            kept.append((hits, total, pat, ego))

        if "--agent" in sys.argv[1:]:
            # The agent gets the browsers' history too (hosts and counts only),
            # suggests rules and adds the ones you approve.
            lines = [f"{p} -> {e} ({h}/{t} opens)" for h, t, p, e in kept[:40]]
            if "--print" in sys.argv:
                print(learn_prompt(lines))
                return 0
            if not run_agent(learn_prompt(lines), cwd=CONFIG_DIR if CONFIG_DIR.exists() else None):
                return 1
            notify("egos: the agent is looking for rules to suggest")
            print("handed your routes and browsing to the default agent")
            return 0

        if not kept:
            print("no confident suggestions yet - keep using it")
            return 0
        print("Routes worth adding (a host that consistently went to one ego):\n")
        for hits, total, pat, ego in kept:
            print(f"  omaego rule add '{pat}' {ego}".ljust(62) + f"# {hits}/{total}")
        return 0

    if cmd == "highlight":
        highlight("all" if len(argv) > 1 and argv[1] == "all" else None)
        return 0

    if cmd == "apply":
        # Make this machine match egos.toml, e.g. after editing it by hand.
        done = apply_repo(prune="--prune" in sys.argv)
        for line in done:
            print(f"  {line}")
        print("nothing to apply" if not done else f"{len(done)} change(s)")
        if done and not sys.stdout.isatty():
            notify("applied egos.toml: " + ", ".join(done[:4])
                   + (" …" if len(done) > 4 else ""))
        return 0

    if cmd == "sync":
        raw = sys.argv[1:]
        if "--status" in raw:
            st = sync_status(fetch="--fetch" in raw)
            if want_json:
                print(json.dumps(st))
            else:
                print(st["state"], *(f"{k}={st[k]}" for k in ("local", "ahead", "behind") if st[k]))
                for c in st.get("changes", []):
                    print(f"  {c}")
            return 0
        url = next((raw[i + 1] for i, a in enumerate(raw)
                    if a == "--remote" and i + 1 < len(raw)), None)
        if "--setup" in raw and not url:
            # From the panel: ask where the private repo lives.
            url = (prompt_text("Your private git repo for egos and rules, "
                               "e.g. git@github.com:you/myomaego.git") or "").strip()
            if not url:
                return 0
        # The local half first, as `sync` always did: desktop entries and the
        # native messaging links. It is what a package upgrade asks for.
        write_desktop_entries()
        write_remote_entries()
        print("desktop entries written")
        if not (CONFIG_DIR / ".git").exists():
            if not url:
                print("~/.config/omaego is not a git repo, so there is nothing to "
                      "pull or push.\nTo keep your egos in a private repo: "
                      "omaego sync --remote <git url>")
                return 0
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            git("init", "--quiet", "-b", "main")
        ensure_gitignore()
        if url:
            r = git("remote", "set-url", "origin", url)
            if r.returncode != 0:
                git("remote", "add", "origin", url)
        # A repo with no commits yet, against a remote that has some: a new
        # machine. With nothing of its own to keep, take the remote as it is.
        remote = (git("remote").stdout.split() or [None])[0]
        if remote and git("rev-parse", "--verify", "--quiet", "HEAD").returncode != 0:
            git("fetch", "--quiet", remote, timeout=60)
            head = git("symbolic-ref", "--short", f"refs/remotes/{remote}/HEAD").stdout.strip()
            branch = head.split("/", 1)[1] if "/" in head else "main"
            mine = bool(profiles()) or bool(load_rules())
            if git("rev-parse", "--verify", "--quiet", f"{remote}/{branch}").returncode == 0 \
                    and not mine:
                git("checkout", "--quiet", "-f", "-B", branch, "--track", f"{remote}/{branch}")
                ensure_gitignore()
                n = len(available_egos())
                msg = (f"your rules and {n} ego{'s' if n != 1 else ''} from {remote}: "
                       f"set up the ones you want here from the panel")
                print(msg); notify("egos: " + msg)
                return 0
        changed = export_repo(write=True)
        st = sync_status(fetch=True)
        remote = st.get("remote")
        if remote and not st.get("upstream"):
            # A remote with history but no tracking branch yet: track it.
            branch = git("rev-parse", "--abbrev-ref", "HEAD").stdout.strip() or "main"
            if git("rev-parse", "--verify", "--quiet", f"{remote}/{branch}").returncode == 0:
                git("branch", f"--set-upstream-to={remote}/{branch}")
                st = sync_status()
        if st["state"] == "clean":
            print("in sync"); notify("egos: in sync")
            return 0
        if st["state"] == "behind":
            r = git("merge", "--ff-only", "--quiet", "@{u}")
            if r.returncode == 0:
                done = apply_repo(prune=True)
                msg = f"pulled {st['behind']} change(s)" + (": " + ", ".join(done[:4]) if done else "")
                print(msg); notify("egos: " + msg)
                return 0
        # Anything to commit, push or merge goes to the agent: it writes the
        # commit message from the diff, and resolves conflicts with judgement.
        where = f"{remote} ({st.get('upstream') or 'no upstream yet'})" if remote else "no remote"
        prompt = (
            f"Sync my omaego configuration repo, {CONFIG_DIR} (your working "
            f"directory), with its remote: {where}.\n\n"
            f"It holds rules.toml (which URLs open in which browser ego), "
            f"account-hosts, egos.toml (my egos, their colours and web apps) and "
            f"icons/ (each web app's unbadged icon). omaego has just written this "
            f"machine's state into it. Now: {st['local']} changed file(s), "
            f"{st['ahead']} commit(s) not pushed, {st['behind']} commit(s) on the "
            f"remote not pulled.\n\n"
            f"1. Look at `git status` and `git diff`, and commit the local changes "
            f"with short messages in my terms, e.g. \"Acme: add Outlook, route "
            f"acme.atlassian.net\". Split unrelated changes into separate commits.\n"
            f"2. Pull with rebase. Resolve conflicts keeping the intent of both "
            f"sides: what either side added stays; what one side removed and the "
            f"other left alone goes; when both changed the same thing differently, "
            f"ask me. egos.toml and rules.toml must stay valid TOML - check each "
            f"with: python3 -c 'import tomllib,sys; tomllib.load(open(sys.argv[1],\"rb\"))' FILE\n"
            f"3. Push (with -u if the branch has no upstream yet).\n"
            f"4. Run `omaego apply --prune` so this machine matches the repo, then "
            f"`omaego sync --status`, which should print \"clean\".\n\n"
            f"Work only inside {CONFIG_DIR}. Nothing from "
            f"~/.local/share/chrome-profiles (logins, cookies) belongs in this repo.")
        if not run_agent(prompt, cwd=CONFIG_DIR):
            return 1
        print(f"handed to the agent: {st['state']}, {st['local']} local, "
              f"{st['ahead']} ahead, {st['behind']} behind")
        notify("egos: the agent is syncing")
        return 0

    if cmd == "panel":
        # Everything the bar panel renders, in one call - four separate
        # processes per open would be four Chrome-free but still pointless forks.
        fetch_in_background()
        by_class = all_targets()
        rows = browsers_here()
        here = {c for _, c, _ in rows}
        # Which ego owns the focused window, so the bar can mark it.
        focused_cls = next((c for a, c, f in rows if f), None)
        inst = installed_apps()
        dflt = default_slug()
        rules = [{"pattern": r.get("url") or r.get("match") or "",
                  "profile": r.get("profile"), "app": bool(r.get("app"))}
                 for r in load_rules()]
        egos = sorted(profiles().values(), key=ego_sort_key())
        names = {t["name"].lower() for t in egos} | {t["slug"] for t in egos}
        declared = load_declared()
        avail = available_egos()
        me, peers = tailnet() if any(e.get("remotes") for e in declared.values()) else (None, {})

        def panel_remote(r, t_slug):
            here = r["machine"] == me
            return {"id": remote_id(r), "name": r["name"], "kind": r["kind"],
                    "iconPath": icon_path(remote_icon_slug(t_slug, r)),
                    "machine": r["machine"], "here": here,
                    "online": here or peers.get(r["machine"], {}).get("online", False)}
        # A rule for an ego in your repo but not on this device belongs on that
        # ego's card, not among the rules for no ego at all.
        names |= {e["name"].lower() for e in avail.values()} | set(avail)

        def app_rank(slug):
            # Apps in egos.toml's order (drag on the card to change it); any
            # it does not list yet after them, by name.
            rank = {a["url"]: i for i, a in enumerate(declared.get(slug, {}).get("apps", []))}
            return lambda a: (rank.get(a["url"], len(rank)), (a.get("short") or a["name"]).lower())

        def panel_app(a, ego_name):
            # "Outlook Work" is the launcher's name; inside the Work column the
            # ego is already said, so show "Outlook".
            short = re.sub(rf"\s*\b{re.escape(ego_name)}\b\s*", " ",
                           a["name"], flags=re.I).strip() or a["name"]
            return {**a, "short": short, "iconPath": icon_path(a["icon"])}

        def owns(t, r):
            p = (r["profile"] or "").lower()
            return p in (t["name"].lower(), t["slug"])

        print(json.dumps({
            "workspace": current_workspace(),
            "fallback": (profiles().get(dflt or "") or {}).get("name"),
            "egos": [{"slug": t["slug"], "name": t["name"], "class": t["wm_class"],
                      "color": "#" + ego_color(t["slug"]),
                      "default": t["slug"] == dflt,
                      "browser": t["engine"]["short"],
                      "accounts": merge_accounts(declared.get(t["slug"], {}).get("accounts"),
                                                 browser_accounts(t)),
                      "here": t["wm_class"] in here,
                      "focused": t["wm_class"] == focused_cls,
                      "apps": sorted(
                              [panel_app(a, t["name"]) for a in inst.get(t["slug"], [])]
                              + [{"name": APP_NAME_TEMPLATE.format(app=a["name"], ego=t["name"]),
                                  "short": a["name"], "url": a["url"], "pending": True,
                                  "iconPath": str(CONFIG_DIR / a["icon"]) if a.get("icon")
                                              and (CONFIG_DIR / a["icon"]).is_file() else "",
                                  "desktop": "", "exec": ""}
                                 for a in declared.get(t["slug"], {}).get("apps", [])
                                 if a["url"] not in {x["url"] for x in inst.get(t["slug"], [])}],
                              key=app_rank(t["slug"])),
                      "remotes": [panel_remote(r, t["slug"]) for r in
                                  declared.get(t["slug"], {}).get("remotes", [])],
                      "rules": [r for r in rules if owns(t, r)]}
                     for t in egos],
            "machine": me,
            # Rules with no ego (rewrite/app-only) or naming one that is gone.
            "looseRules": [r for r in rules
                           if (r["profile"] or "").lower() not in names],
            "rules": rules,
            "sync": sync_status(),   # as of the last fetch, which this keeps fresh
            # Egos in your repo that are not set up on this device.
            "available": [{"slug": k, "name": e["name"], "color": "#" + (e.get("color") or "7aa2f7"),
                           "accounts": e.get("accounts") or [],
                           "apps": [a["name"] for a in e["apps"]],
                           "rules": [r for r in rules
                                     if (r["profile"] or "").lower() in (k, e["name"].lower())]}
                          for k, e in sorted(avail.items(),
                                             key=lambda kv, o=ego_sort_key(): o((kv[0], kv[1]["name"])))],
        }))
        return 0

    if cmd == "space":
        # A space usually belongs to ONE ego. Report which, from what is on it.
        # There is no global "active ego" - the workspace is the unit.
        by_class = all_targets()
        rows = browsers_here()
        egos, has_browser = [], set()
        for a, cls, _ in rows:
            t = by_class.get(cls)
            name = t["name"] if t else cls
            if name not in egos:
                egos.append(name)
            if a is not None:
                has_browser.add(name)
        state = ("empty" if not egos else
                 "single" if len(egos) == 1 else "mixed")
        out = {"workspace": current_workspace(), "state": state, "egos": egos,
               "withBrowser": sorted(has_browser),
               "fallback": (profiles().get(default_slug() or "") or {}).get("name")}
        if want_json:
            print(json.dumps(out))
        elif state == "empty":
            print(f"workspace {out['workspace']}: no ego here "
                  f"(a link would ask; fallback is {out['fallback']})")
        else:
            print(f"workspace {out['workspace']}: {', '.join(egos)}"
                  + ("" if has_browser else "  (web app only - a link opens a new window)"))
        return 0

    open_url(cmd, incognito=incognito)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
