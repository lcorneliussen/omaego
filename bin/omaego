def ego_initials(name):
    """One to three letters for the badge: short all-caps names stay whole."""
    words = [w for w in re.split(r"[^A-Za-z0-9]+", name) if w]
    if not words:
        return "?"
    if len(words) == 1:
        w = words[0]
        return w.upper() if (w.isupper() and len(w) <= 3) else w[:2].upper()
    return (words[0][0] + words[1][0]).upper()


def readable_on(hex_colour):
    """Black or white, whichever reads on that background."""
    h = hex_colour.lstrip("#")
    r, g, b = (int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))
    lum = 0.2126 * r + 0.7152 * g + 0.0722 * b
    return "#000000" if lum > 0.55 else "#ffffff"


def badge_icon(path, text, colour):
    """See apply_badge; this does the drawing."""
    """Stamp an ego badge onto the bottom-right of a 256px app icon.

    Two egos running the same web app otherwise produce identical launcher
    icons, which is exactly the confusion omaego exists to prevent.
    """
    if not shutil.which("magick") or not path.exists():
        return False
    colour = "#" + colour.lstrip("#")
    fg = readable_on(colour)
    tmp = path.with_suffix(".badge.png")
    try:
        # the disc, with a dark rim so it separates from any artwork beneath
        subprocess.run(["magick", "-size", "128x128", "xc:none",
                        "-fill", colour, "-stroke", "#00000066", "-strokewidth", "6",
                        "-draw", "circle 64,64 64,8", str(tmp)], check=True,
                       capture_output=True)
        # the letters, trimmed then fitted inside the disc
        label = path.with_suffix(".txt.png")
        font = subprocess.run(["fc-match", "-f", "%{file}", "DejaVu Sans:bold"],
                              capture_output=True, text=True).stdout.strip()
        args = ["magick", "-background", "none", "-fill", fg]
        if font:
            args += ["-font", font]
        args += ["-pointsize", "96", f"label:{text}", "-trim", "+repage",
                 "-resize", "64x52", str(label)]
        subprocess.run(args, check=True, capture_output=True)
        subprocess.run(["magick", str(tmp), str(label), "-gravity", "center",
                        "-composite", str(tmp)], check=True, capture_output=True)
        subprocess.run(["magick", str(path), "-resize", "256x256",
                        str(tmp), "-gravity", "southeast", "-geometry", "+4+4",
                        "-composite", f"PNG32:{path}"], check=True, capture_output=True)
        return True
    except subprocess.CalledProcessError:
        return False
    finally:
        for f in (tmp, path.with_suffix(".txt.png")):
            f.unlink(missing_ok=True)


def apply_badge(icon_slug, ego):
    """Stamp the ego badge, always from the pristine copy.

    The unbadged original is kept beside it, so re-badging after an ego is
    renamed or recoloured never stacks one disc on top of another.
    """
    if os.environ.get("OMAEGO_NO_BADGE") == "1":
        return False
    icon = ICON_DIR / f"{icon_slug}.png"
    orig = ICON_DIR / f"{icon_slug}.orig.png"
    if not icon.exists() and not orig.exists():
        return False
    if orig.exists():
        shutil.copy(orig, icon)
    else:
        shutil.copy(icon, orig)
    return badge_icon(icon, ego_initials(ego["name"]), ego_color(ego["slug"]))


def normalize_icon(path):
    """Make an icon a 256px transparent PNG, whatever the site served.

    Omarchy's fetcher happily writes a JPEG under a .png name (Outlook) or a
    64px favicon into the 256px directory (Google Chat). A JPEG has no alpha, so
    it shows as a solid white tile on a dark bar. Flood-fill from the corner
    rather than keying on white, so white *inside* a logo survives.
    """
    if not path.exists() or not shutil.which("magick"):
        return False
    kind = subprocess.run(["file", "-b", str(path)], capture_output=True,
                          text=True).stdout
    args = ["magick", str(path), "-alpha", "set"]
    if "JPEG" in kind:                      # opaque source: lift the backdrop
        args += ["-bordercolor", "white", "-border", "1",
                 "-fuzz", "8%", "-fill", "none", "-floodfill", "+0+0", "white",
                 "-shave", "1x1"]
    args += ["-resize", "256x256", f"PNG32:{path}"]
    return subprocess.run(args, capture_output=True).returncode == 0


def fetch_icon(url, dest):
    try:
        r = subprocess.run(["curl", "-fsSL", "--max-time", "10", "-o", str(dest), url],
                           capture_output=True)
        return r.returncode == 0 and dest.exists() and dest.stat().st_size > 0
    except Exception:
        return False


def app_rule_conflict(domain):
    """Which ego, if any, already claims this domain in rules.toml."""
    if not domain:
        return None
    for r in load_rules():
        pat = r.get("url") or r.get("match") or ""
        if domain in pat:
            return r.get("profile")
    return None


def append_rule(domain, ego_name):
    with RULES.open("a") as f:
        f.write(f'\n[[rule]]\nurl = "https://*{domain}/*"\nprofile = "{ego_name}"\n')


def name_from_url(url):
    """A sensible app name from a URL: the registrable part of the host."""
    host = (urlsplit(url).hostname or "").lower().lstrip("www.")
    parts = [p for p in host.split(".") if p not in ("com", "org", "net", "io",
                                                     "app", "co", "www")]
    return (name_candidates(url) or [host])[0]


def name_candidates(url, ego_name=None):
    """Plausible names for a URL, best first.

    No rule gets both shapes right - jira.acme.io is "Jira" (the subdomain)
    while acme.odoo.com is "Odoo" (the registrable domain) - so offer both
    and let the choice be made.
    """
    host = (urlsplit(url).hostname or "").lower()
    for junk in ("www.", "app.", "my."):
        if host.startswith(junk):
            host = host[len(junk):]
    parts = [p for p in host.split(".")
             if p not in ("com", "org", "net", "io", "co", "app", "de", "ai")]
    # A first path segment is frequently the real product: google.com/maps is
    # "Maps", not "Google". Offered alongside the host, so the choice is made
    # rather than guessed.
    seg = [w for w in (urlsplit(url).path or "").strip("/").split("/")[:1] if w]
    cands = ([parts[0]] if parts else []) + (parts[1:2] if len(parts) > 1 else [])
    if seg and seg[0].isalpha() and 2 <= len(seg[0]) <= 14:
        cands.append(seg[0])
    out = []
    for p in cands:
        n = p.replace("-", " ").title()
        # The ego is already known from the card the app is being added under,
        # so its own name is never the app's name: acme.odoo.com under the
        # Acme ego is simply "Odoo".
        if ego_name and n.lower() == ego_name.lower():
            continue
        if n not in out:
            out.append(n)
    return out or [host]


def normalize_url(url):
    if url and not re.match(r"^[a-z][a-z0-9+.-]*://", url, re.I):
        url = "https://" + url
    return url


def agent_find_icon(slug, name, app_url):
    """Hand the icon hunt to the default omarchy agent.

    The agent cannot pass a URL back into this process, so it is given the
    command that applies the result instead and runs it itself.
    """
    prompt = (
        f"Find the official icon for the web app \"{name}\" at {app_url} and "
        f"install it.\n\n"
        f"Prefer the site's own apple-touch-icon or a vendor press/brand asset; "
        f"a square PNG at 256px or larger, with transparency if available. "
        f"Avoid favicon services, which cap at 64px and look soft on the bar.\n\n"
        f"Then apply it with exactly:\n"
        f"    omaego app icon {slug} \"{name}\" <image-url-or-path>\n\n"
        f"That command downloads, normalises and rewrites the .desktop entry, so "
        f"nothing else needs editing. Verify afterwards with:\n"
        f"    omaego app installed | grep -i \"{name}\"")
    # omarchy only prints a hint when no default agent is configured, and a
    # Popen succeeds either way - so check before claiming the handoff worked.
    if not (Path.home() / ".config/omarchy/defaults/agent").exists():
        notify("no default agent set — run: omarchy default agent <name>")
        print("no default agent configured; run: omarchy default agent <name>",
              file=sys.stderr)
        return False
    try:
        subprocess.Popen(["omarchy", "agent", "prompt", prompt],
                         start_new_session=True)
        return True
    except Exception:
        return False


def app_add(slug, keys, name_tpl=None, url=None, display=None, want_rule=False,
            interactive=False):
    # Resolve the ego FIRST: naming a web app needs it, both to exclude the
    # ego's own name from the candidates and to build the launcher name.
    egos = profiles()
    if slug not in egos:
        print(f"unknown ego {slug!r} (see: omaego list)", file=sys.stderr)
        return 1
    ego = egos[slug]

    # One of url/name is enough; ask for whatever is missing.
    if url and not display:
        u = normalize_url(url)
        cands = name_candidates(u, ego["name"])
        # Suggestions are rows you can pick; nothing is accepted on your behalf.
        # A picker cannot also take free text - walker filters its rows against
        # what is typed and returns nothing when none match - so typing another
        # name is itself a row, which opens an input box.
        choice = pick([(c, c) for c in cands] + [("Type another name…", "__type__")],
                      f"Name this app ({urlsplit(u).hostname})")
        if choice is None:
            return 1
        if choice == "__type__":
            display = (prompt_text(f"Name for {urlsplit(u).hostname}") or "").strip()
            if not display:
                notify("cancelled: a name is needed")
                return 1
        else:
            display = choice
    elif display and not url:
        url = prompt_text(f"URL for {display}")
        if not url:
            return 1
    url = normalize_url(url) if url else None

    bin_webapp = os.environ.get("OMAEGO_WEBAPP",
                                str(Path.home() / ".local/bin/omaego-webapp"))
    tpl = name_tpl or APP_NAME_TEMPLATE
    ICON_DIR.mkdir(parents=True, exist_ok=True)

    items = []
    if url:
        items.append((display or urlsplit(url).hostname or "App", url, None, None))
    for k in keys:
        if k not in WEBAPPS:
            print(f"unknown app {k!r} (see: omaego app list)", file=sys.stderr)
            return 1
        items.append(WEBAPPS[k])

    have = installed_apps().get(slug, [])
    for app_name, app_url, domain, icon_url in items:
        name = tpl.format(app=app_name, ego=ego["name"])
        clash = next((a for a in have
                      if a["url"] == app_url or a["name"] == name), None)
        if clash:
            msg = f"{clash['name']} is already in {ego['name']}"
            print(f"  {msg}")
            notify(msg + " — remove it first to re-add")
            continue
        icon_slug = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")
        icon_arg = ""
        if icon_url:
            dest = ICON_DIR / f"{icon_slug}.png"
            if fetch_icon(icon_url, dest) and normalize_icon(dest):
                icon_arg = icon_slug          # a bare name is used as-is
        exec_line = f"{bin_webapp} --ego={slug} --app={app_url}"
        def run_install(icon):
            return subprocess.run(["omarchy", "webapp", "install", name, app_url,
                                   icon, exec_line], capture_output=True, text=True)

        r = run_install(icon_arg)
        if r.returncode != 0 and not icon_arg:
            # omarchy aborts the whole install when it cannot fetch an icon, and
            # plenty of internal hosts serve none. Ask for one before falling
            # back to a generic picture.
            host = urlsplit(app_url).hostname
            # Only ask where someone is there to answer. A scripted `app add`
            # would otherwise sit on this prompt until the menu times out.
            given = None
            if interactive:
                choice = pick([("Paste an image URL…", "url"),
                               ("Let the agent find one", "agent"),
                               ("Use a generic icon", "generic")],
                              f"No icon found at {host}")
                if choice == "url":
                    given = prompt_text(f"Image URL for {name}")
                elif choice == "agent":
                    r = run_install(ego_engine(PROFILE_ROOT / slug)["icon"])
                    if r.returncode == 0 and agent_find_icon(slug, name, app_url):
                        print(f"  {name}: installed; the agent is finding an icon")
                        notify(f"added {name} — the agent is finding an icon")
                    continue
            if given:
                dest = ICON_DIR / f"{icon_slug}.png"
                if fetch_icon(given.strip(), dest) and normalize_icon(dest):
                    icon_arg = icon_slug
                    r = run_install(icon_arg)
                else:
                    notify(f"could not use that image; falling back")
                    r = run_install(ego_engine(PROFILE_ROOT / slug)["icon"])
            else:
                r = run_install(ego_engine(PROFILE_ROOT / slug)["icon"])
            if r.returncode == 0 and icon_arg != icon_slug:
                print(f"  {name}: installed with a generic icon "
                      f"(none reachable at {host}); set one later with:")
                print(f"      omaego app icon {slug} {name!r} <image-url>")
        if r.returncode != 0:
            msg = (r.stderr.strip() or r.stdout.strip() or "no output")[:140]
            print(f"  {name}: FAILED  {msg}", file=sys.stderr)
            # Launched from the bar panel there is no terminal to read, so a
            # failure that is only printed is a failure nobody sees.
            notify(f"could not add {name}: {msg[:90]}")
            continue
        if not icon_arg:                       # omarchy fetched it; fix it up
            normalize_icon(ICON_DIR / f"{icon_slug}.png")
        apply_badge(icon_slug, ego)
        print(f"  installed  {name}")
        notify(f"added {name} — find it in the launcher")

        if want_rule and domain:
            owner = app_rule_conflict(domain)
            if owner and owner.lower() != ego["name"].lower():
                print(f"      rule skipped: {domain} already routes to {owner!r}")
            elif owner:
                print(f"      rule exists:  {domain} -> {owner}")
            else:
                append_rule(domain, ego["name"])
                print(f"      rule added:   https://*{domain}/* -> {ego['name']}")
        elif want_rule and not domain:
            print("      no rule: several egos can share this host "
                  "(Teams, Outlook, Gmail, Meet), so routing it to one "
                  "would be wrong")
        elif domain:
            print(f"      --rule would add:  https://*{domain}/* -> {ego['name']}")
    return 0


# --- cli --------------------------------------------------------------------

USAGE = """omaego - keep work, private and customer contexts apart in one browser

An *ego* is one Chrome --user-data-dir: its own process, window class, cookie
jar and sync account. A workspace usually belongs to one ego. A link always
opens on the workspace you are on - never by switching desktops.

  omaego <url>           route a URL (this is what the desktop entry calls)
  omaego                 open a browser on this desktop
  omaego list            show egos, and which Chrome-internal profiles are not
                         routable on their own
  omaego add <name> [--browser=chrome|chromium|brave|edge] [--existing]
                         create an empty ego, in omarchy's default browser
                         unless another is named. --existing makes the ego out
                         of the profile that browser already has, in place
  omaego new             same, asking the name (and the browser, if there is a
                         choice) in the menu, then open it to sign in
  omaego import <src> [name]
                         lift a Chrome-internal profile into its own ego
                         (needs Chrome fully quit)
  omaego learn [--agent] suggest rules from where links actually went
  omaego rule list       the routing rules
  omaego rule add <url-glob> <ego> [--app]
  omaego app list        web apps you can pin to an ego
  omaego app add <ego> <app>...   install them (--rule also routes that host)
  omaego app add <ego> --url <url> | --name <name>
                         either one is enough; you are asked for the other
  omaego app remove <ego> <app>...
  omaego app icon <ego> "<app name>" <image url|path|--agent>
  omaego app rebadge [ego]        stamp ego badges on installed app icons
  omaego launch <slug> [url]
  omaego engine          the browser each ego runs in. A new ego gets omarchy's
                         default browser; after `omarchy default browser <x>`,
                         run `omaego setup` to put omaego back in front of it
  omaego engine <ego> <browser> [empty]
                         move an ego to another browser, keeping its profile
                         (or starting empty). The old one is backed up first.
  omaego engine pick <ego>        the same, choosing browser and profile in the menu
  omaego default [slug]  show/set the FALLBACK ego: the one that owns the plain
                         browser entry and web apps. Not an "active" ego -
                         there is no such thing; the workspace is the unit.
  omaego close <ego>     close that ego's windows on this workspace
  omaego space [--json]  which ego owns the current workspace
  omaego here [--json]   browser and web-app windows on the current workspace
  omaego setup           first-run wiring: handler, desktop entries, rules file
  omaego sync            rewrite desktop entries, relink native messaging hosts
  omaego restructure     name each inner profile dir after its ego, so web-app
                         windows identify their ego (rarely needed)

Flags: --incognito / --private / --private-window / --inprivate
Rules: ~/.config/omaego/rules.toml
"""


# Read-only queries the bar widget polls several times a minute. Logging them
# would churn the routing history out of the log's size cap within the hour.
QUIET = {"space", "here", "list", "default", "engine", "panel", "highlight", "--help", "-h"}


def main(argv):
    if not (argv and argv[0] in QUIET):
        log(f"argv={argv}")

    # Callers probe browsers with --help (omarchy-launch-browser greps it to
    # detect Firefox); never treat a flag as a URL.
    if any(a in ("--help", "-h", "-help") for a in argv):
        print(USAGE)
        return 0

    want_json = "--json" in argv
    incognito = any(a in ("--incognito", "--private", "--private-window",
                          "--inprivate") for a in argv)
    browser_arg = next((a.split("=", 1)[1] for a in argv
                        if a.startswith("--browser=")), None)
    existing_arg = "--existing" in argv
    argv = [a for a in argv if not a.startswith("-")]

    if not argv:
        open_url(None, incognito=incognito)
        return 0
    cmd = argv[0]

    if cmd == "list":
        by_class = all_targets()
        if want_json:
            dflt = default_slug()
            print(json.dumps([
                {"slug": t["slug"], "name": t["name"], "class": t["wm_class"],
                 "managed": t["managed"], "default": t["slug"] == dflt,
                 "browser": t["engine"]["short"]}
                for t in sorted(by_class.values(),
                                key=lambda t: (not t["managed"], t["name"]))]))
            return 0
        for t in sorted(by_class.values(), key=lambda t: (not t["managed"], t["name"])):
            kind = "routable" if t["managed"] else "shared data dir"
            print(f"{t['name']:<24} {t['engine']['short']:<9} "
                  f"class={t['wm_class']:<22} {kind}")
            if not t["managed"] and t["data_dir"]:
                inner = internal_profiles(t["data_dir"])
                for sub, nm in inner:
                    print(f"    - {nm:<20} ({sub})  NOT routable on its own")
                if len(inner) > 1:
                    print(f"    ^ these share one data dir, so every window is "
                          f"class {t['wm_class']!r}.")
                    print(f"      Lift one out with:  omaego import "
                          f"{t['slug']} '<name>'")
        return 0

    if cmd == "import":
        by_class = all_targets()
        if len(argv) < 2:
            have = "|".join(c for c in by_class if c in UNMANAGED)
            print(f"usage: omaego import <{have or 'google-chrome|chromium'}> [ego name]",
                  file=sys.stderr)
            return 2
        src = by_class.get(argv[1])
        if src is None or not src["data_dir"]:
            print(f"unknown source {argv[1]!r}", file=sys.stderr)
            return 1
        inner = internal_profiles(src["data_dir"])
        if len(argv) < 3:
            print(f"egos inside {src['data_dir']}:")
            for sub, nm in inner:
                print(f"  {nm}   ({sub})")
            return 0
        want = " ".join(argv[2:])
        match = [(sub, nm) for sub, nm in inner
                 if nm.lower() == want.lower() or sub.lower() == want.lower()]
        if not match:
            print(f"no ego named {want!r}; try: omaego import {argv[1]}",
                  file=sys.stderr)
            return 1
        import_profile(src["data_dir"], match[0][0], match[0][1], src["engine"])
        return 0

    if cmd == "add":
        if len(argv) < 2:
            print("usage: omaego add <name> [--browser=<browser>] [--existing]",
                  file=sys.stderr)
            return 2
        eng = find_engine(browser_arg) if browser_arg else None
        if browser_arg and not (eng and shutil.which(eng["command"])):
            print(f"no such browser installed: {browser_arg!r} (have: "
                  f"{', '.join(e['short'].lower() for e in installed_engines())})",
                  file=sys.stderr)
            return 1
        name = " ".join(argv[1:])
        if slugify(name) in profiles():
            print(f"ego {slugify(name)!r} already exists", file=sys.stderr)
            return 1
        slug = add_profile(name, eng, existing_arg)
        if existing_arg:
            ego = profiles()[slug]
            print(f"{name} is now {ego['engine']['short']}'s own profile "
                  f"({ego['data_dir'].resolve()}), nothing copied.")
            print(f"Restart {ego['engine']['short']} once so its windows carry "
                  f"the ego's class.")
            return 0
        print(f"created ego {slug!r} ({name})\n")
        print("next:")
        print(f"  1. omaego launch {slug}")
        print("     sign in to Google/Microsoft in the window that opens; this ego")
        print("     syncs to that account and nothing else does")
        print(f"  2. omaego app add {slug} teams outlook      # see: omaego app list")
        print(f"  3. omaego rule add 'https://*.example.com/*' {name}")
        print("     for hosts that must always open as this ego, wherever you are")
        return 0

    if cmd == "new":
        # Interactive add, for the bar panel: name it in the menu, then open it so
        # the first thing you do is sign in - an ego is only useful once synced.
        made = new_ego()
        if not made:
            return 0
        slug, existed = made
        ego = profiles()[slug]
        launch(ego, new_window=True)
        notify(f"{ego['name']}: already existed, opened it" if existed
               else f"created {ego['name']} in {ego['engine']['short']}")
        return 0

    if cmd == "launch":
        if len(argv) < 2:
            return 2
        by_class = all_targets()
        t = next((t for t in by_class.values() if t["slug"] == argv[1]), None)
        if t is None:
            print(f"unknown profile {argv[1]!r}", file=sys.stderr)
            return 1
        launch(t, argv[2] if len(argv) > 2 else None, new_window=True)
        return 0

    if cmd == "default":
        if len(argv) < 2:
            print(default_slug() or "(none)")
            return 0
        if argv[1] not in profiles():
            print(f"unknown profile {argv[1]!r}", file=sys.stderr)
            return 1
        DEFAULT_MARK.write_text(argv[1] + "\n")
        write_desktop_entries()
        print(f"default profile -> {argv[1]}")
        return 0

    if cmd == "restructure":
        # Rename each data dir's inner profile from "Default" to the profile's
        # own name, so web-app windows come out as chrome-<app>__-<Name> and can
        # be attributed to a profile (and no longer collide between profiles).
        if chrome_running():
            print("Quit Chrome completely first - renaming a profile directory "
                  "under a running instance corrupts it.", file=sys.stderr)
            return 1
        changed = 0
        for slug, prof in profiles().items():
            if prof["profile_dir"] != "Default":
                print(f"  {slug}: already {prof['profile_dir']}")
                continue
            inner = re.sub(r"[^A-Za-z0-9]", "", prof["name"]) or slug.title()
            src, dst = prof["data_dir"] / "Default", prof["data_dir"] / inner
            if not src.is_dir():
                print(f"  {slug}: no Default dir, skipped", file=sys.stderr)
                continue
            if dst.exists():
                print(f"  {slug}: {inner} already exists, skipped", file=sys.stderr)
                continue
            src.rename(dst)                      # same filesystem: instant
            (prof["data_dir"] / ".profile-dir").write_text(inner + "\n")
            print(f"  {slug}: Default -> {inner}")
            changed += 1
        if changed:
            write_desktop_entries()
        print(f"{changed} profile(s) restructured")
        return 0

    if cmd == "rule":
        sub = argv[1] if len(argv) > 1 else "list"
        if sub == "list":
            rules = load_rules()
            if want_json:
                print(json.dumps([
                    {"pattern": r.get("url") or r.get("match") or "",
                     "profile": r.get("profile"), "app": bool(r.get("app")),
                     "rewrite": bool(r.get("rewrite")), "source": r.get("source")}
                    for r in rules]))
                return 0
            if not rules:
                print(f"no rules in {RULES}")
                return 0
            for r in rules:
                pat = r.get("url") or r.get("match") or "(source only)"
                bits = [f"-> {r['profile']}"] if r.get("profile") else ["-> workspace/picker"]
                if r.get("app"): bits.append("as app window")
                if r.get("rewrite"): bits.append("rewritten")
                if r.get("source"): bits.append(f"from {r['source']}")
                print(f"  {pat:<48} {'  '.join(bits)}")
            return 0
        if sub == "add":
            if len(argv) < 4:
                print("usage: omaego rule add <url-glob> <ego> [--app]", file=sys.stderr)
                return 2
            pat, want = argv[2], argv[3]
            egos = profiles()
            ego = egos.get(want) or next(
                (e for e in egos.values() if e["name"].lower() == want.lower()), None)
            if ego is None:
                print(f"unknown ego {want!r} (see: omaego list)", file=sys.stderr)
                return 1
            for r in load_rules():
                if (r.get("url") or r.get("match")) == pat:
                    print(f"rule for {pat} already exists -> {r.get('profile')}",
                          file=sys.stderr)
                    return 1
            with RULES.open("a") as f:
                f.write(f'\n[[rule]]\nurl = "{pat}"\nprofile = "{ego["name"]}"\n')
                if "--app" in sys.argv[1:]:
                    f.write("app = true\n")
            print(f"added: {pat} -> {ego['name']}")
            return 0
        if sub == "new":
            # Interactive add, for the bar panel. An ego slug skips the picker -
            # the panel asks from inside that ego's column.
            egos = profiles()
            ego = egos.get(argv[2]) if len(argv) > 2 else None
            hint = f" for {ego['name']}" if ego else ""
            pat = prompt_text(f"URL pattern{hint}, e.g. https://acme.example.com/*")
            if not pat:
                return 0
            if ego is None:
                ego = pick([(e["name"], e) for e in egos.values()],
                           f"Open {pat} in…")
            if ego is None:
                return 0
            for r in load_rules():
                if (r.get("url") or r.get("match")) == pat:
                    notify(f"a rule for {pat} already exists")
                    return 1
            with RULES.open("a") as f:
                f.write(f'\n[[rule]]\nurl = "{pat}"\nprofile = "{ego["name"]}"\n')
            notify(f"{pat} -> {ego['name']}")
            return 0

        if sub == "rm":
            if len(argv) < 3:
                print("usage: omaego rule rm <url-glob>", file=sys.stderr)
                return 2
            if remove_rule(argv[2]):
                print(f"removed rule {argv[2]}")
                return 0
            print(f"no rule matching {argv[2]!r}", file=sys.stderr)
            return 1

        print(f"unknown: omaego rule {sub}", file=sys.stderr)
        return 2

    if cmd == "app":
        sub = argv[1] if len(argv) > 1 else "list"
        if sub == "list":
            print("web apps you can pin to an ego "
                  f"(name template {APP_NAME_TEMPLATE!r}):\n")
            for k, (nm, url, dom, _ic) in sorted(WEBAPPS.items()):
                tail = f"  [rule: {dom}]" if dom else ""
                print(f"  {k:<10} {nm:<10} {url}{tail}")
            print("\n  omaego app add <ego> <app>...            install them\n  omaego app add <ego> <app> --rule        also route that host to the ego")
            print("  omaego app add <ego> --url <url> --name <name>")
            print("  omaego app remove <ego> <app>...")
            print('  omaego app icon <ego> "<app name>" <image url|path|--agent>')
            print("  omaego app rebadge [ego]        stamp ego badges on icons")
            print('  omaego app rename <ego> "<old>" "<new>"')
            print("  omaego app fixnames [ego]       append the ego to names missing it")
            print("\n[rule] marks a host one ego can plausibly own outright; "
                  "--rule writes it.\nHosts without it are shared between egos "
                  "(Teams, Outlook, Gmail, Meet) — a rule\nthere would send a "
                  "customer's link to the wrong identity.")
            return 0

        if sub in ("rename", "fixnames"):
            egos = profiles()
            def do_rename(slug, app, new_name):
                old_desktop = DESKTOP_DIR / app["desktop"]
                old_slug = app["icon"] if app["icon"] and "/" not in app["icon"] else None
                new_slug = re.sub(r"[^a-z0-9]+", "-", new_name.lower()).strip("-")
                txt = old_desktop.read_text()
                txt = re.sub(r"^Name=.*$", f"Name={new_name}", txt, flags=re.M)
                if old_slug:
                    for suffix in (".png", ".orig.png"):
                        src = ICON_DIR / f"{old_slug}{suffix}"
                        if src.exists():
                            src.rename(ICON_DIR / f"{new_slug}{suffix}")
                    txt = re.sub(r"^Icon=.*$", f"Icon={new_slug}", txt, flags=re.M)
                (DESKTOP_DIR / f"{new_name}.desktop").write_text(txt)
                if old_desktop.name != f"{new_name}.desktop":
                    old_desktop.unlink(missing_ok=True)
                print(f"  {app['name']}  ->  {new_name}")

            if sub == "rename":
                if len(argv) < 5:
                    print("usage: omaego app rename <ego> \"<old>\" \"<new>\"",
                          file=sys.stderr)
                    return 2
                slug, old, new = argv[2], argv[3], " ".join(argv[4:])
                app = next((a for a in installed_apps().get(slug, [])
                            if a["name"].lower() == old.lower()), None)
                if app is None:
                    print(f"no app {old!r} in {slug}", file=sys.stderr)
                    return 1
                do_rename(slug, app, new)
            else:
                # Every launcher should carry its ego, including the fallback
                # one: "Chrome Remote Desktop" says nothing about whose it is.
                which = argv[2] if len(argv) > 2 else None
                n = 0
                for slug, apps in sorted(installed_apps().items()):
                    if (which and slug != which) or slug not in egos:
                        continue
                    ego_name = egos[slug]["name"]
                    for a in apps:
                        if re.search(rf"\b{re.escape(ego_name)}\b", a["name"], re.I):
                            continue
                        do_rename(slug, a, f"{a['name']} {ego_name}")
                        n += 1
                print(f"{n} renamed")
            subprocess.run(["update-desktop-database", str(DESKTOP_DIR)],
                           capture_output=True)
            subprocess.run(["gtk-update-icon-cache",
                            str(Path.home() / ".local/share/icons/hicolor")],
                           capture_output=True)
            return 0

        if sub == "icon":
            # Set or replace an installed web app's icon, for the common case of
            # a host that serves none and got the generic one.
            if len(argv) < 4:
                print("usage: omaego app icon <ego> <app name> <image url|path>",
                      file=sys.stderr)
                return 2
            slug, want = argv[2], argv[3]
            src = argv[4] if len(argv) > 4 else None
            app = next((a for a in installed_apps().get(slug, [])
                        if a["name"].lower() == want.lower()), None)
            if app is None:
                print(f"no app {want!r} in {slug}; see: omaego app installed",
                      file=sys.stderr)
                return 1
            if src == "--agent" or (not src and not sys.stdin.isatty()):
                if agent_find_icon(slug, app["name"], app["url"]):
                    print(f"  handed {app['name']} to the default agent")
                    return 0
                print("could not launch the agent", file=sys.stderr)
                return 1
            if not src:
                src = prompt_text(f"Image URL for {app['name']} "
                                  f"(or type agent to let the agent find one)")
                if not src:
                    return 0
                if src.strip().lower() == "agent":
                    return 0 if agent_find_icon(slug, app["name"], app["url"]) else 1
            icon_slug = re.sub(r"[^a-z0-9]+", "-", app["name"].lower()).strip("-")
            ICON_DIR.mkdir(parents=True, exist_ok=True)
            dest = ICON_DIR / f"{icon_slug}.png"
            ok = (Path(src).exists() and shutil.copy(src, dest)) or fetch_icon(src, dest)
            if not (ok and normalize_icon(dest)):
                print(f"could not use {src}", file=sys.stderr)
                notify(f"could not use that image for {app['name']}")
                return 1
            (ICON_DIR / f"{icon_slug}.orig.png").unlink(missing_ok=True)
            apply_badge(icon_slug, profiles()[slug])
            d = DESKTOP_DIR / app["desktop"]
            d.write_text(re.sub(r"^Icon=.*$", f"Icon={icon_slug}", d.read_text(),
                                flags=re.M))
            subprocess.run(["gtk-update-icon-cache",
                            str(Path.home() / ".local/share/icons/hicolor")],
                           capture_output=True)
            subprocess.run(["update-desktop-database", str(DESKTOP_DIR)],
                           capture_output=True)
            print(f"  {app['name']}: icon set from {src}")
            notify(f"{app['name']}: icon updated")
            return 0

        if sub == "rebadge":
            which = argv[2] if len(argv) > 2 else None
            egos = profiles()
            n = 0
            for slug, apps in sorted(installed_apps().items()):
                if (which and slug != which) or slug not in egos:
                    continue
                for a in apps:
                    icon = a["icon"]
                    if not icon or "/" in icon:
                        continue
                    if apply_badge(icon, egos[slug]):
                        print(f"  {a['name']}"); n += 1
            subprocess.run(["gtk-update-icon-cache",
                            str(Path.home() / ".local/share/icons/hicolor")],
                           capture_output=True)
            print(f"{n} icon(s) badged")
            return 0

        if sub == "installed":
            inst = installed_apps()
            if want_json:
                print(json.dumps(inst))
            else:
                for slug, apps in sorted(inst.items()):
                    print(f"{slug}:")
                    for a in apps:
                        print(f"    {a['name']:<28} {a['url']}")
            return 0

        if sub == "catalog":
            print(json.dumps([
                {"key": k, "name": v[0], "url": v[1], "ruleDomain": v[2]}
                for k, v in sorted(WEBAPPS.items())]))
            return 0

        if sub == "pick":
            # Free text FIRST, then the catalogue.
            #
            # walker's dmenu filters its rows against what is typed and has no
            # flag to hand back unmatched input, so a pasted URL hides every row
            # and Enter returns nothing. Asking first is the only way a URL can
            # be entered at all; Enter on an empty prompt falls through to the
            # catalogue, so browsing still works.
            if len(argv) < 3:
                print("usage: omaego app pick <ego>", file=sys.stderr)
                return 2
            slug = argv[2]
            if slug not in profiles():
                print(f"unknown ego {slug!r}", file=sys.stderr)
                return 1
            name = profiles()[slug]["name"]
            typed = (prompt_text(f"{name}: paste a URL then Enter · a name then "
                                 f"Enter · or Enter alone to browse") or "").strip()

            if typed:
                hit = next((k for k, v in WEBAPPS.items()
                            if v[0].lower() == typed.lower()
                            or k.lower() == typed.lower()), None)
                if hit:
                    return app_add(slug, [hit], interactive=True)
                looks_like_url = "://" in typed or ("." in typed and " " not in typed)
                return app_add(slug, [],
                               url=typed if looks_like_url else None,
                               display=None if looks_like_url else typed,
                               interactive=True)

            have = {a["url"] for a in installed_apps().get(slug, [])}
            opts = [(v[0], k) for k, v in sorted(WEBAPPS.items()) if v[1] not in have]
            if not opts:
                notify(f"every catalogue app is already installed for {name}")
                return 0
            key = pick(opts, f"Add a web app to {name}…")
            return 0 if key is None else app_add(slug, [key], interactive=True)

        if sub in ("add", "remove"):
            if len(argv) < 3:
                print(f"usage: omaego app {sub} <ego> <app>...", file=sys.stderr)
                return 2
            slug, keys = argv[2], argv[3:]
            raw = sys.argv[1:]
            # A flag's VALUE does not start with "-", so it survives the flag
            # strip above and would otherwise be read as a catalogue key.
            for flag in ("--url", "--name", "--name-template"):
                for i, a in enumerate(raw):
                    if a == flag and i + 1 < len(raw):
                        keys = [k for k in keys if k != raw[i + 1]]
                    elif a.startswith(flag + "="):
                        keys = [k for k in keys if k != a.split("=", 1)[1]]
            def flagval(name):
                for i, a in enumerate(raw):
                    if a == name and i + 1 < len(raw):
                        return raw[i + 1]
                    if a.startswith(name + "="):
                        return a.split("=", 1)[1]
                return None
            if sub == "add":
                return app_add(slug, keys, name_tpl=flagval("--name-template"),
                               url=flagval("--url"), display=flagval("--name"),
                               want_rule="--rule" in raw)
            egos = profiles()
            if slug not in egos:
                print(f"unknown ego {slug!r}", file=sys.stderr); return 1
            tpl = flagval("--name-template") or APP_NAME_TEMPLATE
            for k in keys:
                if k not in WEBAPPS:
                    print(f"unknown app {k!r}", file=sys.stderr); continue
                name = tpl.format(app=WEBAPPS[k][0], ego=egos[slug]["name"])
                r = subprocess.run(["omarchy", "webapp", "remove", name],
                                   capture_output=True, text=True)
                print(f"  {'removed  ' if r.returncode == 0 else 'not found'}  {name}")
            return 0

        print(f"unknown: omaego app {sub}", file=sys.stderr)
        return 2

    if cmd == "setup":
        # What install.sh does, minus the symlinks: for a packaged install the
        # binaries are already on PATH and only the per-user wiring is missing.
        apps = DESKTOP_DIR
        apps.mkdir(parents=True, exist_ok=True)
        RULES.parent.mkdir(parents=True, exist_ok=True)
        if not RULES.exists():
            seed = Path("/usr/share/omaego/rules.toml")
            RULES.write_text(seed.read_text() if seed.exists() else
                             "# omaego rules. See the README.\n")
            print(f"  seeded {RULES}")
        # Read the engine before taking over as default browser: afterwards
        # xdg-settings only ever answers "omaego".
        was = xdg_default_browser()
        eng = engine()
        if was not in ENGINES and was != "omaego.desktop":
            print(f"  {was or 'the default browser'} cannot hold egos "
                  f"(Chromium family only)")
        print(f"  engine: {eng['name']} ({eng['source']})")
        menu = picker()
        if menu:
            print(f"  menu:   {'Omarchy' if menu == 'omarchy' else 'walker'}")
        else:
            print("  menu:   MISSING. The ego picker, \"New ego\" and every prompt "
                  "need Omarchy's")
            print("          own menu (omarchy-menu-select, Omarchy 4) or walker")
        os.environ.setdefault("OMAEGO_BIN", shutil.which("omaego") or "omaego")
        write_desktop_entries()
        print(f"  wrote desktop entries in {apps}")
        subprocess.run(["update-desktop-database", str(apps)], capture_output=True)
        subprocess.run(["xdg-settings", "set", "default-web-browser",
                        "omaego.desktop"], capture_output=True)
        subprocess.run(["xdg-mime", "default", "omaego.desktop",
                        "x-scheme-handler/http", "x-scheme-handler/https",
                        "text/html"], capture_output=True)
        print("  registered as default browser")
        if not profiles() and eng["id"] in {e["id"] for e in adoptable()}:
            print(f"\nNext: omaego add \"Personal\" --existing   "
                  f"(your {eng['short']} profile, as it is, becomes the first ego)")
            print("      omaego add \"Work\"   then   omaego app add work teams")
        else:
            print("\nNext: omaego add \"Work\"   then   omaego app add work teams")
        return 0

    if cmd == "engine":
        eng = engine()
        egos = profiles()
        if argv[1:2] == ["command"]:
            # For omaego-webapp: the browser of one ego, or the default.
            own = egos[argv[2]]["engine"] if argv[2:3] and argv[2] in egos else eng
            print(own["command"])
            return 0
        if argv[1:2] == ["pick"] and len(argv) > 2:
            return pick_engine(argv[2])
        if len(argv) > 2:
            to = find_engine(argv[2])
            if argv[1] not in egos:
                print(f"unknown ego {argv[1]!r}", file=sys.stderr)
                return 1
            if not (to and shutil.which(to["command"])):
                print(f"no such browser installed: {argv[2]!r} (have: "
                      f"{', '.join(e['short'].lower() for e in installed_engines())})",
                      file=sys.stderr)
                return 1
            was = egos[argv[1]]["engine"]
            empty = argv[3:4] == ["empty"]
            backup = set_engine(argv[1], to, "empty" if empty else "keep")
            print(f"{egos[argv[1]]['name']}: {was['short']} -> {to['short']}"
                  + (", empty profile" if empty else ""))
            if backup:
                print(f"  previous profile kept in {backup}")
            if was["id"] != to["id"] and not empty:
                print("  bookmarks, history, extensions and settings came along;")
                print("  cookies and saved passwords did not - sign in again")
            return 0
        print(f"default: {eng['name']}  ({eng['command']})  - {eng['source']}")
        for t in sorted(egos.values(), key=lambda t: t["name"]):
            missing = "" if shutil.which(t["engine"]["command"]) else "  NOT INSTALLED"
            print(f"  {t['name']:<22} {t['engine']['name']}{missing}")
        return 0 if shutil.which(eng["command"]) else 1

    if cmd == "sync":
        write_desktop_entries()
        print("desktop entries written")
        return 0

    if cmd == "here":
        rows = browsers_here()
        if want_json:
            print(json.dumps([{"address": a, "class": c, "focused": f,
                               "webapp": a is None} for a, c, f in rows]))
            return 0
        for a, cls, foc in rows:
            kind = "webapp" if a is None else "browser"
            print(f"{a or '-':<18} {kind:<8} {cls}{' (focused)' if foc else ''}")
        return 0

    if cmd == "close":
        if len(argv) < 2:
            print("usage: omaego close <ego>", file=sys.stderr)
            return 2
        n = close_ego(argv[1])
        print(f"closed {n} window(s) of {argv[1]} on this workspace")
        return 0

    if cmd == "learn":
        if not ROUTES.exists():
            print(f"nothing logged yet ({ROUTES})")
            return 0
        seen = {}
        for line in ROUTES.read_text().splitlines():
            try:
                r = json.loads(line)
            except ValueError:
                continue
            host, first = r.get("host", ""), (r.get("path") or "").split("/")[0]
            if not host:
                continue
            for key in {host, f"{host}/{first}" if first else host}:
                seen.setdefault(key, {}).setdefault(r["ego"], 0)
                seen[key][r["ego"]] += 1

        suggestions = []
        for key, egos in seen.items():
            total = sum(egos.values())
            ego, hits = max(egos.items(), key=lambda kv: kv[1])
            if total < 3 or hits / total < 0.8:
                continue                      # too few, or genuinely mixed
            pat = f"https://{key}/*" if "/" in key else f"https://{key}/*"
            host_only = "/" not in key
            # A host-wide suggestion is wrong when a rule already pins part of
            # that host: bitbucket.org/<customer>/* exists, so bitbucket.org/*
            # would quietly swallow every other customer on the same host.
            if host_only and any(key in (r.get("url") or r.get("match") or "")
                                 for r in load_rules()):
                continue
            if match_rule(pat.replace("*", ""), None):
                continue                      # a rule already covers it
            # Prefer the longer, more specific key when both qualify for one ego
            suggestions.append((hits, total, pat, ego))
        suggestions.sort(reverse=True)
        kept, hosts = [], set()
        for hits, total, pat, ego in suggestions:
            root_host = pat.split("/")[2]
            if "/" not in pat[8:].rstrip("*").rstrip("/") and root_host in hosts:
                continue
            hosts.add(root_host)
            kept.append((hits, total, pat, ego))

        if "--agent" in sys.argv[1:]:
            lines = [f"{p} -> {e} ({h}/{t} opens)" for h, t, p, e in kept[:40]]
            current = "\n".join(f"{r.get('url') or r.get('match')} -> {r.get('profile')}"
                                for r in load_rules())
            prompt = (
                "I route links between Chrome profiles (egos) with omaego. "
                "Below is where links actually went, learned from use, and the "
                "rules I already have. Suggest `omaego rule add '<glob>' <Ego>` "
                "lines worth adding, skip anything already covered, and say "
                "which look ambiguous.\n\nObserved:\n" + "\n".join(lines) +
                "\n\nExisting rules:\n" + (current or "(none)"))
            subprocess.Popen(["omarchy", "agent", "prompt", prompt],
                             start_new_session=True)
            print(f"handed {len(kept)} observations to the default agent")
            return 0

        if not kept:
            print("no confident suggestions yet - keep using it")
            return 0
        print("Routes worth adding (a host that consistently went to one ego):\n")
        for hits, total, pat, ego in kept:
            print(f"  omaego rule add '{pat}' {ego}".ljust(62) + f"# {hits}/{total}")
        return 0

    if cmd == "highlight":
        highlight("all" if len(argv) > 1 and argv[1] == "all" else None)
        return 0

    if cmd == "panel":
        # Everything the bar panel renders, in one call - four separate
        # processes per open would be four Chrome-free but still pointless forks.
        by_class = all_targets()
        rows = browsers_here()
        here = {c for _, c, _ in rows}
        # Which ego owns the focused window, so the bar can mark it.
        focused_cls = next((c for a, c, f in rows if f), None)
        inst = installed_apps()
        dflt = default_slug()
        rules = [{"pattern": r.get("url") or r.get("match") or "",
                  "profile": r.get("profile"), "app": bool(r.get("app"))}
                 for r in load_rules()]
        egos = sorted(profiles().values(), key=lambda t: t["name"])
        names = {t["name"].lower() for t in egos} | {t["slug"] for t in egos}

        def panel_app(a, ego_name):
            # "Outlook Work" is the launcher's name; inside the Work column the
            # ego is already said, so show "Outlook".
            short = re.sub(rf"\s*\b{re.escape(ego_name)}\b\s*", " ",
                           a["name"], flags=re.I).strip() or a["name"]
            return {**a, "short": short, "iconPath": icon_path(a["icon"])}

        def owns(t, r):
            p = (r["profile"] or "").lower()
            return p in (t["name"].lower(), t["slug"])

        print(json.dumps({
            "workspace": current_workspace(),
            "fallback": (profiles().get(dflt or "") or {}).get("name"),
            "egos": [{"slug": t["slug"], "name": t["name"], "class": t["wm_class"],
                      "color": "#" + ego_color(t["slug"]),
                      "default": t["slug"] == dflt,
                      "browser": t["engine"]["short"],
                      "here": t["wm_class"] in here,
                      "focused": t["wm_class"] == focused_cls,
                      "apps": [panel_app(a, t["name"]) for a in inst.get(t["slug"], [])],
                      "rules": [r for r in rules if owns(t, r)]}
                     for t in egos],
            # Rules with no ego (rewrite/app-only) or naming one that is gone.
            "looseRules": [r for r in rules
                           if (r["profile"] or "").lower() not in names],
            "rules": rules,
        }))
        return 0

    if cmd == "space":
        # A space usually belongs to ONE ego. Report which, from what is on it.
        # There is no global "active ego" - the workspace is the unit.
        by_class = all_targets()
        rows = browsers_here()
        egos, has_browser = [], set()
        for a, cls, _ in rows:
            t = by_class.get(cls)
            name = t["name"] if t else cls
            if name not in egos:
                egos.append(name)
            if a is not None:
                has_browser.add(name)
        state = ("empty" if not egos else
                 "single" if len(egos) == 1 else "mixed")
        out = {"workspace": current_workspace(), "state": state, "egos": egos,
               "withBrowser": sorted(has_browser),
               "fallback": (profiles().get(default_slug() or "") or {}).get("name")}
        if want_json:
            print(json.dumps(out))
        elif state == "empty":
            print(f"workspace {out['workspace']}: no ego here "
                  f"(a link would ask; fallback is {out['fallback']})")
        else:
            print(f"workspace {out['workspace']}: {', '.join(egos)}"
                  + ("" if has_browser else "  (web app only - a link opens a new window)"))
        return 0

    open_url(cmd, incognito=incognito)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
