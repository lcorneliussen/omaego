# Maintainer: Lars Corneliussen <lcorneliussen@users.noreply.github.com>
pkgname=omaego
pkgver=0.2.0
pkgrel=1
pkgdesc="Keep work, private and customer contexts apart in one browser: per-ego Chrome profiles with workspace-aware link routing"
arch=('any')
url="https://github.com/lcorneliussen/omaego"
license=('MIT')
depends=('python' 'hyprland' 'xdg-utils')
optdepends=(
  'google-chrome: an engine whose egos each sync to their own account (Arch chromium has no Google sync)'
  'walker: the ego picker and prompts on Omarchy 3 (Omarchy 4 has its own menu, which is used instead)'
  'imagemagick: normalises web app icons'
  'curl: resolves shortened links before routing'
)
install=omaego.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('66869d6962050fec19c57d0aab4f2117ca1ab27837f79f542992c0f88a5e1eef')

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 bin/omaego        "$pkgdir/usr/bin/omaego"
  install -Dm755 bin/omaego-webapp "$pkgdir/usr/bin/omaego-webapp"
  install -Dm755 bin/omaego-remote "$pkgdir/usr/bin/omaego-remote"
  install -Dm644 examples/rules.toml "$pkgdir/usr/share/omaego/rules.toml"
  install -Dm644 README.md         "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/gotchas.md   "$pkgdir/usr/share/doc/$pkgname/gotchas.md"
  install -Dm644 LICENSE           "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
