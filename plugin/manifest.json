{
  "schemaVersion": 1,
  "id": "io.github.lcorneliussen.omaego",
  "name": "omaego",
  "version": "0.2.0",
  "author": "Lars Corneliussen",
  "license": "MIT",
  "description": "Shows which ego (browser identity) owns the current workspace, with a panel to launch egos and their web apps, install new ones, and manage routing rules.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "omaego",
    "description": "Ego of the current workspace",
    "category": "Info",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "pollSeconds": 3,
      "command": "omaego",
      "hideWhenEmpty": false
    },
    "schema": [
      {
        "key": "hideWhenEmpty",
        "type": "boolean",
        "label": "Hide the widget on workspaces with no ego"
      },
      {
        "key": "pollSeconds",
        "type": "integer",
        "label": "Seconds between refreshes (workspace changes refresh instantly)"
      },
      {
        "key": "command",
        "type": "string",
        "label": "Path to the omaego binary"
      }
    ]
  }
}
