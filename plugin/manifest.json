{
  "schemaVersion": 1,
  "id": "io.github.lcorneliussen.omaego",
  "name": "omaego",
  "version": "0.1.0",
  "author": "Lars Corneliussen",
  "license": "MIT",
  "description": "Shows which ego (browser identity) owns the current workspace, and warns when a workspace has gone mixed.",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "BarWidget.qml" },
  "barWidget": {
    "displayName": "omaego",
    "description": "Ego of the current workspace",
    "category": "Info",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showWhenEmpty": false,
      "pollSeconds": 3,
      "command": "omaego"
    },
    "schema": [
      { "key": "showWhenEmpty", "type": "boolean",
        "label": "Keep the widget visible on workspaces with no ego" },
      { "key": "pollSeconds", "type": "integer",
        "label": "Seconds between refreshes (workspace changes refresh instantly)" },
      { "key": "command", "type": "string",
        "label": "Path to the omaego binary" }
    ]
  }
}
